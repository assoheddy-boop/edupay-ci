generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ORGANIZATION_ADMIN
  SCHOOL_ADMIN
  PARENT
  TEACHER
}

enum PaymentStatus {
  PENDING
  VALIDATED
  REJECTED
}

enum AbsenceType {
  ABSENCE
  LATE
}

enum NotificationType {
  ABSENCE
  LATE
  PAYMENT
  HOMEWORK
  HEALTH
  BEHAVIOR
  TRANSPORT
  GENERAL
  TRANSFER
}

enum BehaviorType {
  POSITIVE
  NEGATIVE
}

enum TransportEvent {
  BOARDED_BUS
  ARRIVED_SCHOOL
  LEFT_SCHOOL
  PICKED_UP
}

enum FinanceAccountType {
  WAVE
  ORANGE_MONEY
  CASH
  BANK
}

enum FinanceTransactionType {
  INCOME
  EXPENSE
}

enum ContractType {
  CDI
  CDD
  VACATAIRE
  STAGE
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  MATERNITY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  VALIDATED
  PAID
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
}

enum AdvanceStatus {
  PENDING
  APPROVED
  REJECTED
  DEDUCTED
}

enum ScholarshipStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum ConsentType {
  DATA_PROCESSING
  PHOTOS
  HEALTH
  MARKETING
}

enum ConsentStatus {
  PENDING
  GRANTED
  REVOKED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      UserRole
  firstName String
  lastName  String
  phone     String?
  photoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School?
  teacher      Teacher?
  parentProfile ParentProfile?
  organizationAdmin OrganizationAdmin?
  sentMessages Message[]      @relation("SentMessages")
  receivedMessages Message[]  @relation("ReceivedMessages")
  notifications Notification[]
  requestedTransfers TransferRequest[]
  auditTrails        AuditTrail[]
  consents           Consent[]
  refreshTokens      RefreshToken[]
}

model School {
  id                String   @id @default(cuid())
  name              String
  slug              String?  @unique
  address           String?
  city              String   @default("Abidjan")
  campusLabel       String?
  waveNumber        String?
  omNumber          String?
  logoUrl           String?
  logoBase64        String?  @db.Text
  subscription      String   @default("premium")
  currentSchoolYear String   @default("2025-2026")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  adminId String @unique
  admin   User   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  classes              Class[]
  teachers             Teacher[]
  feeTypes             FeeType[]
  lostItems            LostItem[]
  extracurriculars     Extracurricular[]
  canteenMenus         CanteenMenu[]
  pickupAuthorizations PickupAuthorization[]
  modules              SchoolModule[]
  financeAccounts      FinanceAccount[]
  expenseCategories    ExpenseCategory[]
  financeTransactions  FinanceTransaction[]
  students             Student[]
  auditLogs            AuditLog[]
  staffProfiles        StaffProfile[]
  staffDocuments       StaffDocument[]
  leaveRequests        LeaveRequest[]
  staffAttendances     StaffAttendance[]
  payrollRuns          PayrollRun[]
  payslips             Payslip[]
  salaryAdvances       SalaryAdvance[]
  staffEvaluations     StaffEvaluation[]
  transfersFrom        TransferRequest[] @relation("TransferFromSchool")
  transfersTo          TransferRequest[] @relation("TransferToSchool")
  accountingEntries    AccountingEntry[]
  studentYearRecords   StudentYearRecord[]

  planId Int?
  plan   SubscriptionPlan? @relation(fields: [planId], references: [id])

  @@index([groupId])
}

model SubscriptionPlan {
  id       Int      @id @default(autoincrement())
  name     String
  price    Int
  features String[]
  schools  School[]
}

model Class {
  id         String   @id @default(cuid())
  name       String
  level      String
  schoolYear String   @default("2025-2026")
  createdAt  DateTime @default(now())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  students  Student[]
  teachers  TeacherClass[]
  homeworks Homework[]
  schedules Schedule[]
  incomingTransfers TransferRequest[]
  yearRecords StudentYearRecord[]
}

model Student {
  id         String    @id @default(cuid())
  firstName  String
  lastName   String
  matricule  String?
  birthDate  DateTime?
  gender     String?
  photoUrl   String?
  createdAt  DateTime  @default(now())

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId  String
  class    Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  parents              ParentStudent[]
  payments             Payment[]
  paymentProofs        PaymentProof[]
  absences             Absence[]
  grades               Grade[]
  bulletins            Bulletin[]
  messages             Message[]
  homeworks            HomeworkSubmission[]
  healthIncidents      HealthIncident[]
  behaviorNotes        BehaviorNote[]
  badges               Badge[]
  transportLogs        TransportLog[]
  canteenRecords       CanteenRecord[]
  extracurricularEnrolls ExtracurricularEnrollment[]
  pickupAuthorizations PickupAuthorization[]
  lostItems            LostItem[]
  transferRequests     TransferRequest[]
  scholarships         Scholarship[]
  yearRecords          StudentYearRecord[]

  @@unique([schoolId, matricule])
}

model StudentYearRecord {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolYear String
  classId    String
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  schoolId   String?
  school     School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  repeatYear Boolean  @default(false)
  status     String
  createdAt  DateTime @default(now())
  gender     String?

  @@index([schoolYear, studentId])
  @@unique([studentId, schoolYear])
}

model ParentProfile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  children ParentStudent[]
}

model ParentStudent {
  id        String   @id @default(cuid())
  relation  String   @default("parent")
  createdAt DateTime @default(now())

  parentId  String
  parent    ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId String
  student   Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

model Teacher {
  id        String   @id @default(cuid())
  subject   String?
  createdAt DateTime @default(now())

  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  classes       TeacherClass[]
  grades        Grade[]
  absences      Absence[]
  homeworks     Homework[]
  behaviorNotes BehaviorNote[]
  badges        Badge[]
  schedules     Schedule[]
  staffProfile  StaffProfile?
  leaveRequests LeaveRequest[]
  attendances   StaffAttendance[]
  payslips      Payslip[]
  salaryAdvances SalaryAdvance[]
  evaluations   StaffEvaluation[]
  staffDocuments StaffDocument[]
  teacherProfile TeacherProfile?
  leaves         Leave[]
  payrolls       Payroll[]
  hrEvaluations  Evaluation[]
}

model TeacherClass {
  id String @id @default(cuid())

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classId])
}

model FeeType {
  id          String  @id @default(cuid())
  name        String
  amount      Int
  description String?
  dueDay      Int?
  isActive    Boolean @default(true)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  payments Payment[]
}

model Payment {
  id          String        @id @default(cuid())
  amount      Int
  status      PaymentStatus @default(PENDING)
  proofUrl    String?
  reference   String?
  note        String?
  validatedAt DateTime?
  createdAt   DateTime      @default(now())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeTypeId String?
  feeType   FeeType? @relation(fields: [feeTypeId], references: [id])
  receiptUrl String?
  proofs     PaymentProof[]
}

model PaymentProof {
  id           String   @id @default(cuid())
  hash         String   @unique
  fileUrl      String
  mimeType     String
  size         Int
  originalName String?
  createdAt    DateTime @default(now())

  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
}

model Absence {
  id        String      @id @default(cuid())
  date      DateTime    @db.Date
  type      AbsenceType @default(ABSENCE)
  reason    String?
  createdAt DateTime    @default(now())

  studentId  String
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy String?
  teacher    Teacher? @relation(fields: [recordedBy], references: [id])
}

model Grade {
  id        String   @id @default(cuid())
  subject   String
  value     Float
  maxValue  Float    @default(20)
  period    String
  comment   String?
  createdAt DateTime @default(now())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])
}

model Bulletin {
  id          String   @id @default(cuid())
  period      String
  pdfUrl      String?
  average     Float?
  rank        Int?
  generatedAt DateTime @default(now())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Message {
  id        String   @id @default(cuid())
  content   String?
  audioUrl  String?
  fileUrl   String?
  fileName  String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  senderId   String
  sender     User    @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User    @relation("ReceivedMessages", fields: [receiverId], references: [id])
  studentId  String?
  student    Student? @relation(fields: [studentId], references: [id])
}

model Homework {
  id            String   @id @default(cuid())
  title         String
  description   String?
  dueDate       DateTime
  attachmentUrl String?
  createdAt     DateTime @default(now())

  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  submissions HomeworkSubmission[]
}

model HomeworkSubmission {
  id        String   @id @default(cuid())
  done      Boolean  @default(false)
  note      String?
  updatedAt DateTime @updatedAt

  homeworkId String
  homework   Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, studentId])
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model HealthIncident {
  id          String   @id @default(cuid())
  type        String
  description String
  createdAt   DateTime @default(now())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model BehaviorNote {
  id        String       @id @default(cuid())
  type      BehaviorType
  message   String
  createdAt DateTime     @default(now())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])
}

model Badge {
  id        String   @id @default(cuid())
  type      String
  label     String
  awardedAt DateTime @default(now())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])
}

model TransportLog {
  id        String         @id @default(cuid())
  event     TransportEvent
  note      String?
  createdAt DateTime       @default(now())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model CanteenMenu {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  menu      String
  createdAt DateTime @default(now())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  records CanteenRecord[]
}

model CanteenRecord {
  id     String  @id @default(cuid())
  ate    Boolean @default(true)
  note   String?

  studentId String
  student   Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  menuId    String
  menu      CanteenMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@unique([studentId, menuId])
}

model Extracurricular {
  id          String  @id @default(cuid())
  name        String
  description String?
  schedule    String?
  isActive    Boolean @default(true)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  enrollments ExtracurricularEnrollment[]
}

model ExtracurricularEnrollment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  studentId  String
  student    Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  activityId String
  activity   Extracurricular @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([studentId, activityId])
}

model LostItem {
  id          String   @id @default(cuid())
  description String
  photoUrl    String?
  foundAt     DateTime @default(now())
  claimed     Boolean  @default(false)

  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId String?
  student   Student? @relation(fields: [studentId], references: [id])
}

model PickupAuthorization {
  id                  String   @id @default(cuid())
  authorizedPerson    String
  authorizedPhone     String?
  qrCode              String   @unique
  qrDataUrl           String?
  validUntil          DateTime
  usedAt              DateTime?
  createdAt           DateTime @default(now())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String?
  entityId  String?
  userId    String?
  userEmail String?
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  details   String?
  ip        String?
  createdAt DateTime @default(now())
}

model AuditTrail {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  timestamp DateTime @default(now())

  @@index([userId, timestamp])
  @@index([action, timestamp])
}

model Schedule {
  id        String @id @default(cuid())
  dayOfWeek Int
  startTime String
  endTime   String
  subject   String
  room      String?

  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model Group {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schools      School[]
  organization Organization?
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  city      String?
  address   String?
  phone     String?
  logoUrl   String?
  logoBase64 String?  @db.Text
  createdAt DateTime @default(now())

  groupId String? @unique
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  schools   School[]
  admins    OrganizationAdmin[]
  circulars OrganizationCircular[]
}

model OrganizationAdmin {
  id             String @id @default(cuid())
  userId         String @unique
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OrganizationCircular {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  createdAt DateTime @default(now())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model SchoolModule {
  id        String  @id @default(cuid())
  moduleKey String
  enabled   Boolean @default(true)
  locked    Boolean @default(false)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, moduleKey])
}

model FinanceAccount {
  id      String             @id @default(cuid())
  name    String
  type    FinanceAccountType
  balance Int                @default(0)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  transactions FinanceTransaction[]
}

model ExpenseCategory {
  id   String @id @default(cuid())
  name String

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  transactions FinanceTransaction[]
}

model FinanceTransaction {
  id          String                 @id @default(cuid())
  type        FinanceTransactionType
  amount      Int
  description String
  reference   String?
  createdAt   DateTime               @default(now())

  schoolId    String
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  accountId   String
  account     FinanceAccount @relation(fields: [accountId], references: [id])
  categoryId  String?
  category    ExpenseCategory? @relation(fields: [categoryId], references: [id])
  paymentId   String?
  payrollRunId String?
}

model StaffProfile {
  id              String        @id @default(cuid())
  contractType    ContractType  @default(CDD)
  status          StaffStatus   @default(ACTIVE)
  baseSalary      Int           @default(0)
  hourlyRate      Int?
  hireDate        DateTime?
  endDate         DateTime?
  nationalId      String?
  bankName        String?
  bankAccount     String?
  emergencyName   String?
  emergencyPhone  String?
  address         String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  teacherId String @unique
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model StaffDocument {
  id        String   @id @default(cuid())
  label     String
  fileUrl   String?
  fileData  String?  @db.Text
  mimeType  String?
  createdAt DateTime @default(now())

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model LeaveRequest {
  id         String      @id @default(cuid())
  type       LeaveType   @default(ANNUAL)
  status     LeaveStatus @default(PENDING)
  startDate  DateTime    @db.Date
  endDate    DateTime    @db.Date
  reason     String?
  adminNote  String?
  reviewedAt DateTime?
  createdAt  DateTime    @default(now())

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model StaffAttendance {
  id        String           @id @default(cuid())
  date      DateTime         @db.Date
  checkIn   DateTime?
  checkOut  DateTime?
  status    AttendanceStatus @default(PRESENT)
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([teacherId, date])
}

model PayrollRun {
  id        String        @id @default(cuid())
  month     Int
  year      Int
  status    PayrollStatus @default(DRAFT)
  totalNet  Int           @default(0)
  paidAt    DateTime?
  createdAt DateTime      @default(now())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payslips Payslip[]

  @@unique([schoolId, month, year])
}

model Payslip {
  id          String   @id @default(cuid())
  baseSalary  Int      @default(0)
  bonuses     Int      @default(0)
  deductions  Int      @default(0)
  advances    Int      @default(0)
  hoursWorked Float?
  netPay      Int      @default(0)
  pdfUrl      String?
  createdAt   DateTime @default(now())

  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  teacherId    String
  teacher      Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schoolId     String
  school       School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([payrollRunId, teacherId])
}

model SalaryAdvance {
  id        String        @id @default(cuid())
  amount    Int
  status    AdvanceStatus @default(PENDING)
  reason    String?
  adminNote String?
  deductedAt DateTime?
  createdAt DateTime      @default(now())

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
}

model StaffEvaluation {
  id           String   @id @default(cuid())
  period       String
  punctuality  Int?
  pedagogy     Int?
  discipline   Int?
  teamwork     Int?
  comment      String?
  createdAt    DateTime @default(now())

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([teacherId, period])
}

model TeacherProfile {
  id        String    @id @default(cuid())
  name      String
  subject   String?
  hireDate  DateTime?

  teacherId String   @unique
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model Leave {
  id        String   @id @default(cuid())
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  startDate DateTime
  endDate   DateTime
  status    String   @default("PENDING")
}

model Payroll {
  id        String  @id @default(cuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  month     String
  amount    Int
  pdfPath   String?
}

model Evaluation {
  id        String  @id @default(cuid())
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  score     Int
  comments  String?
}

model TransferRequest {
  id        String         @id @default(cuid())
  status    TransferStatus @default(PENDING)
  reason    String?
  note      String?
  gender    String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  reviewedAt  DateTime?
  completedAt DateTime?

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  fromSchoolId String
  fromSchool   School @relation("TransferFromSchool", fields: [fromSchoolId], references: [id], onDelete: Cascade)

  toSchoolId String
  toSchool   School @relation("TransferToSchool", fields: [toSchoolId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  targetClassId String?
  targetClass   Class? @relation(fields: [targetClassId], references: [id], onDelete: SetNull)

  @@index([studentId, status])
  @@index([toSchoolId, status])
  @@index([fromSchoolId, status])
}

model AccountingEntry {
  id          String                   @id @default(cuid())
  type        FinanceTransactionType
  amount      Int
  description String
  date        DateTime                 @default(now())
  createdAt   DateTime                 @default(now())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, date])
  @@index([schoolId, type])
}

model Scholarship {
  id        String            @id @default(cuid())
  type      String
  amount    Int
  status    ScholarshipStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
}

model Consent {
  id        String         @id @default(cuid())
  parentId  String
  parent    User           @relation(fields: [parentId], references: [id], onDelete: Cascade)
  type      ConsentType
  status    ConsentStatus  @default(PENDING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([parentId, type])
  @@index([parentId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

