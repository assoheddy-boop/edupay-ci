generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ORGANIZATION_ADMIN
  SCHOOL_ADMIN
  PARENT
  TEACHER
  STUDENT
}

/// Rôle métier staff école (couche RBAC, distinct du rôle de connexion UserRole).
enum SchoolStaffRole {
  DIRECTOR
  SECRETARIAT
  ACCOUNTANT
  EDUCATOR
  LIFE_SCHOOL
  HR_MANAGER
}

enum PaymentStatus {
  PENDING
  VALIDATED
  REJECTED
}

enum AbsenceType {
  ABSENCE
  LATE
}

enum HomeworkKind {
  HOMEWORK
  TEST
}

/// Type de note bulletin (collège CI). Anciennes lignes sans type = DEVOIR.
enum GradeKind {
  INTERRO
  DEVOIR
  COMPOSITION
}

/// Type d’examen (convocations / émargement). Distinct de GradeKind.
enum ExamType {
  BLANC
  NATIONAL
}

/// Série lycée (A / C / D). Null = collège, pas de filtre.
enum SchoolSeries {
  A
  C
  D
  AUTRE
}

/// Cycle d’enseignement. MIXTE = primaire + secondaire, menus séparés.
enum EducationCycle {
  PRIMAIRE
  COLLEGE
  LYCEE
  MIXTE
}

/// Type d’établissement (filtre annuaire /ecoles). Défaut privé (EPV, IGEST).
enum PublicSchoolType {
  PRIVE
  PUBLIC
  CONFESSIONNEL
}

/// Offre Marketplace (visibilité). Indépendante du plan Pro (gestion interne).
enum MarketplaceTier {
  NONE
  STANDARD
  PREMIUM
  VIP
}

/// Actualité publique du portail /e/:slug. Jamais de données élèves.
enum PortalPostKind {
  NEWS
  EVENT
}

/// Avis parent sur vitrine /e/:slug — modération admin avant affichage.
enum SchoolReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  ABSENCE
  LATE
  PAYMENT
  HOMEWORK
  HEALTH
  BEHAVIOR
  TRANSPORT
  GENERAL
  TRANSFER
}

enum BehaviorType {
  POSITIVE
  NEGATIVE
}

enum TransportEvent {
  BOARDED_BUS
  ARRIVED_SCHOOL
  LEFT_SCHOOL
  PICKED_UP
}

enum FinanceAccountType {
  WAVE
  ORANGE_MONEY
  CASH
  BANK
}

enum FinanceTransactionType {
  INCOME
  EXPENSE
}

enum ContractType {
  CDI
  CDD
  VACATAIRE
  STAGE
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  TERMINATED
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  MATERNITY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  VALIDATED
  PAID
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  HALF_DAY
}

enum AdvanceStatus {
  PENDING
  APPROVED
  REJECTED
  DEDUCTED
}

enum SupplierInvoiceStatus {
  PENDING
  PAID
  CANCELLED
}

enum ScholarshipStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum ConsentType {
  DATA_PROCESSING
  PHOTOS
  HEALTH
  MARKETING
}

enum ConsentStatus {
  PENDING
  GRANTED
  REVOKED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      UserRole
  firstName String
  lastName  String
  phone     String?
  photoUrl  String?
  /// Super Admin peut désactiver un compte (connexion refusée).
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school       School?
  teacher      Teacher?
  parentProfile ParentProfile?
  organizationAdmin OrganizationAdmin?
  /// Compte élève lié à un enregistrement Student (accès lecture seule, données propres).
  studentId    String?  @unique
  student      Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  sentMessages Message[]      @relation("SentMessages")
  receivedMessages Message[]  @relation("ReceivedMessages")
  notifications      Notification[]
  notificationJobs   NotificationJob[]
  requestedTransfers TransferRequest[]
  auditTrails        AuditTrail[]
  consents           Consent[]
  refreshTokens      RefreshToken[]
  staffAssignments   SchoolStaffAssignment[]
  agfneImports       AgfneImportLog[]
}

/// Affectation staff école : permissions granulaires pour un compte SCHOOL_ADMIN.
model SchoolStaffAssignment {
  id        String          @id @default(cuid())
  staffRole SchoolStaffRole @default(SECRETARIAT)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([userId, schoolId])
  @@index([schoolId, staffRole])
}

model School {
  id                String   @id @default(cuid())
  name              String
  slug              String?  @unique
  address           String?
  city              String   @default("Abidjan")
  /// Commune / quartier (filtre /ecoles?commune=).
  commune           String?
  campusLabel       String?
  waveNumber        String?
  omNumber          String?
  smsSenderId       String?
  logoUrl           String?
  logoBase64        String?  @db.Text
  /// Code établissement MENET-FP (bulletin officiel CI).
  menetCode         String?
  /// Nom officiel en-tête bulletin (ex. « COMPLEXE SCOLAIRE IGES »). Sinon `name`.
  officialName      String?
  /// Agrément MENAPLN complet (ex. « 89 0459/MENSS/DESEC/SDE/CAB-1 »).
  menetAgrement     String?
  /// N°CC / RCCM (ex. « 9329192D »).
  nccNumber         String?
  /// Adresse postale BP (ex. « 10 BP 776 Abj. 10 »), distincte de `address`.
  postalAddress     String?
  /// Téléphones publics bulletin (plusieurs numéros, séparés par « / »).
  publicPhones      String?
  /// Niveaux enseignés (ex. « Maternelle – Primaire – Secondaire… »).
  educationLevels   String?
  /// DREN de rattachement (ex. « DREN Abidjan 3 »).
  dren              String?
  /// Nom du directeur / fondateur (visa bulletin).
  directorName      String?
  /// Logo secondaire en-tête bulletin (ex. filiale IGEST).
  secondaryLogoUrl       String?
  secondaryLogoBase64    String?  @db.Text
  /// Signature numérique du directeur (PNG/JPG) pour le visa bulletin.
  directorSignatureUrl     String?
  directorSignatureBase64  String?  @db.Text
  /// Cachet de l’établissement (PNG/JPG) pour le visa bulletin.
  directorStampUrl         String?
  directorStampBase64      String?  @db.Text
  /// Professeur principal par défaut (libellé bulletin MENET-FP).
  homeroomTeacherName String?
  subscription      String   @default("premium")
  currentSchoolYear String   @default("2025-2026")
  /// Collège par défaut : rien ne disparaît pour IGEST / écoles déjà en ligne.
  educationCycle    EducationCycle @default(COLLEGE)
  /// Page publique /e/:slug et listing /ecoles. Défaut off (opt-in direction).
  publicPortalEnabled Boolean @default(false)
  publicDescription   String? @db.Text
  publicPhone         String?
  lat                 Float?
  lng                 Float?
  /// Bannière vitrine (URL upload ou https). Pas de SVG.
  publicBanner        String?
  /// Galerie photos (JSON string[]). Pas de vidéos, pas de SVG.
  publicGallery       Json?
  /// Clubs, cantine, activités — texte public, sans listes d’élèves.
  publicLife          String? @db.Text
  /// Mise en avant marketplace. Réservé SUPER_ADMIN. True si PREMIUM ou VIP.
  publicFeatured      Boolean @default(false)
  /// Offre visibilité. NONE = pas de vitrine, même si un slug existe.
  marketplaceTier     MarketplaceTier @default(NONE)
  /// Début / fin abonnement Marketplace (super-admin).
  marketplaceStartedAt DateTime?
  marketplaceExpiresAt DateTime?
  /// Dernier e-mail de relance renouvellement (J-30).
  marketplaceRenewalReminderAt DateTime?
  publicType          PublicSchoolType @default(PRIVE)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  adminId String @unique
  admin   User   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  groupId String?
  group   Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  classes              Class[]
  teachers             Teacher[]
  feeTypes             FeeType[]
  lostItems            LostItem[]
  extracurriculars     Extracurricular[]
  canteenMenus         CanteenMenu[]
  pickupAuthorizations PickupAuthorization[]
  modules              SchoolModule[]
  financeAccounts      FinanceAccount[]
  expenseCategories    ExpenseCategory[]
  financeTransactions  FinanceTransaction[]
  students             Student[]
  auditLogs            AuditLog[]
  staffProfiles        StaffProfile[]
  staffDocuments       StaffDocument[]
  leaveRequests        LeaveRequest[]
  staffAttendances     StaffAttendance[]
  payrollRuns          PayrollRun[]
  payslips             Payslip[]
  salaryAdvances       SalaryAdvance[]
  staffEvaluations     StaffEvaluation[]
  payRubriques         SchoolPayRubrique[]
  transfersFrom        TransferRequest[] @relation("TransferFromSchool")
  transfersTo          TransferRequest[] @relation("TransferToSchool")
  accountingEntries    AccountingEntry[]
  studentYearRecords   StudentYearRecord[]
  studentEnrollments   StudentEnrollment[]
  absenceJustifications AbsenceJustification[]
  subjects             Subject[]
  timetables           Timetable[]
  notificationJobs     NotificationJob[]
  deliberations        Deliberation[]
  socialCases          SocialCase[]
  examSessions         ExamSession[]
  portalPosts          PortalPost[]
  portalAnalyticsDays  PortalAnalyticsDay[]
  schoolReviews        SchoolReview[]
  staffAssignments     SchoolStaffAssignment[]
  supplierInvoices     SupplierInvoice[]
  budgetLines          BudgetLine[]
  agfneImportLogs      AgfneImportLog[]

  planId Int?
  plan   SubscriptionPlan? @relation(fields: [planId], references: [id])

  @@index([groupId])
  @@index([publicPortalEnabled, city])
  @@index([publicPortalEnabled, commune])
  @@index([publicPortalEnabled, publicFeatured])
  @@index([publicPortalEnabled, marketplaceTier])
}

/// Stats vitrine publique (sans tracker tiers).
model PortalAnalyticsDay {
  id             String   @id @default(cuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  day            DateTime @db.Date
  views          Int      @default(0)
  payClicks      Int      @default(0)
  loginClicks    Int      @default(0)
  contactSubmits Int      @default(0)

  @@unique([schoolId, day])
  @@index([schoolId, day])
}

/// Actualité / événement public. Aucun nom d’élève, note ou matricule.
model PortalPost {
  id          String         @id @default(cuid())
  title       String
  body        String         @db.Text
  publishedAt DateTime       @default(now())
  kind        PortalPostKind @default(NEWS)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, publishedAt])
}

/// Avis parent modéré (vitrine publique uniquement).
model SchoolReview {
  id         String             @id @default(cuid())
  schoolId   String
  school     School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  authorName String
  rating     Int
  comment    String             @db.Text
  status     SchoolReviewStatus @default(PENDING)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([schoolId, status])
  @@index([status, createdAt])
}

model SubscriptionPlan {
  id       Int      @id @default(autoincrement())
  name     String
  price    Int
  features String[]
  schools  School[]
}

model Class {
  id         String   @id @default(cuid())
  name       String
  level      String
  schoolYear String   @default("2025-2026")
  /// Lycée : tous les élèves héritent, sauf override élève. Null = collège.
  series     SchoolSeries?
  createdAt  DateTime @default(now())

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  students  Student[]
  teachers  TeacherClass[]
  homeworks Homework[]
  schedules Schedule[]
  deliberations Deliberation[]
  incomingTransfers TransferRequest[]
  yearRecords StudentYearRecord[]
  timetables    Timetable[]
  examSessions  ExamSession[]
}

model Student {
  id         String    @id @default(cuid())
  firstName  String
  lastName   String
  /// Matricule interne de l’établissement (liaison parent, IGEST IG-DEMO-*).
  matricule  String?
  /// Matricule national MEN (collèges-lycées CI). Unique par école lorsqu’il est renseigné.
  nationalMatricule String?
  birthDate  DateTime?
  /// Lieu de naissance (fiche inscription CI).
  birthPlace String?
  gender     String?
  /// Nationalité (fiche inscription CI).
  nationality String?
  /// Père / mère / tuteur (fiche inscription).
  fatherName    String?
  motherName    String?
  guardianName  String?
  guardianPhone String?
  contactPhone  String?
  contactEmail  String?
  /// Override série si la classe est mixte. Sinon héritage Class.series.
  series     SchoolSeries?
  photoUrl   String?
  createdAt  DateTime  @default(now())

  schoolId String?
  school   School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId  String
  class    Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  parents              ParentStudent[]
  payments             Payment[]
  paymentProofs        PaymentProof[]
  absences             Absence[]
  justifications       AbsenceJustification[]
  grades               Grade[]
  bulletins            Bulletin[]
  deliberations        Deliberation[]
  messages             Message[]
  homeworks            HomeworkSubmission[]
  healthIncidents      HealthIncident[]
  behaviorNotes        BehaviorNote[]
  badges               Badge[]
  transportLogs        TransportLog[]
  canteenRecords       CanteenRecord[]
  extracurricularEnrolls ExtracurricularEnrollment[]
  pickupAuthorizations PickupAuthorization[]
  lostItems            LostItem[]
  transferRequests     TransferRequest[]
  scholarships         Scholarship[]
  yearRecords          StudentYearRecord[]
  enrollments          StudentEnrollment[]
  socialCases          SocialCase[]
  user                 User?

  @@unique([schoolId, matricule])
  @@unique([schoolId, nationalMatricule])
}

model StudentYearRecord {
  id         String   @id @default(cuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolYear String
  classId    String
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  schoolId   String?
  school     School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  repeatYear Boolean  @default(false)
  status     String
  createdAt  DateTime @default(now())
  gender     String?

  @@index([schoolYear, studentId])
  @@unique([studentId, schoolYear])
}

/// Fiche d’inscription / réinscription annuelle (contexte ivoirien).
model StudentEnrollment {
  id              String   @id @default(cuid())
  schoolYear      String
  enrolledAt      DateTime @default(now())
  /// NOUVEAU | REINSCRIPTION | TRANSFERT | REAFFECTATION
  enrollmentStatus String  @default("NOUVEAU")
  lv2             String?
  birthCertNumber String?
  birthCertDate   DateTime?
  birthCertPlace  String?
  previousSchool  String?
  previousClass   String?
  transferRef     String?
  decisionNumber  String?
  isScholarship   Boolean  @default(false)
  /// Cases cochées : photos, extraitNaissance, certificatScolarite, …
  documentsChecklist Json?
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolId  String
  school    School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([studentId, schoolYear])
  @@index([schoolId, schoolYear])
}

/// Journal des imports AGFNE / SIGFNE (fichiers officiels MEN).
model AgfneImportLog {
  id         String   @id @default(cuid())
  filename   String
  rowCount   Int      @default(0)
  /// PREVIEW | COMPLETED | FAILED | CANCELLED
  status     String   @default("PREVIEW")
  format     String?
  previewData Json?
  stats      Json?
  createdAt  DateTime @default(now())
  completedAt DateTime?

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@index([userId])
}

model ParentProfile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  children ParentStudent[]
  justifications AbsenceJustification[]
}

model ParentStudent {
  id        String   @id @default(cuid())
  relation  String   @default("parent")
  createdAt DateTime @default(now())

  parentId  String
  parent    ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId String
  student   Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
}

model Teacher {
  id        String   @id @default(cuid())
  subject   String?
  createdAt DateTime @default(now())

  userId   String @unique
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  classes       TeacherClass[]
  grades        Grade[]
  absences      Absence[]
  homeworks     Homework[]
  behaviorNotes BehaviorNote[]
  badges        Badge[]
  schedules     Schedule[]
  staffProfile  StaffProfile?
  leaveRequests LeaveRequest[]
  attendances   StaffAttendance[]
  payslips      Payslip[]
  salaryAdvances SalaryAdvance[]
  evaluations   StaffEvaluation[]
  staffDocuments StaffDocument[]
  teacherProfile TeacherProfile?
  leaves         Leave[]
  payrolls       Payroll[]
  hrEvaluations  Evaluation[]
  timetables     Timetable[]
}

model TeacherClass {
  id String @id @default(cuid())

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId   String
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([teacherId, classId])
}

model FeeType {
  id          String  @id @default(cuid())
  name        String
  amount      Int
  description String?
  dueDay      Int?
  isActive    Boolean @default(true)

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  payments Payment[]
}

model Payment {
  id          String        @id @default(cuid())
  amount      Int
  status      PaymentStatus @default(PENDING)
  proofUrl    String?
  reference   String?
  note        String?
  /// PARENT (preuve Wave/OM) ou CAISSE (guichet secrétariat)
  source      String?
  /// CASH | WAVE | ORANGE_MONEY | BANK
  method      String?
  validatedAt DateTime?
  createdAt   DateTime      @default(now())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeTypeId String?
  feeType   FeeType? @relation(fields: [feeTypeId], references: [id])
  receiptUrl String?
  proofs     PaymentProof[]
}

model PaymentProof {
  id           String   @id @default(cuid())
  hash         String   @unique
  fileUrl      String
  mimeType     String
  size         Int
  originalName String?
  createdAt    DateTime @default(now())

  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
}

model Absence {
  id        String      @id @default(cuid())
  date      DateTime    @db.Date
  type      AbsenceType @default(ABSENCE)
  reason    String?
  /// Justifiée après acceptation d’un justificatif parent.
  justified Boolean     @default(false)
  /// NONE | PENDING | ACCEPTED | REFUSED
  justificationStatus String @default("NONE")
  createdAt DateTime    @default(now())

  studentId  String
  student    Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy String?
  teacher    Teacher? @relation(fields: [recordedBy], references: [id])
  justifications AbsenceJustification[]
}

/// Justificatif d’absence / retard soumis par un parent (photo ou PDF).
model AbsenceJustification {
  id           String   @id @default(cuid())
  motif        String
  fileUrl      String?
  mimeType     String?
  originalName String?
  /// PENDING | ACCEPTED | REFUSED
  status       String   @default("PENDING")
  reviewNote   String?
  reviewedAt   DateTime?
  reviewedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  absenceId String
  absence   Absence @relation(fields: [absenceId], references: [id], onDelete: Cascade)
  parentId  String
  parent    ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  schoolId  String
  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([absenceId])
  @@index([parentId])
}

model Grade {
  id        String    @id @default(cuid())
  subject   String
  value     Float
  maxValue  Float     @default(20)
  period    String
  term      String?
  /// INTERRO | DEVOIR | COMPOSITION. Null / défaut = DEVOIR (notes existantes).
  kind      GradeKind @default(DEVOIR)
  comment   String?
  createdAt DateTime  @default(now())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])

  @@index([studentId, term])
}

model Bulletin {
  id          String   @id @default(cuid())
  period      String
  pdfUrl      String?
  average     Float?
  rank        Int?
  generatedAt DateTime @default(now())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

/// Session d’examen (blanc ou national) pour convocations imprimables.
model ExamSession {
  id        String   @id @default(cuid())
  subject   String
  examType  ExamType
  date      DateTime @db.Date
  startTime String?
  room      String?
  term      String?
  createdAt DateTime @default(now())
  createdBy String?

  schoolId String
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId  String
  class    Class  @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([schoolId, classId, date])
  @@index([schoolId, createdAt])
}

/// Conseil de classe (direction) : mention + décision par élève / trimestre.
model Deliberation {
  id         String   @id @default(cuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classId    String
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term       String
  schoolYear String   @default("2025-2026")
  mention    String?
  decision   String
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([studentId, classId, term, schoolYear])
  @@index([schoolId, classId, term])
}

model Message {
  id        String   @id @default(cuid())
  content   String?
  audioUrl  String?
  fileUrl   String?
  fileName  String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  senderId   String
  sender     User    @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User    @relation("ReceivedMessages", fields: [receiverId], references: [id])
  studentId  String?
  student    Student? @relation(fields: [studentId], references: [id])
}

model Homework {
