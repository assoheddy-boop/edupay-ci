<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('absences', { _inLayout: true }); %>
<%- include('../layouts/teacherLayout', { body: content, title: 'Absences' }) %>
<% } else { %>
<div class="page-header"><h1>Absences & retards</h1></div>

  <div class="card">
    <form method="POST" action="/teacher/absences" class="form">
      <div class="form-group">
        <label for="studentId">Élève</label>
        <select id="studentId" name="studentId" required>
          <option value="">— Choisir —</option>
          <% classLinks.forEach(link => { %>
            <% link.class.students.forEach(s => { %>
              <option value="<%= s.id %>"><%= s.firstName %> <%= s.lastName %> (<%= link.class.name %>)</option>
            <% }) %>
          <% }) %>
        </select>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="date">Date</label>
          <input type="date" id="date" name="date" required>
        </div>
        <div class="form-group">
          <label for="type">Type</label>
          <select id="type" name="type">
            <option value="ABSENCE">Absence</option>
            <option value="LATE">Retard</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label for="reason">Motif</label>
        <input type="text" id="reason" name="reason" placeholder="Optionnel">
      </div>
      <button type="submit" class="btn btn-primary btn-lg">Signaler — le parent sera notifié</button>
    </form>
  </div>
<% } %>
