<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('grades', { _inLayout: true }); %>
<%- include('../layouts/teacherLayout', { body: content, title: 'Saisie notes' }) %>
<% } else { %>
<div class="page-header"><h1>Saisie des notes</h1></div>

  <div class="card">
    <form method="POST" action="/teacher/grades" class="form" data-offline-queue="grade">
      <div class="form-group">
        <label for="studentId">Élève</label>
        <select id="studentId" name="studentId" required>
          <option value="">— Choisir —</option>
          <% classLinks.forEach(link => { %>
            <% link.class.students.forEach(s => { %>
              <option value="<%= s.id %>"><%= s.firstName %> <%= s.lastName %> (<%= link.class.name %>)</option>
            <% }) %>
          <% }) %>
        </select>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="subject">Matière</label>
          <input type="text" id="subject" name="subject" list="subjectList" required placeholder="Ex: Mathématiques">
          <datalist id="subjectList">
            <% (subjects || []).forEach(s => { %>
              <option value="<%= s.name %>"></option>
            <% }) %>
          </datalist>
        </div>
        <div class="form-group">
          <label for="period">Période</label>
          <select id="period" name="period" required>
            <option value="">— Choisir —</option>
            <% (terms || []).forEach(t => { %>
              <option value="<%= t.value %>"><%= t.label %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="value">Note</label>
          <input type="number" id="value" name="value" step="0.25" min="0" required>
        </div>
        <div class="form-group">
          <label for="maxValue">Sur</label>
          <input type="number" id="maxValue" name="maxValue" value="20" step="0.25" min="1">
        </div>
        <div class="form-group">
          <label for="coefficient">Coefficient</label>
          <input type="number" id="coefficient" name="coefficient" min="0.5" step="0.5" placeholder="auto">
          <p class="form-hint">Défaut de l'école — modifiable ici (Maths 4, Français 3…).</p>
        </div>
      </div>
      <div class="form-group">
        <label for="comment">Commentaire</label>
        <textarea id="comment" name="comment" rows="2"></textarea>
      </div>
      <button type="submit" class="btn btn-primary btn-lg">Enregistrer la note</button>
    </form>
  </div>
  <script>
    (function () {
      const coeffs = <%- JSON.stringify(coeffMap || {}) %>;
      const defaults = <%- JSON.stringify(collegeDefaults || {}) %>;
      const input = document.getElementById('subject');
      const coef = document.getElementById('coefficient');
      if (!input || !coef) return;
      function fill() {
        const name = (input.value || '').trim();
        if (coeffs[name] != null) coef.value = coeffs[name];
        else if (defaults[name] != null) coef.value = defaults[name];
      }
      input.addEventListener('change', fill);
      input.addEventListener('blur', fill);
    })();
  </script>
<% } %>
