<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('grades', { _inLayout: true }); %>
<%- include('../layouts/teacherLayout', { body: content, title: 'Saisie notes' }) %>
<% } else { %>
<div class="page-header"><h1>Saisie des notes</h1></div>

  <div class="card">
    <form method="POST" action="/teacher/grades" class="form" data-offline-queue="grade">
      <div class="form-group">
        <label for="studentId">Élève</label>
        <select id="studentId" name="studentId" required>
          <option value="">— Choisir —</option>
          <% classLinks.forEach(link => { %>
            <% link.class.students.forEach(s => { %>
              <option value="<%= s.id %>"><%= s.firstName %> <%= s.lastName %> (<%= link.class.name %>)</option>
            <% }) %>
          <% }) %>
        </select>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="subject">Matière</label>
          <input type="text" id="subject" name="subject" required placeholder="Ex: Mathématiques">
        </div>
        <div class="form-group">
          <label for="period">Période</label>
          <input type="text" id="period" name="period" required placeholder="Ex: Trimestre 1">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="value">Note</label>
          <input type="number" id="value" name="value" step="0.25" min="0" required>
        </div>
        <div class="form-group">
          <label for="maxValue">Sur</label>
          <input type="number" id="maxValue" name="maxValue" value="20" step="0.25" min="1">
        </div>
      </div>
      <div class="form-group">
        <label for="comment">Commentaire</label>
        <textarea id="comment" name="comment" rows="2"></textarea>
      </div>
      <button type="submit" class="btn btn-primary btn-lg">Enregistrer la note</button>
    </form>
  </div>
<% } %>
