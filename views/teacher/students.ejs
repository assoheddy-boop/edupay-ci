<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('students', { _inLayout: true }); %>
<%- include('../layouts/teacherLayout', { body: content, title: 'Élèves' }) %>
<% } else { %>
<div class="page-header"><h1>Mes élèves</h1></div>

  <% classLinks.forEach(link => { %>
    <div class="card">
      <h2><%= link.class.name %></h2>
      <% if (link.class.students.length === 0) { %>
        <p class="empty">Aucun élève.</p>
      <% } else { %>
        <table class="table">
          <thead><tr><th>Nom</th><th>Mat. école</th><th>Mat. national</th></tr></thead>
          <tbody>
            <% link.class.students.forEach(s => { %>
              <tr>
                <td class="person-cell">
                  <%- include('../partials/_avatar', { src: s.photoUrl, firstName: s.firstName, lastName: s.lastName, size: 'sm' }) %>
                  <%= s.firstName %> <%= s.lastName %>
                </td>
                <td><code><%= s.matricule || '—' %></code></td>
                <td><code><%= s.nationalMatricule || '—' %></code></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  <% }) %>
<% } %>
