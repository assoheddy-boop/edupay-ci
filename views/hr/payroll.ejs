<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<%
  const layoutFile = user.role === 'TEACHER' ? 'teacherLayout' : 'schoolLayout';
  const content = include('payroll', { _inLayout: true });
%>
<%- include('../layouts/' + layoutFile, { body: content, title: 'RH — Paie' }) %>
<% } else { %>
<div class="page-header">
  <h1>Paie</h1>
  <p class="page-sub">Génération du bulletin (montant + PDF)</p>
</div>
<%- include('_nav') %>

<% if (success) { %><div class="alert alert-success">Bulletin de paie généré.</div><% } %>
<% if (error === 'teacher') { %><div class="alert alert-error">Enseignant introuvable.</div><% } %>
<% if (error === 'already_paid') { %><div class="alert alert-error">Cette paie est déjà marquée comme payée.</div><% } %>

<% if (user.role === 'SCHOOL_ADMIN') { %>
<div class="card" style="margin-bottom:1.5rem">
  <h2>Générer un bulletin</h2>
  <form method="POST" action="/hr/payroll" class="form form-inline">
    <select name="teacherId" required>
      <option value="">Enseignant</option>
      <% teachers.forEach(function(t) { %>
        <option value="<%= t.id %>"><%= t.user.lastName %> <%= t.user.firstName %></option>
      <% }) %>
    </select>
    <input type="month" name="month" required>
    <button type="submit" class="btn btn-primary">Générer</button>
  </form>
</div>
<% } %>

<div class="card">
  <h2>Bulletins</h2>
  <% if (!payrolls.length) { %>
    <p class="empty">Aucun bulletin.</p>
  <% } else { %>
    <table class="table">
      <thead><tr><th>Enseignant</th><th>Mois</th><th>Montant</th><th>PDF</th></tr></thead>
      <tbody>
        <% payrolls.forEach(function(p) { %>
          <tr>
            <td><%= p.teacher.user.lastName %> <%= p.teacher.user.firstName %></td>
            <td><%= p.month %></td>
            <td><strong><%= p.amount.toLocaleString('fr-FR') %> FCFA</strong></td>
            <td><% if (p.pdfPath) { %><a href="<%= p.pdfPath %>" target="_blank">Télécharger</a><% } else { %>—<% } %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
<% } %>
