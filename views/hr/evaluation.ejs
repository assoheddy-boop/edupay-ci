<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<%
  const layoutFile = user.role === 'TEACHER' ? 'teacherLayout' : 'schoolLayout';
  const content = include('evaluation', { _inLayout: true });
%>
<%- include('../layouts/' + layoutFile, { body: content, title: 'RH — Évaluations' }) %>
<% } else { %>
<div class="page-header">
  <h1>Évaluations</h1>
  <p class="page-sub">Note sur 20 et commentaires</p>
</div>
<%- include('_nav') %>

<% if (success) { %><div class="alert alert-success">Évaluation enregistrée.</div><% } %>
<% if (error === 'teacher') { %><div class="alert alert-error">Enseignant introuvable.</div><% } %>
<% if (error === 'score') { %><div class="alert alert-error">Score invalide (0 à 20).</div><% } %>

<% if (user.role === 'SCHOOL_ADMIN') { %>
<div class="card" style="margin-bottom:1.5rem">
  <h2>Nouvelle évaluation</h2>
  <form method="POST" action="/hr/evaluation" class="form">
    <div class="form-group">
      <label for="teacherId">Enseignant</label>
      <select id="teacherId" name="teacherId" required>
        <% teachers.forEach(function(t) { %>
          <option value="<%= t.id %>"><%= t.user.lastName %> <%= t.user.firstName %></option>
        <% }) %>
      </select>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label for="score">Score / 20</label>
        <input type="number" id="score" name="score" min="0" max="20" required>
      </div>
      <div class="form-group">
        <label for="comments">Commentaires</label>
        <input type="text" id="comments" name="comments" placeholder="Points forts, axes d'amélioration">
      </div>
    </div>
    <button type="submit" class="btn btn-primary">Enregistrer</button>
  </form>
</div>
<% } %>

<div class="card">
  <h2>Historique</h2>
  <% if (!evaluations.length) { %>
    <p class="empty">Aucune évaluation.</p>
  <% } else { %>
    <table class="table">
      <thead><tr><th>Enseignant</th><th>Score</th><th>Commentaires</th></tr></thead>
      <tbody>
        <% evaluations.forEach(function(e) { %>
          <tr>
            <td><%= e.teacher.user.lastName %> <%= e.teacher.user.firstName %></td>
            <td><strong><%= e.score %>/20</strong></td>
            <td><%= e.comments || '—' %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
<% } %>
