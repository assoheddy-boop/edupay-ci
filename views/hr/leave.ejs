<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<%
  const layoutFile = user.role === 'TEACHER' ? 'teacherLayout' : 'schoolLayout';
  const content = include('leave', { _inLayout: true });
%>
<%- include('../layouts/' + layoutFile, { body: content, title: presenceMode ? 'RH — Présence' : 'RH — Congés' }) %>
<% } else { %>
<div class="page-header">
  <h1><%= typeof presenceMode !== 'undefined' && presenceMode ? 'Présence' : 'Congés' %></h1>
</div>
<%- include('_nav') %>

<% if (success) { %><div class="alert alert-success">Demande de congé enregistrée.</div><% } %>
<% if (error === 'teacher') { %><div class="alert alert-error">Enseignant introuvable.</div><% } %>
<% if (error === 'dates' || error === 'range') { %><div class="alert alert-error">Dates invalides.</div><% } %>

<% if (typeof presenceMode === 'undefined' || !presenceMode) { %>
<div class="card" style="margin-bottom:1.5rem">
  <h2>Nouvelle demande</h2>
  <form method="POST" action="/hr/leave" class="form">
    <% if (user.role === 'SCHOOL_ADMIN') { %>
      <div class="form-group">
        <label for="teacherId">Enseignant</label>
        <select id="teacherId" name="teacherId" required>
          <% teachers.forEach(function(t) { %>
            <option value="<%= t.id %>" <%= teacherId === t.id ? 'selected' : '' %>>
              <%= t.user.lastName %> <%= t.user.firstName %>
            </option>
          <% }) %>
        </select>
      </div>
    <% } %>
    <div class="form-row">
      <div class="form-group">
        <label for="startDate">Début</label>
        <input type="date" id="startDate" name="startDate" required>
      </div>
      <div class="form-group">
        <label for="endDate">Fin</label>
        <input type="date" id="endDate" name="endDate" required>
      </div>
    </div>
    <button type="submit" class="btn btn-primary">Envoyer</button>
  </form>
</div>
<% } %>

<% if (typeof attendances !== 'undefined' && attendances.length) { %>
<div class="card" style="margin-bottom:1.5rem">
  <h2>Présence</h2>
  <table class="table">
    <thead><tr><th>Date</th><th>Enseignant</th><th>Statut</th><th>Arrivée</th><th>Départ</th></tr></thead>
    <tbody>
      <% attendances.forEach(function(a) { %>
        <tr>
          <td><%= new Date(a.date).toLocaleDateString('fr-FR') %></td>
          <td><%= a.teacher.user.lastName %> <%= a.teacher.user.firstName %></td>
          <td><%= a.status %></td>
          <td><%= a.checkIn ? new Date(a.checkIn).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }) : '—' %></td>
          <td><%= a.checkOut ? new Date(a.checkOut).toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' }) : '—' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<% } else if (typeof presenceMode !== 'undefined' && presenceMode) { %>
  <div class="card"><p class="empty">Aucune présence enregistrée.</p></div>
<% } %>

<div class="card">
  <h2>Demandes de congé</h2>
  <% if (!leaves.length) { %>
    <p class="empty">Aucune demande.</p>
  <% } else { %>
    <table class="table">
      <thead><tr><th>Enseignant</th><th>Début</th><th>Fin</th><th>Statut</th></tr></thead>
      <tbody>
        <% leaves.forEach(function(l) { %>
          <tr>
            <td><%= l.teacher.user.lastName %> <%= l.teacher.user.firstName %></td>
            <td><%= new Date(l.startDate).toLocaleDateString('fr-FR') %></td>
            <td><%= new Date(l.endDate).toLocaleDateString('fr-FR') %></td>
            <td><span class="badge"><%= l.status %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
<% } %>
