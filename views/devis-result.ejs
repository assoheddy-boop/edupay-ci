<%- include('partials/head') %>
<% const a = typeof answers !== 'undefined' && answers ? answers : {}; %>
<% const life = a.life || {}; const admin = a.admin || {}; const comm = a.comm || {}; const hist = a.history || {}; %>
<% const selected = summary && summary.selected ? summary.selected : []; %>
<% const isConvention = typeof conventionOnly !== 'undefined' ? conventionOnly : (summary && summary.conventionOnly); %>
<% const parentContrib = typeof parentContribution !== 'undefined' ? parentContribution : (summary && summary.parentContribution); %>
<div class="home devis-page">
  <header class="home-top">
    <a href="/" class="home-logo">
      <span class="home-logo-mark" aria-hidden="true">🎓</span>
      <span>Edu<strong>Connect</strong></span>
    </a>
    <nav class="home-links" aria-label="Navigation">
      <a href="/">Accueil</a>
      <a href="/tarifs">Tarifs</a>
      <a href="/devis">Nouveau devis</a>
      <a href="/auth/login">Connexion</a>
    </nav>
  </header>

  <section class="devis-hero">
    <p class="home-kicker">Devis n° <%= quote.id.slice(-8).toUpperCase() %></p>
    <% if (isConvention) { %>
      <h1>Demande de convention — lycée public</h1>
      <p><%= summary.conventionMessage || 'Accès sur convention signée avec Alliance Digitale Internationale.' %></p>
    <% } else { %>
      <h1>Votre devis EduConnect</h1>
      <p><%= summary.tagline || 'Tarification transparente selon le cycle scolaire' %></p>
    <% } %>
  </section>

  <% if (typeof activationMessage !== 'undefined' && activationMessage) { %>
    <div class="alert alert-success devis-alert" role="status"><%= activationMessage %></div>
  <% } %>

  <% if (isConvention) { %>
  <article class="devis-offer devis-offer-convention">
    <p class="devis-offer-kicker">Lycée public</p>
    <h2>Convention signée</h2>
    <p class="devis-offer-tag"><%= summary.conventionMessage || 'Pour les lycées publics, l\'accès à EduConnect se fait uniquement par convention signée avec l\'établissement. Les directions sont priées de faire une demande officielle de convention.' %></p>
  </article>
  <% } else { %>
  <article class="devis-offer">
    <p class="devis-offer-kicker">Tarif établissement</p>
    <h2><%= summary.cycleLabel || 'EduConnect' %></h2>
    <p class="devis-offer-price"><strong><%= amountLabel %></strong> <span>/ an</span></p>
    <p class="devis-offer-tag">Gestion scolaire complète — inscriptions, notes, finances, communication</p>
  </article>
  <aside class="devis-offer devis-offer-parent">
    <p class="devis-offer-kicker">Contribution parentale</p>
    <p class="devis-offer-price"><strong><%= typeof formatMoney === 'function' ? formatMoney(parentContrib.amount) : '2 500 FCFA' %></strong> <span>/ parent / an</span></p>
    <p class="devis-offer-tag">Bulletins, notes, absences, notifications et espace parent sécurisé</p>
  </aside>
  <% } %>

  <% if (summary.marketplace && summary.marketplace.selected) { %>
  <article class="devis-offer devis-offer-marketplace">
    <p class="devis-offer-kicker">Visibilité web</p>
    <h2>Visibilité web — <%= summary.marketplace.label %></h2>
    <p class="devis-offer-price"><strong><%= marketplaceAmountLabel %></strong> <span>/ an</span></p>
    <p class="devis-offer-tag"><%= summary.marketplace.hint %> — page /e/:slug et annuaire /ecoles</p>
  </article>
  <% if (!isConvention) { %>
  <article class="devis-offer devis-offer-total">
    <p class="devis-offer-kicker">Total annuel</p>
    <p class="devis-offer-price"><strong><%= totalAmountLabel %></strong> <span>/ an</span></p>
    <p class="devis-offer-tag">Établissement + visibilité web (lignes de facturation distinctes)</p>
  </article>
  <% } %>
  <% } %>

  <section class="devis-card">
    <h2>Votre établissement</h2>
    <dl class="devis-dl">
      <div><dt>Cycle</dt><dd><%= summary.cycleLabel || a.cycleLabel || '—' %></dd></div>
      <div><dt>Nom</dt><dd><%= a.schoolName || quote.schoolName %></dd></div>
      <div><dt>Ville</dt><dd><%= a.city || quote.city %></dd></div>
      <div><dt>Groupe scolaire</dt><dd><%= a.isGroup ? (a.groupName || 'Oui') : 'Non' %></dd></div>
      <div><dt>Élèves</dt><dd><%= a.students %></dd></div>
      <div><dt>Enseignants</dt><dd><%= a.teachers %></dd></div>
      <div><dt>Classes</dt><dd><%= a.classes %></dd></div>
    </dl>
  </section>

  <section class="devis-card">
    <h2>Modules cochés</h2>
    <% if (selected.length) { %>
      <ul class="devis-mods">
        <% selected.forEach(function (m) { %><li><%= m %></li><% }) %>
      </ul>
    <% } else { %>
      <p class="devis-hint">Aucun module optionnel coché — la plateforme couvre déjà le cœur pédagogique et le pilotage.</p>
    <% } %>
    <h3>Toujours inclus</h3>
    <ul class="devis-mods devis-mods-core">
      <% summary.core.forEach(function (m) { %><li><%= m %></li><% }) %>
      <% summary.included.forEach(function (m) { %><li><%= m %></li><% }) %>
    </ul>
  </section>

  <section class="devis-card">
    <h2>Réponses</h2>
    <dl class="devis-dl">
      <div><dt>Cantine</dt><dd><%= life.canteen ? 'Oui' : 'Non' %></dd></div>
      <div><dt>Transport</dt><dd><%= life.transport ? 'Oui' : 'Non' %></dd></div>
      <div><dt>Activités</dt><dd><%= life.activities ? 'Oui' : 'Non' %></dd></div>
      <div><dt>Santé</dt><dd><%= life.health ? 'Oui' : 'Non' %></dd></div>
      <div><dt>Comptabilité</dt><dd><%= admin.accounting ? 'Oui' : 'Non' %></dd></div>
      <div><dt>RH</dt><dd><%= admin.hr ? 'Oui' : 'Non' %></dd></div>
      <div><dt>Multi-école</dt><dd><%= admin.multiSchool ? 'Oui' : 'Non' %></dd></div>
      <div><dt>SMS officiel</dt><dd><%= comm.smsOfficial ? 'Oui' : 'Non' %></dd></div>
      <div><dt>Push / e-mail</dt><dd><%= comm.pushEmail ? 'Oui' : 'Non' %></dd></div>
      <div><dt>Effectifs N-3 / N-2 / N-1</dt><dd><%= [hist.year1, hist.year2, hist.year3].map(function (n) { return n == null ? '—' : n; }).join(' / ') %></dd></div>
      <div><dt>Budget digitalisation</dt><dd><%= hist.digitalBudget || '—' %></dd></div>
    </dl>
  </section>

  <div class="devis-actions">
    <a class="home-btn home-btn-primary home-btn-xl" href="/devis/<%= quote.id %>/pdf">Télécharger le devis PDF</a>
    <% if (quote.status !== 'activation_requested' && !activationOk) { %>
      <form method="POST" action="/devis/<%= quote.id %>/activer">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="home-btn home-btn-outline home-btn-xl"><%= isConvention ? 'Confirmer la demande de convention' : 'Demander activation' %></button>
      </form>
    <% } %>
  </div>
</div>
<%- include('partials/footer') %>
<%- include('partials/scripts') %>
