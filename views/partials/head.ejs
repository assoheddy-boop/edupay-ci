<!DOCTYPE html>
<html lang="<%= typeof htmlLang !== 'undefined' ? htmlLang : 'fr' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#0052CC">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' && metaDescription ? metaDescription : 'EduConnect — Gestion scolaire & paiements Wave/OM, Côte d\'Ivoire' %>">
  <meta name="robots" content="<%= typeof robots !== 'undefined' && robots ? robots : 'index, follow' %>">
  <link rel="manifest" href="<%= typeof manifestHref !== 'undefined' && manifestHref ? manifestHref : '/manifest.json' %>">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">
  <% if (typeof appleWebAppTitle !== 'undefined' && appleWebAppTitle) { %>
  <meta name="apple-mobile-web-app-title" content="<%= appleWebAppTitle %>">
  <% } %>
  <% if (typeof canonicalUrl !== 'undefined' && canonicalUrl) { %>
  <link rel="canonical" href="<%= canonicalUrl %>">
  <% } %>
  <% if (typeof ogTitle !== 'undefined' && ogTitle) { %>
  <meta property="og:title" content="<%= ogTitle %>">
  <meta property="og:description" content="<%= typeof ogDescription !== 'undefined' && ogDescription ? ogDescription : (typeof metaDescription !== 'undefined' ? metaDescription : '') %>">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="<%= typeof ogLocale !== 'undefined' && ogLocale ? ogLocale : 'fr_FR' %>">
  <% if (typeof canonicalUrl !== 'undefined' && canonicalUrl) { %>
  <meta property="og:url" content="<%= canonicalUrl %>">
  <% } %>
  <% if (typeof ogImage !== 'undefined' && ogImage) { %>
  <meta property="og:image" content="<%= ogImage %>">
  <% if (typeof ogImageWidth !== 'undefined' && ogImageWidth) { %>
  <meta property="og:image:width" content="<%= ogImageWidth %>">
  <% } %>
  <% if (typeof ogImageHeight !== 'undefined' && ogImageHeight) { %>
  <meta property="og:image:height" content="<%= ogImageHeight %>">
  <% } %>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= ogTitle %>">
  <meta name="twitter:description" content="<%= typeof ogDescription !== 'undefined' && ogDescription ? ogDescription : (typeof metaDescription !== 'undefined' ? metaDescription : '') %>">
  <meta name="twitter:image" content="<%= ogImage %>">
  <% } %>
  <meta property="og:site_name" content="EduConnect">
  <% } %>
  <title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>EduConnect</title>
  <link rel="stylesheet" href="/css/main.css?v=12">
  <% if (typeof homeCss !== 'undefined' && homeCss) { %>
  <link rel="stylesheet" href="/css/home.css?v=7">
  <% } %>
  <% if (typeof devisCss !== 'undefined' && devisCss) { %>
  <link rel="stylesheet" href="/css/devis.css?v=1">
  <% } %>
  <% if (typeof portalCss !== 'undefined' && portalCss) { %>
  <link rel="stylesheet" href="/css/portal.css?v=10">
  <% } %>
  <% if (typeof correspondanceCss !== 'undefined' && correspondanceCss) { %>
  <link rel="stylesheet" href="/css/correspondance.css?v=1">
  <% } %>
  <% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
  <meta name="csrf-token" content="<%= csrfToken %>">
  <% } %>
</head>
<body<% if (typeof user !== 'undefined' && user) { %> data-user-id="<%= user.id %>" data-user-role="<%= user.role %>"<% } %>>
<%- include('_adminAssistBanner') %>
