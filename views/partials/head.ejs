<!DOCTYPE html>
<html lang="<%= typeof htmlLang !== 'undefined' ? htmlLang : 'fr' %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#0052CC">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="description" content="EduConnect — Gestion scolaire & paiements Wave/OM, Côte d'Ivoire">
  <link rel="manifest" href="/manifest.json">
  <link rel="apple-touch-icon" href="/icons/icon-192.png">
  <title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>EduConnect</title>
  <link rel="stylesheet" href="/css/main.css?v=5">
  <% if (typeof homeCss !== 'undefined' && homeCss) { %>
  <link rel="stylesheet" href="/css/home.css?v=1">
  <% } %>
</head>
<body<% if (typeof user !== 'undefined' && user) { %> data-user-id="<%= user.id %>" data-user-role="<%= user.role %>"<% } %>>
