<header class="app-navbar">
  <div class="app-navbar-inner">
    <button type="button" class="nav-toggle" id="sidebarToggle" aria-label="Menu" aria-expanded="false" aria-controls="appSidebar">
      <span></span><span></span><span></span>
    </button>
    <a href="/" class="logo">
      <span class="logo-icon">🎓</span>
      <span class="logo-text">Edu<strong>Connect</strong></span>
    </a>
    <% if (typeof user !== 'undefined' && user && user.school) { %>
      <span class="navbar-school">
        <%- include('_logo', { logoUrl: user.school.logoUrl, logoBase64: user.school.logoBase64, slug: user.school.slug, name: user.school.name, size: 'sm' }) %>
        <span class="navbar-school-name"><%= user.school.name %></span>
      </span>
    <% } %>
    <div class="app-navbar-end">
      <% if (typeof user !== 'undefined' && user) { %>
        <% const unread = typeof unreadNotifications !== 'undefined' ? unreadNotifications : 0; %>
        <% if (user.role === 'PARENT' || user.role === 'TEACHER') { %>
          <a
            href="<%= user.role === 'PARENT' ? '/parent/notifications' : '/teacher/notifications' %>"
            class="nav-bell"
            aria-label="Notifications<%= unread > 0 ? ` (${unread} non lues)` : '' %>"
          >
            <span aria-hidden="true">🔔</span>
            <% if (unread > 0) { %><span class="nav-bell-count"><%= unread > 99 ? '99+' : unread %></span><% } %>
          </a>
        <% } %>
        <span class="app-navbar-user">
          <%- include('_avatar', { src: user.photoUrl, firstName: user.firstName, lastName: user.lastName, size: 'sm' }) %>
          <span class="app-navbar-user-name"><%= user.firstName %> <%= user.lastName %></span>
        </span>
        <a href="/auth/logout" class="btn btn-outline btn-sm">Déconnexion</a>
      <% } else { %>
        <a href="/auth/login">Connexion</a>
        <a href="/auth/register" class="btn btn-primary btn-sm">Inscription</a>
      <% } %>
    </div>
  </div>
</header>
