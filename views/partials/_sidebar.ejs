<% const currentUser = typeof user !== 'undefined' ? user : null; %>
<% const m = typeof modules !== 'undefined' ? modules : {}; %>
<% const on = (k) => m[k]?.enabled !== false; %>
<% const assist = typeof adminAssist !== 'undefined' ? adminAssist : null; %>
<% const brandSchool = currentUser && (currentUser.school || (currentUser.teacher && currentUser.teacher.school)); %>
<% const brandOrg = currentUser && currentUser.organizationAdmin && currentUser.organizationAdmin.organization; %>
<% const showSchoolNav = (assist && assist.type === 'school') || (currentUser && currentUser.role === 'SCHOOL_ADMIN'); %>
<% const showGroupNav = (assist && assist.type === 'group') || (currentUser && currentUser.role === 'ORGANIZATION_ADMIN' && !showSchoolNav); %>
<% const navCycle = (typeof cycle !== 'undefined' && cycle && cycle.value) ? cycle : { value: 'COLLEGE', isPrimaire: false, isCollege: true, isLycee: false, isMixte: false, hasPrimaire: false, hasSecondaire: true, hasNationalExam: true, hasPalmares: true, hasLyceeSeries: false, hasNationalMatricule: true, deliberationsLabel: 'Délibérations', teacherCouncilLabel: 'Conseil de classe', convocationsLabel: 'Convocations (blanc + national)' }; %>
<aside class="app-sidebar" id="appSidebar">
  <div class="sidebar-toolbar">
    <button type="button" class="sidebar-close" id="sidebarClose" aria-label="Fermer le menu">Fermer</button>
  </div>
  <% if (brandOrg && showGroupNav) { %>
    <div class="sidebar-brand">
      <%- include('_logo', { logoUrl: brandOrg.logoUrl, logoBase64: brandOrg.logoBase64, slug: brandOrg.slug, name: brandOrg.name, size: 'sm' }) %>
      <span><%= brandOrg.name %></span>
    </div>
  <% } else if (brandSchool) { %>
    <div class="sidebar-brand">
      <%- include('_logo', { logoUrl: brandSchool.logoUrl, logoBase64: brandSchool.logoBase64, slug: brandSchool.slug, name: brandSchool.name, size: 'sm' }) %>
      <span><%= brandSchool.name %></span>
    </div>
  <% } %>
  <nav class="app-sidebar-nav">
    <% if (assist) { %>
      <a href="/admin/dashboard">Espace Super Admin</a>
      <a href="/admin/assist/exit">Quitter la prise en main</a>
    <% } %>
    <% if (showGroupNav) { %>
      <a href="/group/dashboard">Pilotage</a>
      <a href="/group/campuses">Campus</a>
      <a href="/group/finance">Finance</a>
      <a href="/group/hr">RH groupe</a>
      <a href="/group/compare">Comparatif</a>
      <a href="/group/circulars">Circulaires</a>
      <a href="/group/settings">Paramètres</a>
    <% } else if (showSchoolNav) { %>
      <a href="/school/dashboard">Accueil</a>

      <p class="nav-group-title">Administration scolaire</p>
      <a href="/school/classes">Classes</a>
      <a href="/school/students">Élèves</a>
      <a href="/school/teachers">Enseignants</a>
      <% if (on('hr')) { %><a href="/school/hr">RH</a><% } %>
      <a href="/school/school-year">Année scolaire</a>
      <a href="/transfer/requests">Transferts</a>
      <a href="/reinscription/dashboard">Réinscriptions</a>
      <a href="/school/settings">Paramètres</a>

      <p class="nav-group-title">Vie scolaire</p>
      <a href="/timetable">Emploi du temps</a>
      <% if (on('absences')) { %><a href="/school/justificatifs">Justificatifs</a><% } %>
      <% if (on('canteen')) { %><a href="/school/canteen">Cantine</a><% } %>
      <% if (on('lost_items')) { %><a href="/school/lost-items">Objets perdus</a><% } %>
      <% if (on('activities')) { %><a href="/school/activities">Activités</a><% } %>
      <% if (on('pickup')) { %><a href="/school/pickup">Sortie école</a><% } %>

      <p class="nav-group-title">Examens &amp; Évaluations</p>
      <% if (on('bulletins')) { %><a href="/school/bulletins">Bulletins</a><% } %>
      <a href="/school/coefficients">Coefficients</a>
      <a href="/school/emargements">Émargement</a>
      <% if (on('homeworks')) { %><a href="/school/homeworks">Devoirs & contrôles</a><% } %>
      <% if (navCycle.isMixte) { %>
        <p class="nav-cycle-label">Primaire</p>
        <% if (on('bulletins')) { %><a href="/school/deliberations">Évaluations</a><% } %>
        <a href="/school/convocations">Convocations (blanc)</a>
        <p class="nav-cycle-label">Secondaire</p>
        <% if (on('bulletins')) { %><a href="/school/deliberations">Délibérations</a><% } %>
        <% if (on('bulletins')) { %><a href="/school/palmares">Palmarès</a><% } %>
        <a href="/school/convocations">Convocations (blanc + national)</a>
      <% } else if (navCycle.hasPrimaire) { %>
        <% if (on('bulletins')) { %><a href="/school/deliberations">Évaluations</a><% } %>
        <a href="/school/convocations">Convocations (blanc)</a>
      <% } else { %>
        <% if (on('bulletins')) { %><a href="/school/deliberations">Délibérations</a><% } %>
        <% if (on('bulletins')) { %><a href="/school/palmares">Palmarès</a><% } %>
        <a href="/school/convocations">Convocations (blanc + national)</a>
      <% } %>

      <p class="nav-group-title">Finances &amp; Comptabilité</p>
      <a href="/school/fees">Frais</a>
      <% if (on('payments')) { %><a href="/school/payments">Paiements</a><% } %>
      <% if (on('payments')) { %><a href="/school/caisse">Caisse</a><% } %>
      <a href="/school/cas-sociaux">Cas sociaux</a>
      <% if (on('accounting')) { %><a href="/school/accounting">Comptabilité</a><% } %>

      <p class="nav-group-title">Communication</p>
      <% if (on('chat')) { %><a href="/school/messages">Messages</a><% } %>
      <% if (on('sms_official')) { %><a href="/school/sms">SMS officiels</a><% } %>

      <p class="nav-group-title">Rapports &amp; Statistiques</p>
      <a href="/school/analyse">Analyse</a>
      <a href="/school/risques">Risques</a>
      <% if (on('stats')) { %><a href="/school/stats">Statistiques</a><% } %>
    <% } else if (currentUser && currentUser.role === 'SUPER_ADMIN') { %>
      <a href="/admin/dashboard">Tableau de bord</a>
      <a href="/admin/plans">Plans</a>
      <a href="/admin/modules">Modules</a>
      <a href="/admin/organizations">Groupes</a>
      <a href="/admin/finance">Finance</a>
      <a href="/admin/accounting">Comptabilité</a>
      <a href="/admin/reporting">Graphiques d'analyse</a>
      <a href="/admin/group/redoublement">Redoublement groupe</a>
      <a href="/admin/audit">Audit</a>
      <a href="/transfer/dashboard">Transferts</a>
    <% } else if (currentUser && currentUser.role === 'PARENT') { %>
      <a href="/parent/dashboard">Accueil</a>
      <p class="nav-group-title">Finances &amp; Comptabilité</p>
      <% if (on('payments')) { %><a href="/parent/payments">Payer</a><% } %>
      <p class="nav-group-title">Examens &amp; Évaluations</p>
      <% if (on('grades')) { %><a href="/parent/grades">Notes</a><% } %>
      <a href="/parent/convocations">Convocations</a>
      <% if (on('homeworks')) { %><a href="/parent/homeworks">Devoirs & contrôles</a><% } %>
      <p class="nav-group-title">Vie scolaire</p>
      <% if (on('absences')) { %><a href="/parent/suivi">Suivi</a>
      <a href="/parent/justificatifs">Justificatifs</a><% } %>
      <% if (on('pickup')) { %><a href="/parent/pickup">Sortie école</a><% } %>
      <% if (on('transport')) { %><a href="/parent/transport">Transport</a><% } %>
      <% if (on('canteen')) { %><a href="/parent/canteen">Cantine</a><% } %>
      <% if (on('health')) { %><a href="/parent/health">Santé</a><% } %>
      <% if (on('activities')) { %><a href="/parent/activities">Activités</a><% } %>
      <p class="nav-group-title">Communication</p>
      <a href="/parent/timeline">Historique</a>
      <a href="/parent/notifications">Notifications<% if (typeof unreadNotifications !== 'undefined' && unreadNotifications > 0) { %> (<%= unreadNotifications %>)<% } %></a>
      <% if (on('chat')) { %><a href="/parent/messages">Messages</a><% } %>
      <p class="nav-group-title">Administration scolaire</p>
      <a href="/transfer">Transfert d'école</a>
      <a href="/parent/privacy">Confidentialité</a>
    <% } else if (currentUser && currentUser.role === 'TEACHER') { %>
      <a href="/teacher/dashboard">Accueil</a>
      <p class="nav-group-title">Administration scolaire</p>
      <a href="/teacher/notifications">Notifications<% if (typeof unreadNotifications !== 'undefined' && unreadNotifications > 0) { %> (<%= unreadNotifications %>)<% } %></a>
      <a href="/teacher/students">Élèves</a>
      <% if (on('hr')) { %><a href="/teacher/hr">Mon espace RH</a><% } %>
      <p class="nav-group-title">Vie scolaire</p>
      <% if (on('absences')) { %><a href="/teacher/attendance">Appel</a><% } %>
      <% if (on('transport')) { %><a href="/teacher/transport">Transport</a><% } %>
      <% if (on('canteen')) { %><a href="/teacher/canteen">Cantine</a><% } %>
      <% if (on('behavior')) { %><a href="/teacher/behavior">Comportement</a><% } %>
      <% if (on('health')) { %><a href="/teacher/health">Santé</a><% } %>
      <a href="/timetable">Emploi du temps</a>
      <p class="nav-group-title">Examens &amp; Évaluations</p>
      <% if (on('grades')) { %><a href="/teacher/bulk-grades">Notes</a><% } %>
      <% if (on('homeworks')) { %><a href="/teacher/homeworks">Devoirs & contrôles</a><% } %>
      <% if (navCycle.isMixte) { %>
        <p class="nav-cycle-label">Primaire</p>
        <% if (on('bulletins')) { %><a href="/teacher/deliberations">Évaluations</a><% } %>
        <p class="nav-cycle-label">Secondaire</p>
        <% if (on('bulletins')) { %><a href="/teacher/deliberations">Conseil de classe</a><% } %>
        <% if (on('bulletins')) { %><a href="/teacher/palmares">Palmarès</a><% } %>
      <% } else if (navCycle.hasPrimaire) { %>
        <% if (on('bulletins')) { %><a href="/teacher/deliberations">Évaluations</a><% } %>
      <% } else { %>
        <% if (on('bulletins')) { %><a href="/teacher/deliberations">Conseil de classe</a><% } %>
        <% if (on('bulletins')) { %><a href="/teacher/palmares">Palmarès</a><% } %>
      <% } %>
      <p class="nav-group-title">Communication</p>
      <% if (on('chat')) { %><a href="/teacher/messages">Messages</a><% } %>
      <p class="nav-group-title">Rapports &amp; Statistiques</p>
      <a href="/teacher/risques">Risques</a>
    <% } %>
  </nav>
</aside>
<div class="app-sidebar-overlay" id="sidebarOverlay" hidden></div>
