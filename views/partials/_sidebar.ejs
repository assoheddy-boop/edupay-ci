          <span class="nav-group-chevron" aria-hidden="true"></span>
        </button>
        <div class="nav-group-items" id="nav-items-vie-scolaire">
          <% if (can('classes:read')) { %><a href="/timetable">Emploi du temps</a><% } %>
          <% if (on('absences') && can('absences:write')) { %><a href="/school/justificatifs">Justificatifs</a><% } %>
          <% if (on('canteen') && can('canteen:write')) { %><a href="/school/canteen">Cantine</a><% } %>
          <% if (on('lost_items') && can('lost_items:write')) { %><a href="/school/lost-items">Objets perdus</a><% } %>
          <% if (on('activities') && can('activities:write')) { %><a href="/school/activities">Activités</a><% } %>
          <% if (on('pickup') && can('pickup:write')) { %><a href="/school/pickup">Sortie école</a><% } %>
        </div>
      </div>

      <div class="nav-group" data-nav-group="examens">
        <button type="button" class="nav-group-title" aria-expanded="false" aria-controls="nav-items-examens">
          Examens &amp; Évaluations<%- include('_helpKey', { key: 'nav.examens' }) %>
          <span class="nav-group-chevron" aria-hidden="true"></span>
        </button>
        <div class="nav-group-items" id="nav-items-examens">
          <% if (on('bulletins') && can('bulletins:read')) { %><a href="/school/bulletins">Bulletins</a><% } %>
          <% if (can('coefficients:write')) { %><a href="/school/coefficients">Coefficients</a><% } %>
          <% if (can('emargements:write')) { %><a href="/school/emargements">Émargement</a><% } %>
          <% if (on('homeworks') && can('classes:read')) { %><a href="/school/homeworks">Devoirs & contrôles</a><% } %>
          <% if (navCycle.isMixte) { %>
            <p class="nav-cycle-label">Primaire</p>
            <% if (on('bulletins') && can('deliberations:write')) { %><a href="/school/deliberations">Évaluations</a><% } %>
            <% if (can('convocations:write')) { %><a href="/school/convocations">Convocations (blanc)</a><% } %>
            <p class="nav-cycle-label">Secondaire</p>
            <% if (on('bulletins') && can('deliberations:write')) { %><a href="/school/deliberations">Délibérations</a><% } %>
            <% if (on('bulletins') && can('palmares:read')) { %><a href="/school/palmares">Palmarès</a><% } %>
            <% if (can('convocations:write')) { %><a href="/school/convocations">Convocations (blanc + national)</a><% } %>
          <% } else if (navCycle.hasPrimaire) { %>
            <% if (on('bulletins') && can('deliberations:write')) { %><a href="/school/deliberations">Évaluations</a><% } %>
            <% if (can('convocations:write')) { %><a href="/school/convocations">Convocations (blanc)</a><% } %>
          <% } else { %>
            <% if (on('bulletins') && can('deliberations:write')) { %><a href="/school/deliberations">Délibérations</a><% } %>
            <% if (on('bulletins') && can('palmares:read')) { %><a href="/school/palmares">Palmarès</a><% } %>
            <% if (can('convocations:write')) { %><a href="/school/convocations">Convocations (blanc + national)</a><% } %>
          <% } %>
        </div>
      </div>

      <div class="nav-group" data-nav-group="finances">
        <button type="button" class="nav-group-title" aria-expanded="false" aria-controls="nav-items-finances">
          Finances &amp; Comptabilité<%- include('_helpKey', { key: 'nav.finances' }) %>
          <span class="nav-group-chevron" aria-hidden="true"></span>
        </button>
        <div class="nav-group-items" id="nav-items-finances">
          <% if (can('fees:read')) { %><a href="/school/fees">Frais</a><% } %>
          <% if (on('payments') && can('payments:read')) { %><a href="/school/payments">Paiements</a><% } %>
          <% if (on('payments') && can('caisse:write')) { %><a href="/school/caisse">Caisse</a><% } %>
          <% if (can('social_cases:write')) { %><a href="/school/cas-sociaux">Cas sociaux</a><% } %>
          <% if (on('accounting') && can('accounting:read')) { %><a href="/school/accounting">Comptabilité</a><% } %>
        </div>
      </div>

      <div class="nav-group" data-nav-group="communication">
        <button type="button" class="nav-group-title" aria-expanded="false" aria-controls="nav-items-communication">
          Communication<%- include('_helpKey', { key: 'nav.communication' }) %>
          <span class="nav-group-chevron" aria-hidden="true"></span>
        </button>
        <div class="nav-group-items" id="nav-items-communication">
          <% if (on('chat') && can('messages:write')) { %><a href="/school/messages">Messages</a><% } %>
          <% if (on('sms_official') && can('sms:write')) { %><a href="/school/sms">SMS officiels</a><% } %>
        </div>
      </div>

      <div class="nav-group" data-nav-group="rapports">
        <button type="button" class="nav-group-title" aria-expanded="false" aria-controls="nav-items-rapports">
          Rapports &amp; Statistiques<%- include('_helpKey', { key: 'nav.rapports' }) %>
          <span class="nav-group-chevron" aria-hidden="true"></span>
        </button>
        <div class="nav-group-items" id="nav-items-rapports">
          <% if (can('stats:read')) { %><a href="/school/analyse">Analyse</a><% } %>
          <% if (can('stats:read')) { %><a href="/school/risques">Risques</a><% } %>
          <% if (on('stats') && can('stats:read')) { %><a href="/school/stats">Statistiques</a><% } %>
        </div>
      </div>
    <% } else if (currentUser && currentUser.role === 'SUPER_ADMIN') { %>
      <a href="/admin/dashboard">Tableau de bord</a>
      <a href="/admin/schools">Écoles</a>
      <a href="/admin/organizations">Groupes scolaires</a>
      <a href="/admin/users">Utilisateurs</a>
      <a href="/admin/quotes">Devis</a>
      <a href="/admin/marketplace">Portail public</a>
      <a href="/admin/dashboard#sms-test">SMS / notifications</a>
      <a href="/admin/modules">Modules</a>
      <a href="/admin/plans">Plans</a>
      <a href="/admin/finance">Finance</a>
      <a href="/admin/accounting">Comptabilité</a>
      <a href="/admin/reporting">Graphiques d'analyse</a>
      <a href="/admin/group/redoublement">Redoublement groupe</a>
      <a href="/admin/audit">Audit</a>
      <a href="/transfer/dashboard">Transferts</a>
    <% } else if (currentUser && currentUser.role === 'PARENT') { %>
      <a href="/parent/dashboard">Accueil</a>
      <div class="nav-group" data-nav-group="finances">
        <button type="button" class="nav-group-title" aria-expanded="false" aria-controls="nav-items-finances">
          Finances &amp; Comptabilité
          <span class="nav-group-chevron" aria-hidden="true"></span>
        </button>
        <div class="nav-group-items" id="nav-items-finances">
          <% if (on('payments')) { %><a href="/parent/payments">Payer</a><% } %>
        </div>
      </div>
      <div class="nav-group" data-nav-group="examens">
        <button type="button" class="nav-group-title" aria-expanded="false" aria-controls="nav-items-examens">
          Examens &amp; Évaluations
          <span class="nav-group-chevron" aria-hidden="true"></span>
        </button>
        <div class="nav-group-items" id="nav-items-examens">
          <% if (on('grades')) { %><a href="/parent/grades">Notes</a><% } %>
          <a href="/parent/convocations">Convocations</a>
          <% if (on('homeworks')) { %><a href="/parent/homeworks">Devoirs & contrôles</a><% } %>
        </div>
      </div>
      <div class="nav-group" data-nav-group="vie-scolaire">
        <button type="button" class="nav-group-title" aria-expanded="false" aria-controls="nav-items-vie-scolaire">
          Vie scolaire
          <span class="nav-group-chevron" aria-hidden="true"></span>
        </button>
        <div class="nav-group-items" id="nav-items-vie-scolaire">
          <% if (on('absences')) { %><a href="/parent/suivi">Suivi</a>
          <a href="/parent/justificatifs">Justificatifs</a><% } %>
          <% if (on('pickup')) { %><a href="/parent/pickup">Sortie école</a><% } %>
          <% if (on('transport')) { %><a href="/parent/transport">Transport</a><% } %>
          <% if (on('canteen')) { %><a href="/parent/canteen">Cantine</a><% } %>
          <% if (on('health')) { %><a href="/parent/health">Santé</a><% } %>
          <% if (on('activities')) { %><a href="/parent/activities">Activités</a><% } %>
        </div>
      </div>
      <div class="nav-group" data-nav-group="communication">
        <button type="button" class="nav-group-title" aria-expanded="false" aria-controls="nav-items-communication">
          Communication
          <span class="nav-group-chevron" aria-hidden="true"></span>
        </button>
        <div class="nav-group-items" id="nav-items-communication">
          <a href="/parent/timeline">Historique</a>
          <a href="/parent/notifications">Notifications<% if (typeof unreadNotifications !== 'undefined' && unreadNotifications > 0) { %> (<%= unreadNotifications %>)<% } %></a>
          <% if (on('chat')) { %><a href="/parent/messages">Messages</a><% } %>
        </div>
      </div>
      <div class="nav-group" data-nav-group="administration-scolaire">
        <button type="button" class="nav-group-title" aria-expanded="false" aria-controls="nav-items-administration-scolaire">
          Administration scolaire
          <span class="nav-group-chevron" aria-hidden="true"></span>
        </button>
        <div class="nav-group-items" id="nav-items-administration-scolaire">
          <a href="/transfer">Transfert d'école</a>
          <a href="/parent/privacy">Confidentialité</a>
        </div>
      </div>
    <% } else if (currentUser && currentUser.role === 'STUDENT') { %>
      <% const brandStudentSchool = currentUser.student && currentUser.student.class && currentUser.student.class.school; %>
      <% if (brandStudentSchool) { %>
        <div class="sidebar-brand">
          <%- include('_logo', { logoUrl: brandStudentSchool.logoUrl, logoBase64: brandStudentSchool.logoBase64, slug: brandStudentSchool.slug, name: brandStudentSchool.name, size: 'sm' }) %>
          <span><%= brandStudentSchool.name %></span>
        </div>
      <% } %>
      <a href="/student/dashboard">Accueil</a>
      <a href="/student/timetable">Emploi du temps</a>
      <% if (on('grades')) { %><a href="/student/grades">Notes & bulletins</a><% } %>
      <% if (on('homeworks')) { %><a href="/student/homeworks">Devoirs & contrôles</a><% } %>
    <% } else if (currentUser && currentUser.role === 'TEACHER') { %>
      <a href="/teacher/dashboard">Accueil</a>
      <div class="nav-group" data-nav-group="administration-scolaire">
        <button type="button" class="nav-group-title" aria-expanded="false" aria-controls="nav-items-administration-scolaire">
          Administration scolaire
          <span class="nav-group-chevron" aria-hidden="true"></span>
        </button>
        <div class="nav-group-items" id="nav-items-administration-scolaire">
          <a href="/teacher/notifications">Notifications<% if (typeof unreadNotifications !== 'undefined' && unreadNotifications > 0) { %> (<%= unreadNotifications %>)<% } %></a>
          <a href="/teacher/students">Élèves</a>
          <% if (on('hr')) { %><a href="/teacher/hr">Mon espace RH</a><% } %>
        </div>
      </div>
      <div class="nav-group" data-nav-group="vie-scolaire">
        <button type="button" class="nav-group-title" aria-expanded="false" aria-controls="nav-items-vie-scolaire">
          Vie scolaire
          <span class="nav-group-chevron" aria-hidden="true"></span>
        </button>
        <div class="nav-group-items" id="nav-items-vie-scolaire">
          <% if (on('absences')) { %><a href="/teacher/attendance">Appel</a><% } %>
          <% if (on('transport')) { %><a href="/teacher/transport">Transport</a><% } %>
          <% if (on('canteen')) { %><a href="/teacher/canteen">Cantine</a><% } %>
          <% if (on('behavior')) { %><a href="/teacher/behavior">Comportement</a><% } %>
          <% if (on('health')) { %><a href="/teacher/health">Santé</a><% } %>
          <a href="/timetable">Emploi du temps</a>
        </div>
      </div>
      <div class="nav-group" data-nav-group="examens">
        <button type="button" class="nav-group-title" aria-expanded="false" aria-controls="nav-items-examens">
          Examens &amp; Évaluations
          <span class="nav-group-chevron" aria-hidden="true"></span>
        </button>
        <div class="nav-group-items" id="nav-items-examens">
          <% if (on('grades')) { %><a href="/teacher/bulk-grades">Notes</a><% } %>
          <% if (on('homeworks')) { %><a href="/teacher/homeworks">Devoirs & contrôles</a><% } %>
          <% if (navCycle.isMixte) { %>
            <p class="nav-cycle-label">Primaire</p>
            <% if (on('bulletins')) { %><a href="/teacher/deliberations">Évaluations</a><% } %>
            <p class="nav-cycle-label">Secondaire</p>
            <% if (on('bulletins')) { %><a href="/teacher/deliberations">Conseil de classe</a><% } %>
            <% if (on('bulletins')) { %><a href="/teacher/palmares">Palmarès</a><% } %>
          <% } else if (navCycle.hasPrimaire) { %>
            <% if (on('bulletins')) { %><a href="/teacher/deliberations">Évaluations</a><% } %>
          <% } else { %>
            <% if (on('bulletins')) { %><a href="/teacher/deliberations">Conseil de classe</a><% } %>
            <% if (on('bulletins')) { %><a href="/teacher/palmares">Palmarès</a><% } %>
          <% } %>
        </div>
      </div>
      <div class="nav-group" data-nav-group="communication">
        <button type="button" class="nav-group-title" aria-expanded="false" aria-controls="nav-items-communication">
          Communication
          <span class="nav-group-chevron" aria-hidden="true"></span>
        </button>
        <div class="nav-group-items" id="nav-items-communication">
          <% if (on('chat')) { %><a href="/teacher/messages">Messages</a><% } %>
        </div>
      </div>
      <div class="nav-group" data-nav-group="rapports">
        <button type="button" class="nav-group-title" aria-expanded="false" aria-controls="nav-items-rapports">
          Rapports &amp; Statistiques
          <span class="nav-group-chevron" aria-hidden="true"></span>
        </button>
        <div class="nav-group-items" id="nav-items-rapports">
          <a href="/teacher/risques">Risques</a>
        </div>
      </div>
    <% } %>
  </nav>
</aside>
<div class="app-sidebar-overlay" id="sidebarOverlay" hidden></div>
