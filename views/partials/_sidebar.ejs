          Administration scolaire<%- include('_helpKey', { key: 'nav.administration' }) %>
          <span class="nav-group-chevron" aria-hidden="true"></span>
        </button>
        <div class="nav-group-items" id="nav-items-administration-scolaire">
          <% if (can('classes:read')) { %><a href="/school/classes">Classes</a><% } %>
          <% if (can('students:read')) { %><a href="/school/students">Élèves</a><% } %>
          <% if (can('teachers:read')) { %><a href="/school/teachers">Enseignants</a><% } %>
          <% if (on('hr') && can('hr:read')) { %><a href="/school/hr">RH</a><% } %>
          <% if (can('school_year:write')) { %><a href="/school/school-year">Année scolaire</a><% } %>
          <% if (can('enrollments:read')) { %><a href="/transfer/requests">Transferts</a><% } %>
          <% if (can('enrollments:read')) { %><a href="/school/inscriptions">Fiches inscription</a><% } %>
          <% if (can('enrollments:read')) { %><a href="/reinscription/dashboard">Réinscriptions</a><% } %>
          <% if (can('settings:read')) { %><a href="/school/settings">Paramètres</a><% } %>
          <% if (can('settings:write')) { %><a href="/school/staff-roles">Rôles staff</a><% } %>
          <% if (on('marketplace') && can('portal:write')) { %><a href="/school/portail">Portail public</a><% } %>
        </div>
      </div>

      <div class="nav-group" data-nav-group="vie-scolaire">
        <button type="button" class="nav-group-title" aria-expanded="false" aria-controls="nav-items-vie-scolaire">
