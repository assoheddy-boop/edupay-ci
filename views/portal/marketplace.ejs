<%- include('../partials/head') %>
<div class="portal">
  <header class="portal-top">
    <a href="/" class="portal-brand">Edu<strong>Connect</strong></a>
    <nav class="portal-nav portal-nav-desktop" aria-label="Navigation">
      <a href="/ecoles">Écoles</a>
      <a href="/auth/login">Connexion</a>
      <a href="/devis">Devis</a>
    </nav>
    <details class="portal-burger">
      <summary aria-label="Ouvrir le menu">Menu</summary>
      <nav class="portal-nav" aria-label="Menu mobile">
        <a href="/ecoles">Écoles</a>
        <a href="/auth/login">Connexion</a>
        <a href="/devis">Devis</a>
      </nav>
    </details>
  </header>

  <section class="portal-hero portal-hero-market">
    <div>
      <p class="portal-kicker">Côte d’Ivoire · EduConnect</p>
      <h1>Trouver une école</h1>
      <p class="portal-lead">Annuaire des établissements qui ont publié leur page. Les notes, bulletins et classements restent dans l’espace parent.</p>
    </div>
  </section>

  <form class="card portal-filters" method="GET" action="/ecoles">
    <div class="form-row">
      <div class="form-group">
        <label for="ville">Ville</label>
        <input type="text" id="ville" name="ville" value="<%= ville %>" placeholder="Abidjan, Bouaké…">
      </div>
      <div class="form-group">
        <label for="cycle">Cycle</label>
        <select id="cycle" name="cycle">
          <option value="">Tous</option>
          <% cycleOptions.forEach(function(opt) { %>
            <option value="<%= opt.value %>" <%= cycle === opt.value ? 'selected' : '' %>><%= opt.label %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label for="type">Type</label>
        <select id="type" name="type">
          <option value="">Tous</option>
          <% (typeof typeOptions !== 'undefined' ? typeOptions : []).forEach(function(opt) { %>
            <option value="<%= opt.value %>" <%= type === opt.value ? 'selected' : '' %>><%= opt.label %></option>
          <% }) %>
        </select>
      </div>
    </div>
    <button type="submit" class="btn btn-primary">Rechercher</button>
  </form>

  <% if (!schools.length) { %>
    <div class="card portal-card">
      <p>Aucune école publiée pour ces critères. La visibilité sur /ecoles fait partie de l’option Marketplace. Contactez EduConnect pour activer une page publique.</p>
    </div>
  <% } else { %>
    <ul class="portal-list">
      <% schools.forEach(function(s) { %>
        <li>
          <a class="card portal-school-link<%= s.marketplaceBadge ? ' is-featured' : '' %><%= s.marketplaceBadge ? ' ' + s.marketplaceBadge.className : '' %>" href="<%= s.portalPath %>">
            <%- include('../partials/_logo', { logoUrl: s.logoUrl, logoBase64: s.logoBase64, slug: s.slug, name: s.name, size: 'md' }) %>
            <span>
              <% if (s.marketplaceBadge) { %><span class="portal-featured-badge <%= s.marketplaceBadge.className %>"><%= s.marketplaceBadge.label %></span><% } %>
              <strong><%= s.name %></strong>
              <span class="portal-school-meta"><%= s.city %> · <%= s.cycleLabel %> · <%= s.typeLabel %></span>
            </span>
          </a>
        </li>
      <% }) %>
    </ul>
  <% } %>
</div>
<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
