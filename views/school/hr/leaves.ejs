<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('leaves', { _inLayout: true }); %>
<%- include('../../layouts/schoolLayout', { body: content, title: 'RH — Congés' }) %>
<% } else { %>
<div class="page-header">
    <h1>Congés personnel</h1>
    <a href="/school/hr/export/leaves" class="btn btn-outline btn-sm">Export Excel</a>
  </div>
  <%- include('_nav') %>
  <% if (success) { %><div class="alert alert-success">Demande traitée.</div><% } %>

  <div class="card">
    <table class="table">
      <thead><tr><th>Enseignant</th><th>Type</th><th>Période</th><th>Motif</th><th>Statut</th><th></th></tr></thead>
      <tbody>
        <% leaves.forEach(function(l) { %>
          <tr>
            <td><%= l.teacher.user.lastName %> <%= l.teacher.user.firstName %></td>
            <td><%= l.type %></td>
            <td><%= new Date(l.startDate).toLocaleDateString('fr-FR') %> → <%= new Date(l.endDate).toLocaleDateString('fr-FR') %></td>
            <td><%= l.reason || '—' %></td>
            <td><span class="badge"><%= l.status %></span></td>
            <td>
              <% if (l.status === 'PENDING') { %>
                <form method="POST" action="/school/hr/leaves/<%= l.id %>/review" class="inline-form">
                  <input type="hidden" name="action" value="approve">
                  <button type="submit" class="btn btn-sm btn-primary">Approuver</button>
                </form>
                <form method="POST" action="/school/hr/leaves/<%= l.id %>/review" class="inline-form">
                  <input type="hidden" name="action" value="reject">
                  <button type="submit" class="btn btn-sm btn-outline">Refuser</button>
                </form>
              <% } else { %>—<% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
