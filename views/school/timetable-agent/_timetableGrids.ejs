<%
  const grids = typeof timetableGrids !== 'undefined' ? timetableGrids : null;
  const initialMode = typeof gridViewMode !== 'undefined' ? gridViewMode : 'class';
  const uid = typeof gridUid !== 'undefined' ? gridUid : 'ta-grid';
  const classBlocks = grids?.byClass || [];
  const teacherBlocks = grids?.byTeacher || [];
%>
<% if (!grids || !grids.hasData) { %>
  <div class="alert alert-warning">
    <strong>Données insuffisantes</strong> — la génération n'a produit aucun créneau.
  </div>
<% } else { %>
  <div class="edt-view-toolbar" id="<%= uid %>-toolbar" data-grid-root="<%= uid %>">
    <div class="edt-view-tabs" role="tablist" aria-label="Mode d'affichage">
      <button type="button" class="edt-view-tab <%= initialMode === 'class' ? 'active' : '' %>" data-mode="class" aria-selected="<%= initialMode === 'class' ? 'true' : 'false' %>">Par classe</button>
      <button type="button" class="edt-view-tab <%= initialMode === 'teacher' ? 'active' : '' %>" data-mode="teacher" aria-selected="<%= initialMode === 'teacher' ? 'true' : 'false' %>">Par professeur</button>
    </div>
    <label class="edt-view-select edt-view-select-class" style="<%= initialMode === 'teacher' ? 'display:none' : '' %>">
      <span class="sr-only">Choisir une classe</span>
      <select class="edt-block-select" data-mode="class" aria-label="Choisir une classe">
        <% classBlocks.forEach((bloc, i) => { %>
          <option value="<%= i %>" <%= i === 0 ? 'selected' : '' %>><%= bloc.label %></option>
        <% }) %>
      </select>
    </label>
    <label class="edt-view-select edt-view-select-teacher" style="<%= initialMode !== 'teacher' ? 'display:none' : '' %>">
      <span class="sr-only">Choisir un professeur</span>
      <select class="edt-block-select" data-mode="teacher" aria-label="Choisir un professeur">
        <% teacherBlocks.forEach((bloc, i) => { %>
          <option value="<%= i %>" <%= i === 0 ? 'selected' : '' %>><%= bloc.label %></option>
        <% }) %>
      </select>
    </label>
  </div>

  <div class="edt-grids-root" id="<%= uid %>" data-initial-mode="<%= initialMode %>">
    <% [
      { mode: 'class', blocks: classBlocks, entityLabel: 'Classe' },
      { mode: 'teacher', blocks: teacherBlocks, entityLabel: 'Professeur' },
    ].forEach(({ mode, blocks, entityLabel }) => { %>
      <div class="edt-grids-mode <%= mode === initialMode ? 'active' : '' %>" data-mode="<%= mode %>">
        <% if (!blocks.length) { %>
          <div class="alert alert-info">Aucun emploi du temps <%= mode === 'teacher' ? 'par professeur' : 'par classe' %>.</div>
        <% } %>
        <% blocks.forEach((bloc, bi) => { %>
          <section class="edt-timetable-section <%= bi === 0 ? 'active' : '' %>" data-block-index="<%= bi %>" aria-label="Emploi du temps — <%= bloc.label %>">
            <header class="edt-timetable-header">
              <h3 class="edt-timetable-title"><%= entityLabel %> : <strong><%= bloc.label %></strong></h3>
              <p class="edt-timetable-meta"><%= bloc.slotCount %> créneau(x) · <%= bloc.days.length %> jour(s)</p>
            </header>
            <div class="edt-timetable-wrap">
              <table class="edt-grid">
                <thead>
                  <tr>
                    <th class="edt-col-corner" scope="col"><span class="sr-only">Heure</span></th>
                    <% bloc.days.forEach(day => { %>
                      <th scope="col"><%= day %></th>
                    <% }) %>
                  </tr>
                </thead>
                <tbody>
                  <% if (!bloc.timeSlots.length) { %>
                    <tr><td colspan="<%= bloc.days.length + 1 %>" class="edt-empty-cell">Aucun créneau</td></tr>
                  <% } else {
                    bloc.timeSlots.forEach((timeKey, rowIdx) => { %>
                    <tr class="<%= rowIdx % 2 === 0 ? 'edt-row-even' : 'edt-row-odd' %>">
                      <th class="edt-col-time" scope="row"><%= timeKey %></th>
                      <% bloc.days.forEach(day => {
                        const cell = bloc.cells[`${timeKey}|${day}`];
                      %>
                        <td class="edt-cell <%= cell ? 'edt-cell-filled edt-subject-' + cell.colorIndex : 'edt-cell-empty' %>">
                          <% if (cell) { %>
                            <div class="edt-cell-matiere"><%= cell.matiere %></div>
                            <% if (mode === 'teacher' && cell.classe) { %>
                              <div class="edt-cell-classe"><%= cell.classe %></div>
                            <% } else if (cell.professeur) { %>
                              <div class="edt-cell-prof">Prof. <%= cell.professeur %></div>
                            <% } %>
                            <% if (cell.salle) { %>
                              <div class="edt-cell-salle"><%= cell.salle %></div>
                            <% } %>
                          <% } else { %>
                            <span class="edt-cell-dash">—</span>
                          <% } %>
                        </td>
                      <% }) %>
                    </tr>
                  <% }) } %>
                </tbody>
              </table>
            </div>
          </section>
        <% }) %>
      </div>
    <% }) %>
  </div>

  <% if (typeof showJsonExport !== 'undefined' && showJsonExport && typeof output !== 'undefined' && output) { %>
    <details class="ta-json-export">
      <summary>Export JSON (technique)</summary>
      <div class="ta-json-actions">
        <a href="#" class="btn btn-outline btn-sm ta-json-download" data-filename="emploi-du-temps-<%= session?.id || 'export' %>.json">Télécharger JSON</a>
      </div>
      <pre class="ta-json-pre"><%= JSON.stringify(output, null, 2) %></pre>
      <script type="application/json" class="ta-json-data"><%- safeJson(output) %></script>
    </details>
  <% } %>
<% } %>

<script>
(function () {
  function initTimetableGrids(rootId) {
    const root = document.getElementById(rootId);
    if (!root) return;
    const toolbar = document.querySelector('[data-grid-root="' + rootId + '"]');
    if (!toolbar) return;

    const tabs = [...toolbar.querySelectorAll('.edt-view-tab')];
    const modeContainers = [...root.querySelectorAll('.edt-grids-mode')];
    const classSelectWrap = toolbar.querySelector('.edt-view-select-class');
    const teacherSelectWrap = toolbar.querySelector('.edt-view-select-teacher');
    const selects = [...toolbar.querySelectorAll('.edt-block-select')];

    function showBlock(mode, index) {
      const container = root.querySelector('.edt-grids-mode[data-mode="' + mode + '"]');
      if (!container) return;
      container.querySelectorAll('.edt-timetable-section').forEach((sec, i) => {
        sec.classList.toggle('active', i === index);
      });
    }

    function setMode(mode) {
      modeContainers.forEach((c) => c.classList.toggle('active', c.getAttribute('data-mode') === mode));
      tabs.forEach((t) => {
        const active = t.getAttribute('data-mode') === mode;
        t.classList.toggle('active', active);
        t.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      if (classSelectWrap) classSelectWrap.style.display = mode === 'class' ? '' : 'none';
      if (teacherSelectWrap) teacherSelectWrap.style.display = mode === 'teacher' ? '' : 'none';
      const sel = toolbar.querySelector('.edt-block-select[data-mode="' + mode + '"]');
      if (sel) showBlock(mode, Number(sel.value) || 0);
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => setMode(tab.getAttribute('data-mode')));
    });

    selects.forEach((sel) => {
      sel.addEventListener('change', () => showBlock(sel.getAttribute('data-mode'), Number(sel.value)));
    });

    setMode(root.getAttribute('data-initial-mode') || 'class');
  }

  initTimetableGrids('<%= uid %>');

  const downloadBtn = document.querySelector('#<%= uid %>')?.closest('.edt-grids-root')?.parentElement?.querySelector('.ta-json-download');
  const jsonEl = document.querySelector('#<%= uid %>')?.closest('.edt-grids-root')?.parentElement?.querySelector('.ta-json-data');
  if (downloadBtn && jsonEl) {
    downloadBtn.addEventListener('click', (e) => {
      e.preventDefault();
      const blob = new Blob([jsonEl.textContent], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = downloadBtn.getAttribute('data-filename') || 'emploi-du-temps.json';
      a.click();
      URL.revokeObjectURL(url);
    });
  }
})();
</script>
