<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('classes', { _inLayout: true }); %>
<%- include('../layouts/schoolLayout', { body: content, title: 'Classes' }) %>
<% } else { %>
<div class="page-header"><h1>Classes</h1></div>

  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <% if (success) { %><div class="alert alert-success">Opération réussie.</div><% } %>



  <div class="grid-2">

    <div class="card">

      <h2>Ajouter une classe</h2>

      <form method="POST" action="/school/classes" class="form" data-offline-queue="class">

        <div class="form-group">

          <label for="name">Nom</label>

          <input type="text" id="name" name="name" required placeholder="Ex: CM2 A">

        </div>

        <div class="form-group">

          <label for="level">Niveau</label>

          <input type="text" id="level" name="level" required placeholder="Ex: CM2">

        </div>

        <div class="form-group">

          <label for="schoolYear">Année scolaire</label>

          <input type="text" id="schoolYear" name="schoolYear" value="<%= school.currentSchoolYear || '2025-2026' %>">

        </div>

        <% if (typeof cycle === 'undefined' || cycle.hasLyceeSeries) { %>
        <div class="form-group">
          <label for="series">Série (lycée)</label>
          <select id="series" name="series">
            <option value="">Collège (aucune)</option>
            <% (typeof seriesOptions !== 'undefined' ? seriesOptions : []).forEach(function(opt) { %>
              <option value="<%= opt.value %>"><%= opt.label %></option>
            <% }) %>
          </select>
          <p class="form-hint">Lycée A / C / D : tous les élèves héritent. Collège : laissez vide.</p>
        </div>
        <% } %>

        <button type="submit" class="btn btn-primary">Créer</button>

      </form>

    </div>



    <div class="card">

      <h2>Liste des classes</h2>

      <% if (classes.length === 0) { %>

        <p class="empty">Aucune classe créée.</p>

      <% } else { %>

        <% classes.forEach(c => { %>

          <details class="edit-row">

            <summary><strong><%= c.name %></strong> — <%= c.level %><% if (c.series && typeof seriesLabel === 'function') { %> · <%= seriesLabel(c.series) %><% } else if (c.series) { %> · Série <%= c.series %><% } %> (<%= c._count.students %> élève(s))</summary>

            <form method="POST" action="/school/classes/<%= c.id %>/update" class="form" style="margin-top:0.75rem" data-offline-skip="1">

              <div class="form-row">

                <div class="form-group"><label>Nom</label><input type="text" name="name" value="<%= c.name %>" required></div>

                <div class="form-group"><label>Niveau</label><input type="text" name="level" value="<%= c.level %>" required></div>

              </div>

              <div class="form-group"><label>Année</label><input type="text" name="schoolYear" value="<%= c.schoolYear %>"></div>

              <% if (typeof cycle === 'undefined' || cycle.hasLyceeSeries) { %>
              <div class="form-group">
                <label>Série (lycée)</label>
                <select name="series">
                  <option value="" <%= !c.series ? 'selected' : '' %>>Collège (aucune)</option>
                  <% (typeof seriesOptions !== 'undefined' ? seriesOptions : []).forEach(function(opt) { %>
                    <option value="<%= opt.value %>" <%= c.series === opt.value ? 'selected' : '' %>><%= opt.label %></option>
                  <% }) %>
                </select>
              </div>
              <% } %>

              <button type="submit" class="btn btn-primary btn-sm">Enregistrer</button>

            </form>

            <p style="margin-top:0.5rem">
              <a href="/school/classes/<%= c.id %>/dashboard" class="btn btn-outline btn-sm">Stats filles/garçons</a>
              <a href="/school/emargements?classId=<%= c.id %>" class="btn btn-outline btn-sm">Émargement</a>
              <a href="/school/convocations?classId=<%= c.id %>" class="btn btn-outline btn-sm">Convocations</a>
            </p>

            <% if (c._count.students === 0) { %>

              <form method="POST" action="/school/classes/<%= c.id %>/delete" style="margin-top:0.5rem" onsubmit="return confirm('Supprimer cette classe ?')">

                <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>

              </form>

            <% } %>

          </details>

        <% }) %>

      <% } %>

    </div>

  </div>
<% } %>
