<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('module-disabled', { _inLayout: true }); %>
<%- include('../layouts/schoolLayout', { body: content, title: 'Module désactivé' }) %>
<% } else { %>
<div class="card" style="max-width:520px;margin:2rem auto;text-align:center">
    <% if (typeof upgrade !== 'undefined' && upgrade) { %>
    <h1>Module Pro</h1>
    <p><%= typeof upgradeMessage !== 'undefined' ? upgradeMessage : 'Inclus dans l\'offre Pro, activé par EduConnect.' %></p>
    <p class="text-muted">Ce module fait partie d'EduConnect Pro. Contactez EduConnect pour l'activer.</p>
    <div style="display:flex;gap:0.5rem;justify-content:center;flex-wrap:wrap;margin-top:1rem">
      <a href="/devis" class="btn btn-primary">Voir l'offre Pro</a>
      <a href="/school/dashboard" class="btn btn-outline">Retour au tableau de bord</a>
    </div>
    <% } else { %>
    <h1>Module non disponible</h1>
    <p>Le module <strong><%= moduleLabel %></strong> n'est pas activé pour votre établissement.</p>
    <p class="text-muted">Contactez l'administration de l'école ou EduConnect pour l'activer.</p>
    <a href="/school/dashboard" class="btn btn-primary">Retour au tableau de bord</a>
    <% } %>
  </div>
<% } %>
