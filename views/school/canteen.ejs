<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('canteen', { _inLayout: true }); %>
<%- include('../layouts/schoolLayout', { body: content, title: 'Cantine' }) %>
<% } else { %>
<div class="page-header"><h1>🍽️ Menus cantine</h1></div>
  <% if (success) { %><div class="alert alert-success">Menu ajouté.</div><% } %>

  <div class="grid-2">
    <div class="card">
      <form method="POST" action="/school/canteen" class="form">
        <div class="form-group">
          <label>Date</label>
          <input type="date" name="date" required>
        </div>
        <div class="form-group">
          <label>Menu du jour</label>
          <textarea name="menu" rows="4" required placeholder="Ex: Riz sauce arachide, banane, jus…"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Publier le menu</button>
      </form>
    </div>
    <div class="card">
      <h2>Menus publiés</h2>
      <% if (menus.length === 0) { %><p class="empty">Aucun menu.</p><% } else { %>
        <ul class="list">
          <% menus.forEach(m => { %>
            <li class="list-item">
              <strong><%= new Date(m.date).toLocaleDateString('fr-FR') %></strong>
              <span><%= m.menu %></span>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </div>
<% } %>
