<%- include('../partials/head', { title: 'Modules' }) %>
<%- include('../partials/header', { user }) %>
<main class="container">
  <div class="page-header">
    <div>
      <h1>Modules activés</h1>
      <p class="page-sub">Fonctionnalités disponibles pour <%= school.name %></p>
    </div>
    <a href="/school/dashboard" class="btn btn-outline">Retour</a>
  </div>

  <% if (success) { %><div class="alert alert-success">Paramètres enregistrés.</div><% } %>

  <form method="POST" action="/school/modules" class="card">
    <div class="card-header">
      <h2>Vos modules</h2>
      <p class="page-sub">Les modules verrouillés par l'administrateur ne peuvent pas être modifiés.</p>
    </div>
    <table class="table">
      <thead>
        <tr><th>Module</th><th>Description</th><th>Statut</th></tr>
      </thead>
      <tbody>
        <% MODULE_KEYS.forEach(function(key) {
          const mod = modules[key];
        %>
          <tr>
            <td><strong><%= mod.label %></strong></td>
            <td><%= mod.description %></td>
            <td>
              <% if (mod.locked) { %>
                <span class="badge"><%= mod.enabled ? 'Activé' : 'Désactivé' %> (verrouillé)</span>
              <% } else { %>
                <label class="checkbox-label">
                  <input type="checkbox" name="mod_<%= key %>" <%= mod.enabled ? 'checked' : '' %>>
                  Activé
                </label>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    <div class="card-footer">
      <button type="submit" class="btn btn-primary">Enregistrer</button>
    </div>
  </form>
</main>
<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
