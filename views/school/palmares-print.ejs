<% const label = typeof formatTermLabel === 'function' ? formatTermLabel(term) : term; %>
<% const classTitle = allClasses ? 'Toutes les classes' : (groups[0] && groups[0].class ? groups[0].class.name : ''); %>
<% const backHref = (typeof basePath !== 'undefined' ? basePath : '/school/palmares') + (qs ? '?' + qs : ''); %>
<% const pdfHref = (typeof pdfPath !== 'undefined' ? pdfPath : '/school/palmares.pdf') + (qs ? '?' + qs : ''); %>
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Tableau d’honneur — EduConnect</title>
  <link rel="stylesheet" href="/css/main.css?v=9">
  <style>
    .pv-page { max-width: 52rem; margin: 1.25rem auto; padding: 0 1rem 2rem; }
    .pv-head { text-align: center; margin-bottom: 1rem; }
    .pv-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin-bottom: 1rem; }
    .pv-meta { text-align: center; color: #666; margin-bottom: 1rem; }
    .pv-brand { text-align: center; margin-top: 1.5rem; font-size: 0.85rem; color: #666; }
    @media print {
      .pv-actions, .app-navbar, .app-sidebar { display: none !important; }
      body { background: #fff; }
    }
  </style>
</head>
<body>
<main class="pv-page">
  <div class="pv-actions">
    <button type="button" class="btn btn-primary" onclick="window.print()">Imprimer</button>
    <a class="btn btn-outline" href="<%= pdfHref %>">PDF</a>
    <a class="btn btn-outline" href="<%= backHref %>">Retour</a>
  </div>
  <header class="pv-head">
    <%- include('../partials/_logo', { logoUrl: school.logoUrl, logoBase64: school.logoBase64, slug: school.slug, name: school.name, size: 'md' }) %>
    <h1><%= school.name %></h1>
    <p class="page-sub">Tableau d’honneur</p>
  </header>
  <p class="pv-meta"><strong><%= classTitle %></strong> · <%= label %> · <%= schoolYear || '' %></p>
  <% groups.forEach(function(group) { %>
    <% if (allClasses || groups.length > 1) { %>
      <h2><%= group.class.name %></h2>
    <% } %>
    <% if (byGender) { %>
      <h3>Filles</h3>
      <%- include('../partials/_palmares-table', { rows: group.girls, hasSeries: hasSeries || group.hasSeries, empty: 'Aucune fille avec des notes sur cette période.' }) %>
      <h3>Garçons</h3>
      <%- include('../partials/_palmares-table', { rows: group.boys, hasSeries: hasSeries || group.hasSeries, empty: 'Aucun garçon avec des notes sur cette période.' }) %>
    <% } else { %>
      <%- include('../partials/_palmares-table', { rows: group.rows, hasSeries: hasSeries || group.hasSeries, empty: 'Aucun élève avec des notes sur cette période.' }) %>
    <% } %>
  <% }) %>
  <p class="pv-brand">EduConnect</p>
</main>
</body>
</html>
