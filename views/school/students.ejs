<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('students', { _inLayout: true }); %>
<%- include('../layouts/schoolLayout', { body: content, title: 'Élèves' }) %>
<% } else { %>
<div class="page-header">

    <h1>Élèves<%- include('../partials/_helpKey', { key: 'page.students' }) %></h1>

    <div class="page-header-actions">
      <a href="/school/inscriptions" class="btn btn-outline btn-sm">Fiches inscription</a>
      <a href="/school/inscriptions/nouvelle" class="btn btn-primary btn-sm">Nouvelle fiche</a>
      <a href="/school/students/import/template" class="btn btn-outline btn-sm">Modèle CSV</a>
      <a href="/school/students/import/template?format=xlsx" class="btn btn-outline btn-sm">Modèle Excel</a>
    </div>

  </div>



  <% if (error) { %>
    <div class="alert alert-error">
      <% if (error === 'matricule') { %>Ce matricule école est déjà utilisé.<% } else if (error === 'nationalMatricule') { %>Ce matricule national est déjà utilisé dans cette école.<% } else if (error === 'class') { %>Classe invalide.<% } else if (error === '1' || error === 'update' || error === 'delete') { %>Impossible d’enregistrer l’élève.<% } else { %><%= error %><% } %>
    </div>
  <% } %>

  <% if (success) { %><div class="alert alert-success">Opération réussie.</div><% } %>



  <% if (importResult) { %>

    <div class="alert <%= importResult.imported ? 'alert-success' : 'alert-error' %>">

      Import : <%= importResult.imported %> ajouté(s), <%= importResult.skipped %> ignoré(s).

      <% if (importResult.errors && importResult.errors.length) { %>
        <ul class="import-errors">
          <% importResult.errors.forEach(function (e) { %>
            <li>Ligne <%= e.line %> : <%= e.message %></li>
          <% }) %>
        </ul>
      <% } %>

    </div>

  <% } %>



  <div class="card" style="margin-bottom:1.5rem">

    <h2>Import CSV / Excel</h2>

    <% if (classes.length === 0) { %>

      <div class="alert alert-error">Créez d'abord une classe.</div>

    <% } else { %>

      <p class="form-hint">Colonnes : <code>prenom</code>, <code>nom</code>, <code>matricule</code> (école), <code>matricule_national</code>, <code>classe</code>, <code>date_naissance</code>, <code>genre</code> (M/F). Fichiers <strong>.csv</strong> ou <strong>.xlsx</strong>. Réservé à la direction.</p>

      <form method="POST" action="/school/students/import" enctype="multipart/form-data" class="form form-inline student-import-form" data-offline-skip="1">

        <div class="form-group">
          <label for="student-import-file">Fichier</label>
          <input id="student-import-file" type="file" name="csv" accept=".csv,.xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,text/csv" required>
        </div>

        <button type="submit" class="btn btn-primary">Importer</button>

      </form>

    <% } %>

  </div>



  <div class="grid-2">

    <div class="card">

      <h2>Ajouter un élève</h2>

      <form method="POST" action="/school/students" class="form" enctype="multipart/form-data" data-offline-queue="student" data-offline-file="photo">

        <div class="form-row">

          <div class="form-group"><label>Prénom</label><input type="text" name="firstName" required></div>

          <div class="form-group"><label>Nom</label><input type="text" name="lastName" required></div>

        </div>

        <div class="form-group"><label>Photo</label><input type="file" name="photo" accept="image/jpeg,image/png,image/webp"></div>

        <div class="form-group">
          <label>Matricule école</label><input type="text" name="matricule" placeholder="Pour liaison parent">
        </div>
        <% if (typeof cycle === 'undefined' || cycle.hasNationalMatricule) { %>
        <div class="form-group">
          <label>Matricule national (MEN)</label>
          <input type="text" name="nationalMatricule" placeholder="Identifiant national collège / lycée">
          <p class="form-hint">Numéro national de l’élève (MEN). Distinct du matricule interne de l’école.</p>
        </div>
        <% } %>

        <div class="form-group">

          <label>Classe</label>

          <select name="classId" required>

            <option value="">— Choisir —</option>

            <% classes.forEach(c => { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>

          </select>

        </div>

        <div class="form-group"><label>Date naissance</label><input type="date" name="birthDate"></div>

        <div class="form-group">
          <label>Genre</label>
          <select name="gender">
            <option value="">— Non renseigné —</option>
            <option value="M">Garçon (M)</option>
            <option value="F">Fille (F)</option>
          </select>
        </div>

        <% if (typeof cycle === 'undefined' || cycle.hasLyceeSeries) { %>
        <div class="form-group">
          <label>Série (lycée)</label>
          <select name="series">
            <option value="">Hériter de la classe</option>
            <% (typeof seriesOptions !== 'undefined' ? seriesOptions : []).forEach(function(opt) { %>
              <option value="<%= opt.value %>"><%= opt.label %></option>
            <% }) %>
          </select>
          <p class="form-hint">Si la classe est mixte (A/C/D), précisez la série de l’élève. Collège : laissez vide.</p>
        </div>
        <% } %>

        <button type="submit" class="btn btn-primary">Ajouter</button>

      </form>

    </div>



    <div class="card">

      <h2>Liste (<%= students.length %>)</h2>

      <% if (students.length === 0) { %>

        <p class="empty">Aucun élève.</p>

      <% } else { %>

        <% students.forEach(s => { %>

          <details class="edit-row">

            <summary>
              <%- include('../partials/_avatar', { src: s.photoUrl, firstName: s.firstName, lastName: s.lastName, size: 'sm' }) %>
              <a href="/school/students/<%= s.id %>" class="student-link" onclick="event.stopPropagation()"><strong><%= s.firstName %> <%= s.lastName %></strong></a> — <%= s.class.name %><% const stuSeries = s.series || (s.class && s.class.series); if (stuSeries) { %> · <%= typeof seriesLabel === 'function' ? seriesLabel(stuSeries) : stuSeries %><% } %> — <code>École <%= s.matricule || '—' %></code><% if (s.nationalMatricule) { %> · <code>Nat. <%= s.nationalMatricule %></code><% } %>
            </summary>

            <form method="POST" action="/school/students/<%= s.id %>/update" class="form" enctype="multipart/form-data" style="margin-top:0.75rem">

              <div class="form-row">

                <div class="form-group"><label>Prénom</label><input type="text" name="firstName" value="<%= s.firstName %>" required></div>

                <div class="form-group"><label>Nom</label><input type="text" name="lastName" value="<%= s.lastName %>" required></div>

              </div>

              <div class="form-group"><label>Matricule école</label><input type="text" name="matricule" value="<%= s.matricule || '' %>"></div>
              <% if (typeof cycle === 'undefined' || cycle.hasNationalMatricule) { %>
              <div class="form-group"><label>Matricule national (MEN)</label><input type="text" name="nationalMatricule" value="<%= s.nationalMatricule || '' %>"></div>
              <% } %>

              <div class="form-group">

                <label>Classe</label>

                <select name="classId" required>

                  <% classes.forEach(c => { %>

                    <option value="<%= c.id %>" <%= c.id === s.classId ? 'selected' : '' %>><%= c.name %></option>

                  <% }) %>

                </select>

              </div>

              <div class="form-group"><label>Naissance</label><input type="date" name="birthDate" value="<%= s.birthDate ? new Date(s.birthDate).toISOString().slice(0,10) : '' %>"></div>

              <div class="form-group">
                <label>Genre</label>
                <select name="gender">
                  <option value="" <%= !s.gender ? 'selected' : '' %>>— Non renseigné —</option>
                  <option value="M" <%= s.gender === 'M' ? 'selected' : '' %>>Garçon (M)</option>
                  <option value="F" <%= s.gender === 'F' ? 'selected' : '' %>>Fille (F)</option>
                </select>
              </div>

              <% if (typeof cycle === 'undefined' || cycle.hasLyceeSeries) { %>
              <div class="form-group">
                <label>Série (lycée)</label>
                <select name="series">
                  <option value="" <%= !s.series ? 'selected' : '' %>>Hériter de la classe<%= s.class && s.class.series ? ' (' + (typeof seriesLabel === 'function' ? seriesLabel(s.class.series) : s.class.series) + ')' : '' %></option>
                  <% (typeof seriesOptions !== 'undefined' ? seriesOptions : []).forEach(function(opt) { %>
                    <option value="<%= opt.value %>" <%= s.series === opt.value ? 'selected' : '' %>><%= opt.label %></option>
                  <% }) %>
                </select>
              </div>
              <% } %>

              <div class="form-group">
                <label>Photo</label>
                <% if (s.photoUrl) { %>
                  <div class="avatar-edit"><%- include('../partials/_avatar', { src: s.photoUrl, firstName: s.firstName, lastName: s.lastName, size: 'md' }) %></div>
                  <label class="checkbox-label"><input type="checkbox" name="removePhoto"> Supprimer la photo</label>
                <% } %>
                <input type="file" name="photo" accept="image/jpeg,image/png,image/webp">
              </div>

              <button type="submit" class="btn btn-primary btn-sm">Enregistrer</button>

            </form>

            <form method="POST" action="/school/students/<%= s.id %>/delete" onsubmit="return confirm('Supprimer cet élève ?')">

              <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>

            </form>

          </details>

        <% }) %>

      <% } %>

    </div>

  </div>
<% } %>
