<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('settings', { _inLayout: true }); %>
<%- include('../layouts/schoolLayout', { body: content, title: 'Paramètres' }) %>
<% } else { %>
<div class="page-header">
    <h1>Paramètres école</h1>
    <p class="page-sub">Code école (pour enseignants et parents) : <strong><code><%= school.slug %></code></strong></p>
  </div>

  <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <div class="card">
    <form method="POST" action="/school/settings" class="form" enctype="multipart/form-data">
      <div class="form-group logo-upload-group">
        <label for="logo">Logo de l'école</label>
        <p class="form-hint">Apparaît sur les bulletins, reçus de paiement, badges et fiches devoirs (JPG, PNG, WebP — max 2 Mo).</p>
        <% if (school.logoUrl || school.logoBase64) { %>
          <div class="logo-preview">
            <img src="<%= typeof logoSrcFor === 'function' ? (logoSrcFor(school) || school.logoUrl || school.logoBase64) : (school.logoUrl && school.logoUrl.indexOf('/uploads/') !== 0 ? school.logoUrl : school.logoBase64) %>" alt="Logo <%= school.name %>" class="school-logo-preview">
          </div>
          <label class="checkbox-label">
            <input type="checkbox" name="removeLogo">
            Supprimer le logo actuel
          </label>
        <% } %>
        <input type="file" id="logo" name="logo" accept="image/jpeg,image/png,image/webp">
      </div>

      <div class="form-group">
        <label for="name">Nom de l'école</label>
        <input type="text" id="name" name="name" value="<%= school.name %>" required>
      </div>
      <div class="form-group">
        <label for="address">Adresse</label>
        <input type="text" id="address" name="address" value="<%= school.address || '' %>">
      </div>
      <div class="form-group">
        <label for="city">Ville</label>
        <input type="text" id="city" name="city" value="<%= school.city || 'Abidjan' %>">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="waveNumber">Numéro Wave / OM (paiements)</label>
          <input type="text" id="waveNumber" name="waveNumber" value="<%= school.waveNumber || '' %>" placeholder="07 XX XX XX XX">
          <p class="form-hint">Numéro Wave pour recevoir les paiements des parents. Il n'envoie pas de SMS.</p>
        </div>
        <div class="form-group">
          <label for="omNumber">Numéro Orange Money (paiements)</label>
          <input type="text" id="omNumber" name="omNumber" value="<%= school.omNumber || '' %>" placeholder="07 XX XX XX XX">
          <p class="form-hint">Numéro Orange Money pour recevoir les paiements. Il n'envoie pas de SMS.</p>
        </div>
      </div>
      <% if (typeof smsOfficialEnabled !== 'undefined' && smsOfficialEnabled) { %>
      <div class="form-group">
        <label for="smsSenderId">Identifiant SMS officiel (nom ou numéro dédié)</label>
        <input type="text" id="smsSenderId" name="smsSenderId" value="<%= school.smsSenderId || '' %>" placeholder="Ex. ECEME ou 07 XX XX XX XX" maxlength="20">
        <p class="form-hint">Nom d'expéditeur (ex. ECEME) ou numéro SMS dédié, déclaré auprès de l'agrégateur. Ce n'est pas le numéro Wave ou Orange Money.</p>
        <p class="form-hint"><strong>Aperçu :</strong> <%= typeof smsPreview !== 'undefined' ? smsPreview : ('École ' + school.name + ' : votre enfant est absent aujourd\'hui.') %></p>
        <p class="form-hint">Tant que cet identifiant n'est pas enregistré chez l'opérateur, le téléphone peut afficher « EduConnect », mais le texte commence toujours par le nom de l'école.</p>
      </div>
      <% } else { %>
      <p class="form-hint">Le module <strong>SMS officiel</strong> n'est pas activé. Les parents reçoivent toujours les alertes dans l'application (et e-mail / notification push le cas échéant). Demandez à EduConnect d'activer le module pour envoyer des SMS au nom de l'école.</p>
      <% } %>
      <button type="submit" class="btn btn-primary">Enregistrer</button>
    </form>
  </div>

  <div class="card" style="margin-top:1.5rem">
    <h2>Ma photo</h2>
    <p class="form-hint">Visible dans la barre de navigation pour l'équipe et les parents.</p>
    <div class="person-line" style="margin-bottom:1rem">
      <%- include('../partials/_avatar', { src: user.photoUrl, firstName: user.firstName, lastName: user.lastName, size: 'lg' }) %>
      <span><%= user.firstName %> <%= user.lastName %></span>
    </div>
    <form method="POST" action="/auth/photo" enctype="multipart/form-data" class="form form-inline">
      <input type="hidden" name="redirectTo" value="/school/settings">
      <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" required>
      <button type="submit" class="btn btn-outline">Mettre à jour</button>
    </form>
  </div>
<% } %>
