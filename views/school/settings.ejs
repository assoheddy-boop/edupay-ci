<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('settings', { _inLayout: true }); %>
<%- include('../layouts/schoolLayout', { body: content, title: 'Paramètres' }) %>
<% } else { %>
<div class="page-header">
    <h1>Paramètres école</h1>
    <p class="page-sub">Code école (pour enseignants et parents) : <strong><code><%= school.slug %></code></strong></p>
  </div>

  <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <div class="card">
    <form method="POST" action="/school/settings" class="form" enctype="multipart/form-data">
      <div class="form-group logo-upload-group">
        <label for="logo">Logo de l'école</label>
        <p class="form-hint">Apparaît sur les bulletins, reçus de paiement, badges et fiches devoirs (JPG, PNG, WebP — max 2 Mo).</p>
        <% if (school.logoUrl || school.logoBase64) { %>
          <div class="logo-preview">
            <img src="<%= typeof logoSrcFor === 'function' ? (logoSrcFor(school) || school.logoUrl || school.logoBase64) : (school.logoUrl && school.logoUrl.indexOf('/uploads/') !== 0 ? school.logoUrl : school.logoBase64) %>" alt="Logo <%= school.name %>" class="school-logo-preview">
          </div>
          <label class="checkbox-label">
            <input type="checkbox" name="removeLogo">
            Supprimer le logo actuel
          </label>
        <% } %>
        <input type="file" id="logo" name="logo" accept="image/jpeg,image/png,image/webp">
      </div>

      <div class="form-group">
        <label for="name">Nom de l'école</label>
        <input type="text" id="name" name="name" value="<%= school.name %>" required>
      </div>
      <div class="form-group">
        <label for="address">Adresse</label>
        <input type="text" id="address" name="address" value="<%= school.address || '' %>">
      </div>
      <div class="form-group">
        <label for="city">Ville</label>
        <input type="text" id="city" name="city" value="<%= school.city || 'Abidjan' %>">
      </div>
      <div class="form-group">
        <label for="commune">Commune / quartier</label>
        <input type="text" id="commune" name="commune" value="<%= school.commune || '' %>" placeholder="Yopougon, Bingerville…" maxlength="80">
        <p class="form-hint">Utilisé pour le filtre <code>/ecoles?commune=</code> et l’affichage public.</p>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="waveNumber">Numéro Wave / OM (paiements)</label>
          <input type="text" id="waveNumber" name="waveNumber" value="<%= school.waveNumber || '' %>" placeholder="07 XX XX XX XX">
          <p class="form-hint">Numéro Wave pour recevoir les paiements des parents. Il n'envoie pas de SMS.</p>
        </div>
        <div class="form-group">
          <label for="omNumber">Numéro Orange Money (paiements)</label>
          <input type="text" id="omNumber" name="omNumber" value="<%= school.omNumber || '' %>" placeholder="07 XX XX XX XX">
          <p class="form-hint">Numéro Orange Money pour recevoir les paiements. Il n'envoie pas de SMS.</p>
        </div>
      </div>
      <div class="form-group">
        <label for="educationCycle">Cycle d’enseignement</label>
        <select id="educationCycle" name="educationCycle">
          <% (typeof educationCycleOptions !== 'undefined' ? educationCycleOptions : []).forEach(function(opt) { %>
            <option value="<%= opt.value %>" <%= school.educationCycle === opt.value ? 'selected' : '' %>><%= opt.label %></option>
          <% }) %>
        </select>
        <p class="form-hint">Détermine les menus : primaire (évaluations, convocations blanc), collège / lycée (délibérations, palmarès, examen national). Mixte = les deux, avec séparation Primaire / Secondaire. Les séries A / C / D n’apparaissent qu’en lycée ou mixte.</p>
      </div>
      <fieldset class="form-group">
        <legend>Paramètres portail (vitrine publique)</legend>
        <% if (typeof marketplaceEnabled !== 'undefined' && marketplaceEnabled) { %>
        <% if (typeof subscription !== 'undefined' && subscription && (subscription.state === 'expiring' || subscription.state === 'expired')) { %>
        <div class="alert <%= subscription.state === 'expired' ? 'alert-error' : 'alert-warning' %>" style="margin-bottom:0.75rem">
          Abonnement portail public : <strong><%= subscription.label %></strong>.
          <a href="/school/marketplace-renewal">Renouveler en ligne (Wave)</a>
        </div>
        <% } %>
        <label class="checkbox-label">
          <input type="checkbox" name="publicPortalEnabled" <%= school.publicPortalEnabled ? 'checked' : '' %>>
          Publier la page de l’école
        </label>
        <p class="form-hint">
          Adresse canonique :
          <% if (school.slug) { %>
            <a href="/e/<%= school.slug %>" target="_blank" rel="noopener">https://educonnect-ci.com/e/<%= school.slug %></a>
          <% } else { %>
            attribuez d’abord un code école (slug).
          <% } %>
          L’école apparaît alors sur <a href="/ecoles">/ecoles</a>. Les notes, bulletins, matricules et téléphones parents <strong>ne sont jamais publics</strong>.
          <% if (school.slug) { %> · <a href="/school/portail">Gérer les actualités</a><% } %>
        </p>
        <% } else { %>
        <p class="form-hint">La vitrine <code>/e/:slug</code> et l’annuaire <a href="/ecoles">/ecoles</a> font partie de l’option <strong>portail public EduConnect</strong>, indépendante de la gestion interne Pro. La direction ne peut pas l’activer elle-même.</p>
        <p class="form-hint"><a href="mailto:contact@educonnect.ci?subject=Portail%20public%20EduConnect">Contactez EduConnect pour le portail public</a> — Standard, Premium ou VIP.</p>
        <% } %>
        <% if (typeof marketplaceEnabled === 'undefined' || marketplaceEnabled) { %>
        <label for="publicType">Type d’établissement</label>
        <select id="publicType" name="publicType">
          <% (typeof publicTypeOptions !== 'undefined' ? publicTypeOptions : [{ value: 'PRIVE', label: 'Privé' }, { value: 'PUBLIC', label: 'Public' }, { value: 'CONFESSIONNEL', label: 'Confessionnel' }]).forEach(function(opt) { %>
            <option value="<%= opt.value %>" <%= (school.publicType || 'PRIVE') === opt.value ? 'selected' : '' %>><%= opt.label %></option>
          <% }) %>
        </select>
        <label for="publicDescription">À propos (description publique)</label>
        <textarea id="publicDescription" name="publicDescription" rows="4" maxlength="2000" placeholder="Historique, valeurs, cycles — sans noms d’élèves."><%= school.publicDescription || '' %></textarea>
        <label for="publicLife">Vie scolaire (clubs, cantine, activités)</label>
        <textarea id="publicLife" name="publicLife" rows="4" maxlength="4000" placeholder="Texte public uniquement. Pas de listes d’élèves."><%= school.publicLife || '' %></textarea>
        <label for="publicPhone">Téléphone / WhatsApp public</label>
        <input type="text" id="publicPhone" name="publicPhone" value="<%= school.publicPhone || '' %>" placeholder="05 XX XX XX XX" maxlength="40">
        <p class="form-hint">Numéro officiel affiché sur la page. Un lien WhatsApp <code>wa.me/225…</code> est généré. Ce n’est pas le numéro Wave/OM.</p>
        <label for="banner">Photo bannière (JPG, PNG, WebP — recommandé)</label>
        <input type="file" id="banner" name="banner" accept="image/jpeg,image/png,image/webp">
        <p class="form-hint">Ou indiquez une URL ci-dessous si l’image est déjà hébergée.</p>
        <label for="publicBanner">Bannière (URL https)</label>
        <input type="url" id="publicBanner" name="publicBanner" value="<%= school.publicBanner || '' %>" placeholder="https://…">
        <% if (school.publicBanner) { %>
          <div class="logo-preview" style="margin:0.5rem 0">
            <img src="<%= school.publicBanner %>" alt="Bannière" class="school-logo-preview">
          </div>
          <label class="checkbox-label">
            <input type="checkbox" name="removeBanner">
            Supprimer la bannière
          </label>
        <% } %>
        <label for="gallery">Photos galerie (JPG, PNG, WebP — plusieurs fichiers)</label>
        <input type="file" id="gallery" name="gallery" accept="image/jpeg,image/png,image/webp" multiple>
        <label for="publicGallery">Galerie — URLs (une par ligne, optionnel)</label>
        <textarea id="publicGallery" name="publicGallery" rows="4" placeholder="https://…/photo.jpg"><%= Array.isArray(school.publicGallery) ? school.publicGallery.join('\n') : (school.publicGallery || '') %></textarea>
        <% if (Array.isArray(school.publicGallery) && school.publicGallery.length) { %>
          <div class="portal-gallery-preview" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(7rem,1fr));gap:0.65rem;margin:0.75rem 0">
            <% school.publicGallery.forEach(function(url) { %>
              <label class="portal-gallery-remove-item" style="display:block;text-align:center">
                <img src="<%= url %>" alt="" class="school-logo-preview" style="max-height:4.5rem;width:100%;object-fit:cover;border-radius:8px">
                <span class="checkbox-label" style="font-size:0.8rem;margin-top:0.25rem;display:block">
                  <input type="checkbox" name="removeGallery" value="<%= url %>">
                  Retirer
                </span>
              </label>
            <% }) %>
          </div>
        <% } %>
        <div class="form-row">
          <div class="form-group">
            <label for="lat">Latitude (optionnel, OpenStreetMap)</label>
            <input type="text" id="lat" name="lat" value="<%= school.lat != null ? school.lat : '' %>" placeholder="5.34" inputmode="decimal">
          </div>
          <div class="form-group">
            <label for="lng">Longitude (optionnel)</label>
            <input type="text" id="lng" name="lng" value="<%= school.lng != null ? school.lng : '' %>" placeholder="-4.03" inputmode="decimal">
          </div>
        </div>
        <p class="form-hint">Carte OpenStreetMap uniquement — pas de Google Maps. Un lien « itinéraire » est affiché si les coordonnées sont renseignées.</p>
        <% if (typeof canSetFeatured !== 'undefined' && canSetFeatured) { %>
        <label class="checkbox-label">
          <input type="checkbox" name="publicFeatured" <%= school.publicFeatured ? 'checked' : '' %>>
          Mettre en avant sur /ecoles (Super Admin)
        </label>
        <% } %>
        <% } %>
      </fieldset>
      <% if (typeof smsOfficialEnabled !== 'undefined' && smsOfficialEnabled) { %>
      <div class="form-group">
        <label for="smsSenderId">Identifiant SMS officiel (nom ou numéro dédié)</label>
        <input type="text" id="smsSenderId" name="smsSenderId" value="<%= school.smsSenderId || '' %>" placeholder="Ex. EduConnect ou 07 XX XX XX XX" maxlength="20">
        <p class="form-hint">Nom d'expéditeur (ex. EduConnect) ou numéro SMS dédié, déclaré auprès de l'agrégateur. Ce n'est pas le numéro Wave ou Orange Money.</p>
        <p class="form-hint"><strong>Aperçu :</strong> <%= typeof smsPreview !== 'undefined' ? smsPreview : ('École ' + school.name + ' : votre enfant est absent aujourd\'hui.') %></p>
        <p class="form-hint">Tant que cet identifiant n'est pas enregistré chez l'opérateur, le téléphone peut afficher « EduConnect », mais le texte commence toujours par le nom de l'école.</p>
      </div>
      <% } else { %>
      <p class="form-hint">Le module <strong>SMS officiel</strong> n'est pas activé. Les parents reçoivent toujours les alertes dans l'application (et e-mail / notification push le cas échéant). Demandez à EduConnect d'activer le module pour envoyer des SMS au nom de l'école.</p>
      <% } %>

      <fieldset class="form-group" style="margin-top:1.25rem">
        <legend>Identité officielle — Bulletin MENET-FP</legend>
        <p class="form-hint">Ces informations alimentent automatiquement l'en-tête du bulletin PDF (modèle IGES / MENET-FP).</p>
        <div class="form-group">
          <label for="officialName">Nom officiel en-tête bulletin</label>
          <input type="text" id="officialName" name="officialName" value="<%= school.officialName || '' %>" placeholder="COMPLEXE SCOLAIRE IGES" maxlength="120">
          <p class="form-hint">Si vide, le nom de l'école ci-dessus est utilisé.</p>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="menetAgrement">N° agrément MENAPLN</label>
            <input type="text" id="menetAgrement" name="menetAgrement" value="<%= school.menetAgrement || '' %>" placeholder="89 0459/MENSS/DESEC/SDE/CAB-1" maxlength="80">
          </div>
          <div class="form-group">
            <label for="menetCode">Code MENET</label>
            <input type="text" id="menetCode" name="menetCode" value="<%= school.menetCode || '' %>" placeholder="000344" maxlength="20">
          </div>
        </div>
        <div class="form-group">
          <label for="educationLevels">Niveaux enseignés</label>
          <input type="text" id="educationLevels" name="educationLevels" value="<%= school.educationLevels || '' %>" placeholder="Maternelle – Primaire – Secondaire Général…" maxlength="200">
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="nccNumber">N°CC / RCCM</label>
            <input type="text" id="nccNumber" name="nccNumber" value="<%= school.nccNumber || '' %>" placeholder="9329192D" maxlength="30">
          </div>
          <div class="form-group">
            <label for="postalAddress">Boîte postale (BP)</label>
            <input type="text" id="postalAddress" name="postalAddress" value="<%= school.postalAddress || '' %>" placeholder="10 BP 776 Abj. 10" maxlength="80">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="publicPhones">Téléphones publics (bulletin)</label>
            <input type="text" id="publicPhones" name="publicPhones" value="<%= school.publicPhones || '' %>" placeholder="23 535 036 / 07 577 620" maxlength="120">
          </div>
          <div class="form-group">
            <label for="dren">DREN</label>
            <input type="text" id="dren" name="dren" value="<%= school.dren || '' %>" placeholder="DREN Abidjan 3" maxlength="80">
          </div>
        </div>
        <div class="form-group">
          <label for="directorName">Nom du directeur / fondateur</label>
          <input type="text" id="directorName" name="directorName" value="<%= school.directorName || '' %>" placeholder="M. GNAGNE A. Patrice" maxlength="120">
        </div>
        <div class="form-group logo-upload-group">
          <label for="secondaryLogo">Logo secondaire (optionnel — ex. filiale IGEST)</label>
          <% if (school.secondaryLogoUrl || school.secondaryLogoBase64) { %>
            <div class="logo-preview">
              <img src="<%= typeof secondaryLogoSrcFor === 'function' ? (secondaryLogoSrcFor(school) || school.secondaryLogoUrl || school.secondaryLogoBase64) : (school.secondaryLogoUrl || school.secondaryLogoBase64) %>" alt="Logo secondaire" class="school-logo-preview">
            </div>
            <label class="checkbox-label">
              <input type="checkbox" name="removeSecondaryLogo">
              Supprimer le logo secondaire
            </label>
          <% } %>
          <input type="file" id="secondaryLogo" name="secondaryLogo" accept="image/jpeg,image/png,image/webp">
        </div>
        <div class="form-group">
          <label for="homeroomTeacherName">Professeur principal (libellé bulletin)</label>
          <input type="text" id="homeroomTeacherName" name="homeroomTeacherName" value="<%= school.homeroomTeacherName || '' %>" placeholder="M. GNAGNE A. Patrice" maxlength="120">
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="directorSignature">Signature du directeur (PNG/JPG — max 2 Mo)</label>
            <% if (school.directorSignatureUrl || school.directorSignatureBase64) { %>
              <div class="logo-preview">
                <img src="<%= school.directorSignatureUrl || school.directorSignatureBase64 %>" alt="Signature directeur" class="school-logo-preview" style="max-height:4rem;background:#fff">
              </div>
              <label class="checkbox-label">
                <input type="checkbox" name="removeDirectorSignature">
                Supprimer la signature actuelle
              </label>
            <% } %>
            <input type="file" id="directorSignature" name="directorSignature" accept="image/jpeg,image/png,image/webp">
          </div>
          <div class="form-group">
            <label for="directorStamp">Cachet de l'établissement (PNG/JPG — max 2 Mo)</label>
            <% if (school.directorStampUrl || school.directorStampBase64) { %>
              <div class="logo-preview">
                <img src="<%= school.directorStampUrl || school.directorStampBase64 %>" alt="Cachet établissement" class="school-logo-preview" style="max-height:4rem;background:#fff">
              </div>
              <label class="checkbox-label">
                <input type="checkbox" name="removeDirectorStamp">
                Supprimer le cachet actuel
              </label>
            <% } %>
            <input type="file" id="directorStamp" name="directorStamp" accept="image/jpeg,image/png,image/webp">
          </div>
        </div>
      </fieldset>

      <button type="submit" class="btn btn-primary">Enregistrer</button>
    </form>
  </div>

  <div class="card" style="margin-top:1.5rem">
    <h2>Coefficients des matières</h2>
    <p class="form-hint">Définissez Maths 4, Français 3, etc. La moyenne du bulletin utilise ces coefficients.</p>
    <a href="/school/coefficients" class="btn btn-outline">Gérer les coefficients</a>
  </div>

  <div class="card" style="margin-top:1.5rem">
    <h2>Rôles staff</h2>
    <p class="form-hint">Secrétariat, comptabilité, éducateur, vie scolaire — permissions granulaires sans changer le rôle de connexion.</p>
    <a href="/school/staff-roles" class="btn btn-outline">Gérer les rôles staff</a>
  </div>

  <div class="card" style="margin-top:1.5rem">
    <h2>Ma photo</h2>
    <p class="form-hint">Visible dans la barre de navigation pour l'équipe et les parents.</p>
    <div class="person-line" style="margin-bottom:1rem">
      <%- include('../partials/_avatar', { src: user.photoUrl, firstName: user.firstName, lastName: user.lastName, size: 'lg' }) %>
      <span><%= user.firstName %> <%= user.lastName %></span>
    </div>
    <form method="POST" action="/auth/photo" enctype="multipart/form-data" class="form form-inline">
      <input type="hidden" name="redirectTo" value="/school/settings">
      <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" required>
      <button type="submit" class="btn btn-outline">Mettre à jour</button>
    </form>
  </div>
<% } %>
