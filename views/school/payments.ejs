<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('payments', { _inLayout: true }); %>
<%- include('../layouts/schoolLayout', { body: content, title: 'Paiements' }) %>
<% } else { %>
<% const casesByStudent = typeof socialCases !== 'undefined' && socialCases ? socialCases : {}; %>
<% const labelOf = typeof motifLabel === 'function' ? motifLabel : function(v) { return v; }; %>
<% const remiseOf = typeof discountLabel === 'function' ? discountLabel : function() { return ''; }; %>
<div class="page-header">
    <div>
      <h1>Paiements</h1>
      <p class="page-sub">Validez les preuves de paiement Wave / Orange Money</p>
    </div>
    <div class="page-header-actions">
      <a href="/school/caisse" class="btn btn-primary">Caisse secrétariat</a>
      <a href="/school/cas-sociaux" class="btn btn-outline">Cas sociaux</a>
    </div>
  </div>

  <div class="card">
    <% if (payments.length === 0) { %>
      <p class="empty">Aucun paiement reçu.</p>
    <% } else { %>
      <div class="table-scroll">
      <table class="table">
        <thead>
          <tr>
            <th>Élève</th>
            <th>Montant</th>
            <th>Preuve</th>
            <th>Statut</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% payments.forEach(p => { %>
            <% const sc = casesByStudent[p.studentId || (p.student && p.student.id)]; %>
            <tr>
              <td>
                <%= p.student.firstName %> <%= p.student.lastName %><br>
                <small><%= p.student.class.name %></small>
                <% if (sc) { %>
                  <br><small>Cas social : <%= labelOf(sc.motif) %> — dû après remise (<%= remiseOf(sc) %>)</small>
                <% } %>
              </td>
              <td><strong><%= formatMoney(p.amount) %></strong></td>
              <td>
                <% if (p.proofUrl) { %>
                  <a href="<%= p.proofUrl %>" target="_blank" class="btn btn-sm btn-outline">Voir capture</a>
                <% } else { %>—<% } %>
              </td>
              <td><span class="badge-status badge-<%= p.status.toLowerCase() %>"><%= typeof paymentStatusLabel === 'function' ? paymentStatusLabel(p.status) : p.status %></span></td>
              <td>
                <% if (p.status === 'PENDING') { %>
                  <form method="POST" action="/school/payments/<%= p.id %>/validate" class="inline-forms">
                    <input type="hidden" name="action" value="validate">
                    <button type="submit" class="btn btn-sm btn-success">Valider</button>
                  </form>
                  <form method="POST" action="/school/payments/<%= p.id %>/validate" class="inline-forms">
                    <input type="hidden" name="action" value="reject">
                    <button type="submit" class="btn btn-sm btn-danger">Rejeter</button>
                  </form>
                <% } else { %>
                  <%= p.validatedAt ? new Date(p.validatedAt).toLocaleDateString('fr-FR') : '—' %>
                  <% if (p.receiptUrl) { %><br><a href="<%= p.receiptUrl %>" target="_blank" class="btn btn-sm btn-success">Reçu PDF</a><% } %>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
    <% } %>
  </div>
<% } %>
