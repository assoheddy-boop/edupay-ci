<%- include('../../partials/head', { title: 'Comptabilité' }) %>
<%- include('../../partials/header', { user }) %>
<main class="container">
  <div class="page-header">
    <div>
      <h1>Comptabilité</h1>
      <p class="page-sub">Trésorerie et mouvements financiers — <%= school.name %></p>
    </div>
    <a href="/school/accounting/report" class="btn btn-outline">Rapport mensuel</a>
  </div>

  <% if (success) { %><div class="alert alert-success">Transaction enregistrée.</div><% } %>

  <div class="stats-grid">
    <div class="stat-card">
      <span class="stat-value"><%= stats.totalBalance.toLocaleString('fr-FR') %></span>
      <span class="stat-label">Solde total (FCFA)</span>
    </div>
    <div class="stat-card stat-card-success">
      <span class="stat-value"><%= stats.monthIncome.toLocaleString('fr-FR') %></span>
      <span class="stat-label">Entrées ce mois</span>
    </div>
    <div class="stat-card stat-card-warning">
      <span class="stat-value"><%= stats.monthExpense.toLocaleString('fr-FR') %></span>
      <span class="stat-label">Sorties ce mois</span>
    </div>
    <div class="stat-card">
      <span class="stat-value"><%= stats.paymentsTotal.toLocaleString('fr-FR') %></span>
      <span class="stat-label">Paiements scolarité validés</span>
    </div>
  </div>

  <div class="grid-2">
    <div class="card">
      <div class="card-header"><h2>Comptes</h2></div>
      <table class="table">
        <thead><tr><th>Compte</th><th>Type</th><th>Solde</th></tr></thead>
        <tbody>
          <% accounts.forEach(function(a) { %>
            <tr>
              <td><%= a.name %></td>
              <td><%= a.type %></td>
              <td><%= a.balance.toLocaleString('fr-FR') %> FCFA</td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="card">
      <div class="card-header"><h2>Nouvelle opération</h2></div>
      <form method="POST" action="/school/accounting/transaction" class="form" style="padding:1rem">
        <div class="form-group">
          <label>Type</label>
          <select name="type" required>
            <option value="INCOME">Entrée</option>
            <option value="EXPENSE">Dépense</option>
          </select>
        </div>
        <div class="form-group">
          <label>Montant (FCFA)</label>
          <input type="number" name="amount" required min="1">
        </div>
        <div class="form-group">
          <label>Compte</label>
          <select name="accountId" required>
            <% accounts.forEach(function(a) { %>
              <option value="<%= a.id %>"><%= a.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Catégorie (dépenses)</label>
          <select name="categoryId">
            <option value="">—</option>
            <% categories.forEach(function(c) { %>
              <option value="<%= c.id %>"><%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Description</label>
          <input type="text" name="description" required>
        </div>
        <div class="form-group">
          <label>Référence</label>
          <input type="text" name="reference">
        </div>
        <button type="submit" class="btn btn-primary">Enregistrer</button>
      </form>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h2>Derniers mouvements</h2></div>
    <% if (!transactions.length) { %>
      <p class="empty">Aucune transaction.</p>
    <% } else { %>
      <table class="table">
        <thead>
          <tr><th>Date</th><th>Type</th><th>Description</th><th>Compte</th><th>Montant</th></tr>
        </thead>
        <tbody>
          <% transactions.forEach(function(t) { %>
            <tr>
              <td><%= new Date(t.createdAt).toLocaleDateString('fr-FR') %></td>
              <td><%= t.type === 'INCOME' ? 'Entrée' : 'Dépense' %></td>
              <td><%= t.description %></td>
              <td><%= t.account.name %></td>
              <td><%= t.amount.toLocaleString('fr-FR') %> FCFA</td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</main>
<%- include('../../partials/footer') %>
<%- include('../../partials/scripts') %>
