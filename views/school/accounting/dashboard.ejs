<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('dashboard', { _inLayout: true }); %>
<%- include('../../layouts/schoolLayout', { body: content, title: 'Comptabilité' }) %>
<% } else { %>
<% const money = typeof formatMoney === 'function' ? formatMoney : function(n) { return Number(n || 0).toLocaleString('fr-FR') + ' FCFA'; }; %>
<% const typeLabel = typeof accountTypeLabel === 'function' ? accountTypeLabel : function(t) { return t; }; %>
<% const incomeCats = categories.filter(function(c) { return c.kind === 'INCOME'; }); %>
<% const expenseCats = categories.filter(function(c) { return c.kind !== 'INCOME'; }); %>
<div class="page-header">
    <div>
      <h1>Comptabilité</h1>
      <p class="page-sub">Trésorerie Wave, Orange Money, caisse et banque — <%= school.name %></p>
    </div>
    <div class="export-links">
      <a href="/school/accounting/report<%= periodQs %>" class="btn btn-outline">Rapport</a>
      <a href="/school/accounting/report.xlsx<%= periodQs %>" class="btn btn-outline">Excel</a>
      <a href="/school/accounting/report.pdf<%= periodQs %>" class="btn btn-outline">PDF</a>
    </div>
  </div>

  <% if (success) { %><div class="alert alert-success">Opération enregistrée.</div><% } %>
  <% if (success === 'account') { %><div class="alert alert-success">Compte enregistré.</div><% } %>
  <% if (success === 'category') { %><div class="alert alert-success">Catégorie enregistrée.</div><% } %>
  <% if (success === 'invoice') { %><div class="alert alert-success">Facture fournisseur enregistrée.</div><% } %>
  <% if (success === 'invoice_paid') { %><div class="alert alert-success">Facture payée et enregistrée en comptabilité.</div><% } %>
  <% if (success === 'budget') { %><div class="alert alert-success">Budget mis à jour.</div><% } %>
  <% if (error === 'amount') { %><div class="alert alert-error">Montant invalide.</div><% } %>
  <% if (error === 'account') { %><div class="alert alert-error">Compte introuvable.</div><% } %>
  <% if (error === 'type') { %><div class="alert alert-error">Type d'opération invalide.</div><% } %>
  <% if (error === 'data') { %><div class="alert alert-error">Données incomplètes.</div><% } %>

  <form method="GET" action="/school/accounting" class="card accounting-filter">
    <div class="form-row">
      <div class="form-group">
        <label for="view">Période</label>
        <select id="view" name="view">
          <option value="month" <%= period.view !== 'year' ? 'selected' : '' %>>Mois</option>
          <option value="year" <%= period.view === 'year' ? 'selected' : '' %>>Année scolaire</option>
        </select>
      </div>
      <div class="form-group">
        <label for="month">Mois</label>
        <input type="month" id="month" name="month" value="<%= period.month || '' %>">
      </div>
      <div class="form-group">
        <label for="schoolYear">Année scolaire</label>
        <input type="text" id="schoolYear" name="schoolYear" value="<%= period.schoolYear || school.currentSchoolYear %>" placeholder="2025-2026">
      </div>
    </div>
    <button type="submit" class="btn btn-primary">Filtrer</button>
  </form>

  <div class="stats-grid">
    <div class="stat-card">
      <span class="stat-value"><%= money(stats.totalBalance) %></span>
      <span class="stat-label">Solde des comptes</span>
    </div>
    <div class="stat-card stat-card-success">
      <span class="stat-value"><%= money(stats.periodIncome) %></span>
      <span class="stat-label">Recettes — <%= period.label %></span>
    </div>
    <div class="stat-card stat-card-warning">
      <span class="stat-value"><%= money(stats.periodExpense) %></span>
      <span class="stat-label">Dépenses — <%= period.label %></span>
    </div>
    <div class="stat-card">
      <span class="stat-value"><%= money(stats.paymentsTotal) %></span>
      <span class="stat-label">Scolarité validée (période)</span>
    </div>
  </div>

  <div class="card" style="margin-bottom:1.5rem">
    <div class="card-header"><h2>Trésorerie par compte</h2></div>
    <div class="stats-grid" style="padding:1rem">
      <% accounts.forEach(function(a) { %>
        <div class="stat-card">
          <span class="stat-value"><%= money(a.balance) %></span>
          <span class="stat-label"><%= a.name %> (<%= typeLabel(a.type) %>)</span>
        </div>
      <% }) %>
    </div>
  </div>

  <div class="grid-2">
    <div class="card">
      <div class="card-header"><h2>Gérer les comptes</h2></div>
      <form method="POST" action="/school/accounting/accounts" class="form accounting-form" style="padding:1rem">
        <div class="form-group"><label>Nom du compte</label><input name="name" required placeholder="Ex: MTN Money"></div>
        <div class="form-group">
          <label>Type</label>
          <select name="type" required>
            <% Object.keys(accountTypeLabels || {}).forEach(function(k) { %>
              <option value="<%= k %>"><%= accountTypeLabels[k] %></option>
            <% }) %>
          </select>
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Ajouter un compte</button>
      </form>
    </div>
    <div class="card">
      <div class="card-header"><h2>Gérer les catégories</h2></div>
      <form method="POST" action="/school/accounting/categories" class="form accounting-form" style="padding:1rem">
        <div class="form-group"><label>Nom</label><input name="name" required placeholder="Ex: Fournitures"></div>
        <div class="form-group">
          <label>Type</label>
          <select name="kind"><option value="EXPENSE">Dépense</option><option value="INCOME">Recette</option></select>
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Ajouter une catégorie</button>
      </form>
    </div>
  </div>

  <div class="grid-2" style="margin-top:1.5rem">
    <div class="card">
      <div class="card-header"><h2>Factures fournisseurs</h2></div>
      <form method="POST" action="/school/accounting/invoices" class="form accounting-form" style="padding:1rem">
        <div class="form-group"><label>Fournisseur</label><input name="supplierName" required></div>
        <div class="form-group"><label>Montant (FCFA)</label><input type="number" name="amount" min="1" required></div>
        <div class="form-group"><label>Description</label><input name="description"></div>
        <div class="form-group"><label>Échéance</label><input type="date" name="dueDate"></div>
        <div class="form-group">
          <label>Catégorie</label>
          <select name="categoryId">
            <option value="">—</option>
            <% expenseCats.forEach(function(c) { %><option value="<%= c.id %>"><%= c.name %></option><% }) %>
          </select>
        </div>
        <button type="submit" class="btn btn-primary btn-sm">Enregistrer la facture</button>
      </form>
      <% if (invoices && invoices.length) { %>
      <div class="table-scroll" style="padding:0 1rem 1rem">
        <table class="table">
          <thead><tr><th>Fournisseur</th><th>Montant</th><th>Statut</th><th></th></tr></thead>
          <tbody>
            <% invoices.forEach(function(inv) { %>
              <tr>
                <td><%= inv.supplierName %></td>
                <td><%= money(inv.amount) %></td>
                <td><%= typeof supplierInvoiceStatusLabel === 'function' ? supplierInvoiceStatusLabel(inv.status) : inv.status %></td>
                <td>
                  <% if (inv.status === 'PENDING') { %>
                    <form method="POST" action="/school/accounting/invoices/<%= inv.id %>/pay" class="inline-form">
                      <select name="accountId" required>
                        <option value="">Compte</option>
                        <% accounts.forEach(function(a) { %><option value="<%= a.id %>"><%= a.name %></option><% }) %>
                      </select>
                      <button type="submit" class="btn btn-sm btn-primary">Payer</button>
                    </form>
                    <form method="POST" action="/school/accounting/invoices/<%= inv.id %>/cancel" class="inline-form">
                      <button type="submit" class="btn btn-sm btn-outline">Annuler</button>
                    </form>
                  <% } else { %>—<% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>

    <div class="card">
      <div class="card-header"><h2>Budget <%= schoolYear %></h2></div>
      <form method="POST" action="/school/accounting/budget" class="form accounting-form" style="padding:1rem">
        <input type="hidden" name="schoolYear" value="<%= schoolYear %>">
        <div class="form-group">
          <label>Catégorie</label>
          <select name="categoryId" required>
            <% categories.forEach(function(c) { %><option value="<%= c.id %>"><%= c.name %> (<%= c.kind === 'INCOME' ? 'Recette' : 'Dépense' %>)</option><% }) %>
          </select>
        </div>
        <div class="form-group"><label>Montant prévu (FCFA)</label><input type="number" name="plannedAmount" min="0" required></div>
        <button type="submit" class="btn btn-primary btn-sm">Enregistrer la ligne</button>
      </form>
      <% if (budgetReport && budgetReport.budgetRows && budgetReport.budgetRows.length) { %>
      <div class="table-scroll" style="padding:0 1rem 1rem">
        <table class="table">
          <thead><tr><th>Catégorie</th><th>Prévu</th><th>Réalisé</th><th>Écart</th></tr></thead>
          <tbody>
            <% budgetReport.budgetRows.forEach(function(row) { %>
              <tr>
                <td><%= row.categoryName %></td>
                <td><%= money(row.planned) %></td>
                <td><%= money(row.actual) %></td>
                <td><%= money(row.variance) %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
        <p class="page-sub" style="padding:0.5rem 1rem">Cas sociaux actifs : <%= budgetReport.socialCasesCount %> — impact remises estimé : <%= money(budgetReport.totals.socialDiscountEstimate) %></p>
      </div>
      <% } %>
    </div>
  </div>

  <div class="grid-2">
    <div class="card">
      <div class="card-header"><h2>Comptes</h2></div>
      <div class="table-scroll">
      <table class="table">
        <thead><tr><th>Compte</th><th>Type</th><th>Solde</th></tr></thead>
        <tbody>
          <% accounts.forEach(function(a) { %>
            <tr>
              <td><%= a.name %></td>
              <td><%= typeLabel(a.type) %></td>
              <td><%= money(a.balance) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
    </div>

    <div class="card">
      <div class="card-header"><h2>Nouvelle opération</h2></div>
      <form method="POST" action="/school/accounting/transaction" class="form accounting-form">
        <div class="form-group">
          <label for="type">Type</label>
          <select id="type" name="type" required>
            <option value="INCOME">Recette</option>
            <option value="EXPENSE">Dépense</option>
          </select>
        </div>
        <div class="form-group">
          <label for="amount">Montant (FCFA)</label>
          <input type="number" id="amount" name="amount" required min="1" inputmode="numeric">
        </div>
        <div class="form-group">
          <label for="accountId">Compte</label>
          <select id="accountId" name="accountId" required>
            <% accounts.forEach(function(a) { %>
              <option value="<%= a.id %>"><%= a.name %> — <%= typeLabel(a.type) %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label for="categoryId">Catégorie</label>
          <select id="categoryId" name="categoryId">
            <option value="">—</option>
            <% if (incomeCats.length) { %>
            <optgroup label="Recettes">
              <% incomeCats.forEach(function(c) { %>
                <option value="<%= c.id %>"><%= c.name %></option>
              <% }) %>
            </optgroup>
            <% } %>
            <% if (expenseCats.length) { %>
            <optgroup label="Dépenses">
              <% expenseCats.forEach(function(c) { %>
                <option value="<%= c.id %>"><%= c.name %></option>
              <% }) %>
            </optgroup>
            <% } %>
          </select>
        </div>
        <div class="form-group">
          <label for="description">Description</label>
          <input type="text" id="description" name="description" required maxlength="500" placeholder="Ex: Fournitures rentrée">
        </div>
        <div class="form-group">
          <label for="reference">Référence</label>
          <input type="text" id="reference" name="reference" maxlength="120" placeholder="Ex: WAVE-123, facture">
        </div>
        <button type="submit" class="btn btn-primary">Enregistrer</button>
      </form>
    </div>
  </div>

  <% if (byCategory && byCategory.length) { %>
  <div class="card">
    <div class="card-header"><h2>Par catégorie — <%= period.label %></h2></div>
    <div class="table-scroll">
    <table class="table">
      <thead><tr><th>Catégorie</th><th>Type</th><th>Montant</th></tr></thead>
      <tbody>
        <% byCategory.forEach(function(c) { %>
          <tr>
            <td><%= c.name %></td>
            <td><%= c.kind === 'INCOME' ? 'Recette' : 'Dépense' %></td>
            <td><%= money(c.amount) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
  </div>
  <% } %>

  <div class="card">
    <div class="card-header"><h2>Derniers mouvements — <%= period.label %></h2></div>
    <% if (!transactions.length) { %>
      <p class="empty">Aucune opération sur cette période.</p>
    <% } else { %>
      <div class="table-scroll">
      <table class="table">
        <thead>
          <tr><th>Date</th><th>Type</th><th>Description</th><th>Catégorie</th><th>Compte</th><th>Montant</th></tr>
        </thead>
        <tbody>
          <% transactions.forEach(function(t) { %>
            <tr>
              <td><%= new Date(t.createdAt).toLocaleDateString('fr-FR') %></td>
              <td><%= t.type === 'INCOME' ? 'Recette' : 'Dépense' %></td>
              <td><%= t.description %></td>
              <td><%= t.category ? t.category.name : '—' %></td>
              <td><%= t.account ? t.account.name : '—' %></td>
              <td><%= money(t.amount) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      </div>
    <% } %>
  </div>
<% } %>
