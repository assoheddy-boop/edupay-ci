<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('sms', { _inLayout: true }); %>
<%- include('../layouts/schoolLayout', { body: content, title: 'SMS officiels' }) %>
<% } else { %>
<%
  const money = typeof formatMoney === 'function' ? formatMoney : function(n) { return Number(n || 0).toLocaleString('fr-FR') + ' FCFA'; };
  const statusLabel = { pending: 'En attente', sent: 'Envoyé', error: 'Erreur', skipped: 'Ignoré' };
  const typeLabel = {
    ABSENCE: 'Absence',
    LATE: 'Retard',
    PAYMENT_VALIDATED: 'Paiement validé',
    PAYMENT_REFUSED: 'Paiement refusé',
    PAYMENT_OVERDUE: 'Paiement en retard',
    HOMEWORK_PUBLISHED: 'Devoir',
    HOMEWORK_REMIND: 'Rappel devoir',
    TIMETABLE_UPDATED: 'Emploi du temps',
    MESSAGE: 'Message',
  };
  function jobBody(job) {
    const payload = job.payload || {};
    if (payload.smsBody) return payload.smsBody;
    return payload.body || payload.message || '—';
  }
%>
<div class="page-header">
  <div>
    <h1>SMS officiels</h1>
    <p class="page-sub">Messages envoyés aux parents (absences, devoirs, paiements) — <%= school.name %></p>
  </div>
  <a href="/school/settings" class="btn btn-outline">Identifiant SMS</a>
</div>

<p class="form-hint">Aperçu du texte : <strong><%= typeof smsPreview !== 'undefined' ? smsPreview : ('École ' + school.name + ' : votre enfant est absent aujourd\'hui.') %></strong></p>
<p class="form-hint">Wave et Orange Money restent des numéros de paiement. L'expéditeur SMS est l'identifiant déclaré (ou EduConnect tant qu'il n'est pas enregistré chez l'agrégateur).</p>

<form method="GET" action="/school/sms" class="card" style="margin-bottom:1rem">
  <div class="form-row">
    <div class="form-group">
      <label for="channel">Canal</label>
      <select id="channel" name="channel">
        <option value="SMS" <%= filters.channel === 'SMS' ? 'selected' : '' %>>SMS</option>
        <option value="EMAIL" <%= filters.channel === 'EMAIL' ? 'selected' : '' %>>E-mail</option>
        <option value="PUSH" <%= filters.channel === 'PUSH' ? 'selected' : '' %>>Push</option>
        <option value="IN_APP" <%= filters.channel === 'IN_APP' ? 'selected' : '' %>>Dans l'app</option>
        <option value="all" <%= filters.channel === 'all' ? 'selected' : '' %>>Tous</option>
      </select>
    </div>
    <div class="form-group">
      <label for="status">Statut</label>
      <select id="status" name="status">
        <option value="" <%= !filters.status ? 'selected' : '' %>>Tous</option>
        <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>En attente</option>
        <option value="sent" <%= filters.status === 'sent' ? 'selected' : '' %>>Envoyé</option>
        <option value="error" <%= filters.status === 'error' ? 'selected' : '' %>>Erreur</option>
        <option value="skipped" <%= filters.status === 'skipped' ? 'selected' : '' %>>Ignoré</option>
      </select>
    </div>
    <div class="form-group">
      <label for="from">Du</label>
      <input type="date" id="from" name="from" value="<%= filters.from || '' %>">
    </div>
    <div class="form-group">
      <label for="to">Au</label>
      <input type="date" id="to" name="to" value="<%= filters.to || '' %>">
    </div>
  </div>
  <button type="submit" class="btn btn-primary">Filtrer</button>
</form>

<div class="card">
  <% if (!jobs.length) { %>
    <p class="empty">Aucun SMS enregistré pour cette école.</p>
  <% } else { %>
    <div class="table-scroll">
      <table class="table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Destinataire</th>
            <th>Type</th>
            <th>Message</th>
            <th>Expéditeur</th>
            <th>Statut</th>
          </tr>
        </thead>
        <tbody>
          <% jobs.forEach(function(job) { %>
            <tr>
              <td><%= job.createdAt ? new Date(job.createdAt).toLocaleString('fr-FR') : '—' %></td>
              <td>
                <%= job.user ? (job.user.firstName + ' ' + job.user.lastName) : '—' %>
                <% if (job.user && job.user.phone) { %><br><small><%= job.user.phone %></small><% } %>
              </td>
              <td><%= typeLabel[job.eventType] || job.eventType %></td>
              <td>
                <%= jobBody(job) %>
                <% if (job.payload && job.payload.amount) { %><br><small><%= money(job.payload.amount) %></small><% } %>
              </td>
              <td><%= job.senderId || '—' %></td>
              <td>
                <span class="badge-status badge-<%= job.status %>"><%= statusLabel[job.status] || job.status %></span>
                <% if (job.error) { %><br><small><%= job.error %></small><% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
<% } %>
