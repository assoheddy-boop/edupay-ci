<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('upgrade', { _inLayout: true }); %>
<%- include('../layouts/schoolLayout', { body: content, title: 'Offre Pro' }) %>
<% } else { %>
<div class="upgrade-page card">
    <h1>Fonctionnalité de l'offre Pro</h1>
    <p><strong><%= feature %></strong> fait partie d'EduConnect Pro. Les modules sont activés par EduConnect.</p>
    <ul class="upgrade-list">
      <li>✓ Bulletins PDF automatiques</li>
      <li>✓ Chat école ↔ parents</li>
      <li>✓ Statistiques & exports Excel</li>
      <li>✓ SMS officiel</li>
    </ul>
    <p class="page-sub">Offre unique : <strong>Pro — 500 000 FCFA / an</strong>.</p>
    <a href="/devis" class="btn btn-primary btn-lg">Obtenir un devis</a>
    <a href="/school/dashboard" class="btn btn-outline">Retour</a>
  </div>
<% } %>
