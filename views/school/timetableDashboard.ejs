<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('timetableDashboard', { _inLayout: true }); %>
<%- include('../layouts/schoolLayout', { body: content, title: 'Emploi du temps', user, modules }) %>
<% } else { %>
<div class="page-header">
  <div>
    <h1>Emploi du temps</h1>
    <p class="page-sub">Planification hebdomadaire — Lundi à Samedi</p>
  </div>
  <div class="btn-group">
    <% if (filterClassId) { %>
      <a href="/timetable/export/class/<%= filterClassId %>.pdf" class="btn btn-outline">Export PDF</a>
      <a href="/timetable/export/class/<%= filterClassId %>.xlsx" class="btn btn-outline">Export Excel</a>
    <% } %>
  </div>
</div>

<% if (success === '1') { %>
  <div class="alert alert-success">Créneau enregistré avec succès.</div>
<% } else if (success === 'notified') { %>
  <div class="alert alert-success">Emploi du temps envoyé aux parents.</div>
<% } else if (success === 'class-notified') { %>
  <div class="alert alert-success">Emploi du temps envoyé à tous les parents de la classe.</div>
<% } %>

<% if (error) { %>
  <div class="alert alert-danger"><%= error %></div>
<% } %>
<% if (conflict) { %>
  <div class="alert alert-warning">⚠ Conflit d'horaire : <%= conflict %></div>
<% } %>

<div class="card" style="margin-bottom:1.5rem">
  <div class="card-header"><h2>Filtres</h2></div>
  <form method="GET" action="/timetable" id="timetableFilters" class="form grid-3" style="padding:1rem">
    <label>
      Vue
      <select name="view" id="filterView">
        <option value="class" <%= viewMode === 'class' ? 'selected' : '' %>>Par classe</option>
        <option value="teacher" <%= viewMode === 'teacher' ? 'selected' : '' %>>Par enseignant</option>
      </select>
    </label>

    <% if (viewMode === 'class') { %>
      <label>
        Classe
        <select name="classId" id="filterClassId">
          <option value="">— Choisir —</option>
          <% classes.forEach(c => { %>
            <option value="<%= c.id %>" <%= filterClassId === c.id ? 'selected' : '' %>><%= c.level %> — <%= c.name %></option>
          <% }) %>
        </select>
      </label>
    <% } else { %>
      <label>
        Enseignant
        <select name="teacherId" id="filterTeacherId">
          <option value="">— Choisir —</option>
          <% teachers.forEach(t => { %>
            <option value="<%= t.id %>" <%= filterTeacherId === t.id ? 'selected' : '' %>>
              <%= t.user.lastName %> <%= t.user.firstName %>
            </option>
          <% }) %>
        </select>
      </label>
    <% } %>

    <label>
      Matière
      <select name="subjectId" id="filterSubjectId">
        <option value="">Toutes</option>
        <% subjects.forEach(s => { %>
          <option value="<%= s.id %>" <%= filterSubjectId === s.id ? 'selected' : '' %>><%= s.name %></option>
        <% }) %>
      </select>
    </label>
  </form>

  <% if (user.role === 'SCHOOL_ADMIN' || user.role === 'SUPER_ADMIN') { %>
    <div style="padding:0 1rem 1rem;display:flex;gap:.75rem;flex-wrap:wrap">
    <a href="/school/timetable-agent" class="btn btn-outline">Assistant emploi du temps</a>
      <% if (filterClassId) { %>
        <form method="POST" action="/timetable/notify-class" onsubmit="return confirm('Envoyer l\'emploi du temps à tous les parents de cette classe ?');">
          <input type="hidden" name="classId" value="<%= filterClassId %>">
          <button type="submit" class="btn btn-primary">Envoyer emploi du temps aux parents</button>
        </form>
      <% } %>
      <% if (filterClassId && students.length) {
        const classStudents = students.filter(s => s.classId === filterClassId);
        const firstStudent = classStudents[0];
      %>
        <% if (firstStudent) { %>
        <form method="GET" id="notifyStudentForm" action="/timetable/notify/<%= firstStudent.id %>" style="display:flex;gap:.5rem;align-items:flex-end">
          <label style="margin:0">
            Élève
            <select id="notifyStudentSelect" onchange="document.getElementById('notifyStudentForm').action='/timetable/notify/'+this.value">
              <% classStudents.forEach(s => { %>
                <option value="<%= s.id %>"><%= s.lastName %> <%= s.firstName %></option>
              <% }) %>
            </select>
          </label>
          <button type="submit" class="btn btn-outline">Envoyer aux parents</button>
        </form>
        <% } %>
      <% } %>
    </div>
  <% } %>
</div>

<div class="grid-2">
  <div class="card">
    <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:.5rem">
      <h2 style="margin:0">Calendrier</h2>
      <div id="calendarViewToggle" class="btn-group">
        <button type="button" class="btn btn-sm btn-outline" data-view="timeGridWeek">Semaine</button>
        <button type="button" class="btn btn-sm btn-outline" data-view="timeGridDay">Jour</button>
      </div>
    </div>
    <div style="padding:1rem">
      <div id="calendar"></div>
      <p id="calendarEmpty" class="text-muted" style="display:none;margin-top:1rem">
        Sélectionnez une classe ou un enseignant pour afficher l'emploi du temps.
      </p>
    </div>
  </div>

  <% if (user.role === 'SCHOOL_ADMIN' || user.role === 'SUPER_ADMIN') { %>
  <div class="card">
    <div class="card-header"><h2>Ajouter un créneau</h2></div>
    <form method="POST" action="/timetable/create" class="form" style="padding:1rem">
      <label>Classe *
        <select name="classId" required>
          <option value="">— Choisir —</option>
          <% classes.forEach(c => { %>
            <option value="<%= c.id %>" <%= filterClassId === c.id ? 'selected' : '' %>><%= c.level %> — <%= c.name %></option>
          <% }) %>
        </select>
      </label>
      <label>Enseignant *
        <select name="teacherId" required>
          <option value="">— Choisir —</option>
          <% teachers.forEach(t => { %>
            <option value="<%= t.id %>"><%= t.user.lastName %> <%= t.user.firstName %></option>
          <% }) %>
        </select>
      </label>
      <label>Matière *
        <select name="subjectId">
          <option value="">— Choisir ou saisir —</option>
          <% subjects.forEach(s => { %>
            <option value="<%= s.id %>"><%= s.name %></option>
          <% }) %>
        </select>
      </label>
      <label>Nouvelle matière (si absente)
        <input type="text" name="subjectName" placeholder="Ex: Mathématiques">
      </label>
      <label>Salle
        <input type="text" name="room" placeholder="Ex: Salle A12">
      </label>
      <label>Jour *
        <select name="dayOfWeek" required>
          <% days.forEach(d => { %><option value="<%= d %>"><%= d %></option><% }) %>
        </select>
      </label>
      <div class="grid-2">
        <label>Début *
          <input type="time" name="startTime" value="08:00" required>
        </label>
        <label>Fin *
          <input type="time" name="endTime" value="09:00" required>
        </label>
      </div>
      <button type="submit" class="btn btn-primary">Ajouter le créneau</button>
    </form>
  </div>
  <% } %>
</div>

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@fullcalendar/core@6.1.15/locales/fr.global.min.js"></script>

<style>
#calendar { min-height: 620px; }
.fc-event { cursor: pointer; font-size: .85rem; }
.fc .fc-toolbar-title { font-size: 1.1rem; }
.fc-timegrid-slot { height: 2.5em; }
</style>

<script>
(function () {
  const viewMode = '<%= viewMode %>';
  const filterClassId = '<%= filterClassId || '' %>';
  const filterTeacherId = '<%= filterTeacherId || '' %>';
  const filterSubjectId = '<%= filterSubjectId || '' %>';
  const canEdit = <%= (user.role === 'SCHOOL_ADMIN' || user.role === 'SUPER_ADMIN') ? 'true' : 'false' %>;
  const dayNames = ['Dimanche', 'Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi'];

  const calendarEl = document.getElementById('calendar');
  const emptyEl = document.getElementById('calendarEmpty');
  const hasFilter = (viewMode === 'class' && filterClassId) || (viewMode === 'teacher' && filterTeacherId);

  if (!hasFilter) {
    emptyEl.style.display = 'block';
    calendarEl.style.display = 'none';
    return;
  }

  function pad(n) { return String(n).padStart(2, '0'); }

  function formatTime(date) {
    return pad(date.getHours()) + ':' + pad(date.getMinutes());
  }

  function buildEventsUrl() {
    const params = new URLSearchParams();
    if (viewMode === 'class' && filterClassId) params.set('classId', filterClassId);
    if (viewMode === 'teacher' && filterTeacherId) params.set('teacherId', filterTeacherId);
    if (filterSubjectId) params.set('subjectId', filterSubjectId);
    return '/timetable/events?' + params.toString();
  }

  async function persistEventChange(info) {
    const start = info.event.start;
    const end = info.event.end;
    if (!start || !end) {
      info.revert();
      return;
    }

    const body = {
      dayOfWeek: dayNames[start.getDay()],
      startTime: formatTime(start),
      endTime: formatTime(end),
    };

    try {
      const res = await fetch('/timetable/update/' + info.event.id, {
        method: 'PUT',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
        },
        body: JSON.stringify(body),
      });
      const data = await res.json();
      if (!data.ok) {
        info.revert();
        alert(data.message || 'Conflit d\'horaire — modification annulée.');
        return;
      }
      calendar.refetchEvents();
    } catch (err) {
      info.revert();
      alert('Erreur réseau lors de la mise à jour.');
    }
  }

  const calendar = new FullCalendar.Calendar(calendarEl, {
    locale: 'fr',
    firstDay: 1,
    initialView: 'timeGridWeek',
    headerToolbar: {
      left: 'prev,next today',
      center: 'title',
      right: '',
    },
    slotMinTime: '07:00:00',
    slotMaxTime: '18:00:00',
    allDaySlot: false,
    height: 'auto',
    editable: canEdit,
    eventDurationEditable: canEdit,
    eventStartEditable: canEdit,
    nowIndicator: true,
    hiddenDays: [0],
    events: function (fetchInfo, successCallback, failureCallback) {
      fetch(buildEventsUrl(), { headers: { Accept: 'application/json' } })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (!data.ok) {
            failureCallback(new Error(data.message || data.error || 'Erreur'));
            return;
          }
          successCallback(data.events || []);
        })
        .catch(function (err) { failureCallback(err); });
    },
    eventDidMount: function (info) {
      const p = info.event.extendedProps;
      const lines = [
        p.subject || info.event.title,
        'Prof : ' + (p.teacher || '—'),
        'Salle : ' + (p.room || '—'),
      ];
      if (viewMode === 'teacher' && p.className) {
        lines.push('Classe : ' + p.className);
      }
      if (p.conflict && p.conflictMessage) {
        lines.push('⚠ ' + p.conflictMessage);
      }
      info.el.title = lines.join('\n');
    },
    eventDrop: persistEventChange,
    eventResize: persistEventChange,
    eventClick: function (info) {
      if (!canEdit) return;
      const p = info.event.extendedProps;
      const msg = [
        p.subject || info.event.title,
        'Prof : ' + (p.teacher || '—'),
        'Salle : ' + (p.room || '—'),
        p.conflict ? ('Conflit : ' + (p.conflictMessage || 'oui')) : '',
        '',
        'Supprimer ce créneau ?',
      ].filter(Boolean).join('\n');
      if (!confirm(msg)) return;

      fetch('/timetable/' + info.event.id, {
        method: 'DELETE',
        headers: { Accept: 'application/json' },
      })
        .then(function (res) { return res.json(); })
        .then(function (data) {
          if (!data.ok) {
            alert(data.message || 'Suppression impossible.');
            return;
          }
          info.event.remove();
        })
        .catch(function () { alert('Erreur réseau lors de la suppression.'); });
    },
  });

  calendar.render();

  document.querySelectorAll('#calendarViewToggle [data-view]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      calendar.changeView(btn.getAttribute('data-view'));
    });
  });

  const filterForm = document.getElementById('timetableFilters');
  if (filterForm) {
    filterForm.querySelectorAll('select').forEach(function (sel) {
      sel.addEventListener('change', function () {
        filterForm.submit();
      });
    });
  }
})();
</script>
<% } %>
