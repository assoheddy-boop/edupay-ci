<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('inscriptionForm', { _inLayout: true }); %>
<%- include('../layouts/schoolLayout', { body: content, title: title || 'Fiche d’inscription' }) %>
<% } else { %>
<div class="page-header">
  <h1><%= isNew ? 'Inscription' : 'Fiche d’inscription' %></h1>
  <div class="page-header-actions">
    <a href="/school/inscriptions" class="btn btn-outline btn-sm">Liste</a>
    <% if (!isNew) { %>
      <a href="/school/students" class="btn btn-outline btn-sm">Élèves</a>
      <a href="/school/inscriptions/<%= student.id %>/fiche.pdf" class="btn btn-outline btn-sm" target="_blank" rel="noopener">Fiche PDF</a>
    <% } %>
    <a href="/reinscription/dashboard" class="btn btn-warning btn-sm">Réinscription</a>
  </div>
</div>

<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
<% if (success) { %><div class="alert alert-success">Fiche enregistrée avec succès.</div><% } %>

<form method="POST" action="<%= isNew ? '/school/inscriptions' : '/school/inscriptions/' + student.id %>" enctype="multipart/form-data" class="form inscription-form" id="inscriptionForm">

  <div class="inscription-header card">
    <div class="inscription-header-row">
      <div>
        <label>Année scolaire</label>
        <strong><%= schoolYear %></strong>
      </div>
      <div class="form-group">
        <label for="enrolledAt">Date inscription</label>
        <input type="date" id="enrolledAt" name="enrolledAt" value="<%= enrollment && enrollment.enrolledAt ? new Date(enrollment.enrolledAt).toISOString().slice(0,10) : new Date().toISOString().slice(0,10) %>">
      </div>
      <div class="effectif-box" id="effectifBox">
        <span class="effectif-label">Effectif classe</span>
        <span>M: <strong id="effM"><%= effectif.male %></strong></span>
        <span>F: <strong id="effF"><%= effectif.female %></strong></span>
        <span>T: <strong id="effT"><%= effectif.total %></strong></span>
      </div>
    </div>
  </div>

  <div class="grid-2 inscription-grid">
    <div class="card">
      <h2>Identité &amp; scolarité</h2>
      <div class="form-row matricule-row">
        <div class="form-group">
          <label>Mle étab.</label>
          <input type="text" name="matricule" value="<%= student && student.matricule ? student.matricule : '' %>" placeholder="Matricule interne">
        </div>
        <% if (cycle.hasNationalMatricule) { %>
        <div class="form-group">
          <label for="nationalMatriculeInput">Mle nat. (MEN)</label>
          <div class="input-with-action">
            <input type="text" name="nationalMatricule" id="nationalMatriculeInput" value="<%= student && student.nationalMatricule ? student.nationalMatricule : '' %>" placeholder="Matricule national">
            <button type="button" class="input-action-btn" id="menLookupBtn" title="Ouvrir la fiche par matricule national" aria-label="Rechercher par matricule national">&#128269;</button>
          </div>
        </div>
        <% } %>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Nom *</label><input type="text" name="lastName" required value="<%= student ? student.lastName : '' %>"></div>
        <div class="form-group"><label>Prénoms *</label><input type="text" name="firstName" required value="<%= student ? student.firstName : '' %>"></div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Né(e) le</label>
          <input type="date" name="birthDate" value="<%= student && student.birthDate ? new Date(student.birthDate).toISOString().slice(0,10) : '' %>">
        </div>
        <div class="form-group">
          <label>À</label>
          <input type="text" name="birthPlace" value="<%= student && student.birthPlace ? student.birthPlace : '' %>" placeholder="Ville / commune">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Sexe</label>
          <select name="gender">
            <option value="">—</option>
            <option value="M" <%= student && student.gender === 'M' ? 'selected' : '' %>>M</option>
            <option value="F" <%= student && student.gender === 'F' ? 'selected' : '' %>>F</option>
          </select>
        </div>
        <div class="form-group">
          <label>Nationalité</label>
          <input type="text" name="nationality" value="<%= student && student.nationality ? student.nationality : 'Ivoirienne' %>">
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Extrait N°</label>
          <input type="text" name="birthCertNumber" value="<%= enrollment && enrollment.birthCertNumber ? enrollment.birthCertNumber : '' %>">
        </div>
        <div class="form-group">
          <label>Date déli.</label>
          <input type="date" name="birthCertDate" value="<%= enrollment && enrollment.birthCertDate ? new Date(enrollment.birthCertDate).toISOString().slice(0,10) : '' %>">
        </div>
      </div>
      <div class="form-group">
        <label>Lieu déli.</label>
        <input type="text" name="birthCertPlace" value="<%= enrollment && enrollment.birthCertPlace ? enrollment.birthCertPlace : '' %>">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>Classe *</label>
          <select name="classId" id="classIdSelect" required>
            <option value="">— Choisir —</option>
            <% classes.forEach(function(c) { %>
              <option value="<%= c.id %>" <%= student && student.classId === c.id ? 'selected' : '' %>><%= c.name %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Statut</label>
          <select name="enrollmentStatus">
            <% enrollmentStatusOptions.forEach(function(opt) { %>
              <option value="<%= opt.value %>" <%= (enrollment && enrollment.enrollmentStatus === opt.value) || (!enrollment && opt.value === 'NOUVEAU') ? 'selected' : '' %>><%= opt.label %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label>LV2</label>
          <select name="lv2">
            <% lv2Options.forEach(function(opt) { %>
              <option value="<%= opt.value %>" <%= enrollment && enrollment.lv2 === opt.value ? 'selected' : '' %>><%= opt.label %></option>
            <% }) %>
          </select>
        </div>
        <% if (cycle.hasLyceeSeries) { %>
        <div class="form-group">
          <label>Série</label>
          <select name="series">
            <option value="">Hériter de la classe</option>
            <% seriesOptions.forEach(function(opt) { %>
              <option value="<%= opt.value %>" <%= student && student.series === opt.value ? 'selected' : '' %>><%= opt.label %></option>
            <% }) %>
          </select>
        </div>
        <% } %>
      </div>
      <label class="checkbox-label">
        <input type="checkbox" name="repeatYear" <%= yearRecord && yearRecord.repeatYear ? 'checked' : '' %>> Redoublant
      </label>
      <label class="checkbox-label">
        <input type="checkbox" name="isScholarship" <%= enrollment && enrollment.isScholarship ? 'checked' : '' %>> Boursier
      </label>
    </div>

    <div class="card">
      <h2>Famille &amp; parcours</h2>
      <div class="form-group"><label>Père</label><input type="text" name="fatherName" value="<%= student && student.fatherName ? student.fatherName : '' %>"></div>
      <div class="form-group"><label>Mère</label><input type="text" name="motherName" value="<%= student && student.motherName ? student.motherName : '' %>"></div>
      <div class="form-group"><label>Tuteur</label><input type="text" name="guardianName" value="<%= student && student.guardianName ? student.guardianName : '' %>"></div>
      <div class="form-row">
        <div class="form-group"><label>Tél. tuteur</label><input type="tel" name="guardianPhone" value="<%= student && student.guardianPhone ? student.guardianPhone : '' %>"></div>
        <div class="form-group"><label>Contact</label><input type="tel" name="contactPhone" value="<%= student && student.contactPhone ? student.contactPhone : '' %>"></div>
      </div>
      <div class="form-group"><label>E-mail</label><input type="email" name="contactEmail" value="<%= student && student.contactEmail ? student.contactEmail : '' %>"></div>
      <hr>
      <div class="form-group"><label>N° décision statut</label><input type="text" name="decisionNumber" value="<%= enrollment && enrollment.decisionNumber ? enrollment.decisionNumber : '' %>"></div>
      <div class="form-group"><label>N° transfert / réaf.</label><input type="text" name="transferRef" value="<%= enrollment && enrollment.transferRef ? enrollment.transferRef : '' %>"></div>
      <div class="form-group"><label>Établissement d'origine</label><input type="text" name="previousSchool" value="<%= enrollment && enrollment.previousSchool ? enrollment.previousSchool : '' %>"></div>
      <div class="form-group"><label>Classe suivie</label><input type="text" name="previousClass" value="<%= enrollment && enrollment.previousClass ? enrollment.previousClass : '' %>"></div>
      <div class="form-group">
        <label>Photo</label>
        <% if (student && student.photoUrl) { %>
          <div class="avatar-edit"><%- include('../partials/_avatar', { src: student.photoUrl, firstName: student.firstName, lastName: student.lastName, size: 'md' }) %></div>
          <label class="checkbox-label"><input type="checkbox" name="removePhoto"> Supprimer la photo</label>
        <% } %>
        <input type="file" name="photo" accept="image/jpeg,image/png,image/webp">
      </div>
    </div>
  </div>

  <div class="card">
    <h2>Dossier — pièces fournies</h2>
    <div class="doc-checklist">
      <% enrollmentDocuments.forEach(function(doc) { %>
        <label class="checkbox-label doc-check">
          <input type="checkbox" name="doc_<%= doc.key %>" <%= documents[doc.key] ? 'checked' : '' %>>
          <%= doc.label %>
        </label>
      <% }) %>
    </div>
    <div class="form-group" style="margin-top:1rem">
      <label>Observations</label>
      <textarea name="notes" rows="3"><%= enrollment && enrollment.notes ? enrollment.notes : '' %></textarea>
    </div>
  </div>

  <% if (!isNew) { %>
  <div class="card">
    <h2>Certificats</h2>
    <p class="form-hint">Documents officiels à imprimer ou télécharger.</p>
    <div style="display:flex;flex-wrap:wrap;gap:0.5rem">
      <a href="/school/inscriptions/<%= student.id %>/certificat-scolarite.pdf" class="btn btn-outline btn-sm" target="_blank" rel="noopener">Certificat de scolarité</a>
      <a href="/school/inscriptions/<%= student.id %>/attestation-inscription.pdf" class="btn btn-outline btn-sm" target="_blank" rel="noopener">Attestation d'inscription</a>
    </div>
  </div>
  <% } %>

  <div class="form-actions">
    <button type="submit" class="btn btn-primary btn-lg">Enregistrer la fiche</button>
    <a href="/school/inscriptions" class="btn btn-outline">Annuler</a>
  </div>
</form>

<style>
.inscription-header-row { display:flex; flex-wrap:wrap; gap:1.5rem; align-items:flex-end; }
.effectif-box { background:#ecfdf5; border:1px solid #a7f3d0; padding:0.75rem 1rem; border-radius:8px; display:flex; gap:1rem; font-size:0.9rem; }
.effectif-label { font-weight:600; margin-right:0.5rem; }
.doc-checklist { display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:0.5rem 1rem; }
.doc-check { margin:0; }
.inscription-grid { align-items:start; }
.inscription-grid .card { min-width:0; overflow:hidden; }
.input-with-action { position:relative; display:block; }
.input-with-action input { width:100%; padding-right:2.25rem; box-sizing:border-box; }
.input-action-btn {
  position:absolute; right:4px; top:50%; transform:translateY(-50%);
  width:1.75rem; height:1.75rem; padding:0; border:1px solid #cbd5e1; border-radius:6px;
  background:#f8fafc; color:#0052CC; font-size:0.85rem; line-height:1; cursor:pointer;
}
.input-action-btn:hover { background:#eff6ff; border-color:#0052CC; }
</style>

<script>
(function () {
  var sel = document.getElementById('classIdSelect');
  if (!sel) return;
  function refreshEffectif() {
    var classId = sel.value;
    if (!classId) return;
    fetch('/school/inscriptions/effectif?classId=' + encodeURIComponent(classId), { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (d) {
        var m = document.getElementById('effM');
        var f = document.getElementById('effF');
        var t = document.getElementById('effT');
        if (m) m.textContent = d.male;
        if (f) f.textContent = d.female;
        if (t) t.textContent = d.total;
      })
      .catch(function () {});
  }
  sel.addEventListener('change', refreshEffectif);

  var menBtn = document.getElementById('menLookupBtn');
  var menInput = document.getElementById('nationalMatriculeInput');
  if (menBtn && menInput) {
    menBtn.addEventListener('click', function () {
      var v = menInput.value.trim();
      if (!v) return;
      window.location.href = '/school/inscriptions/recherche?men=' + encodeURIComponent(v);
    });
  }
})();
</script>
<% } %>
