<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('emargements', { _inLayout: true }); %>
<%- include('../layouts/schoolLayout', { body: content, title: 'Émargement' }) %>
<% } else { %>
<div class="page-header">
  <div>
    <h1>Listes d’émargement</h1>
    <p class="page-sub">Feuille de présence imprimable — appel, composition, examen blanc ou national</p>
  </div>
  <% if (classId) { %>
    <div class="page-header-actions">
      <a class="btn btn-outline" href="/school/emargements/imprimer?<%= qs %>">Imprimer</a>
      <a class="btn btn-outline" href="/school/emargements.pdf?<%= qs %>">PDF</a>
    </div>
  <% } %>
</div>

<% if (error === 'class') { %><div class="alert alert-error">Choisissez une classe.</div><% } %>
<% if (error === 'date') { %><div class="alert alert-error">Date invalide (AAAA-MM-JJ ou JJ/MM/AAAA).</div><% } %>
<% if (error === 'pdf') { %><div class="alert alert-error">Impossible de générer le PDF.</div><% } %>
<% if (error === 'data') { %><div class="alert alert-error">Impossible d’afficher la liste.</div><% } %>

<div class="card" style="margin-bottom:1rem">
  <form method="GET" action="/school/emargements" class="form form-inline">
    <div class="form-group">
      <label for="classId">Classe</label>
      <select id="classId" name="classId" required>
        <% if (!classes.length) { %><option value="">Aucune classe</option><% } %>
        <% classes.forEach(function(c) { %>
          <option value="<%= c.id %>" <%= classId === c.id ? 'selected' : '' %>><%= c.name %></option>
        <% }) %>
      </select>
    </div>
    <div class="form-group">
      <label for="date">Date</label>
      <input type="date" id="date" name="date" value="<%= date %>" required>
    </div>
    <div class="form-group">
      <label for="kind">Type</label>
      <select id="kind" name="kind">
        <% kinds.forEach(function(k) { %>
          <option value="<%= k.value %>" <%= kind === k.value ? 'selected' : '' %>><%= k.label %></option>
        <% }) %>
      </select>
    </div>
    <div class="form-group" id="subjectGroup">
      <label for="subject">Matière</label>
      <input type="text" id="subject" name="subject" list="subjectList" value="<%= subject %>" placeholder="Ex. Mathématiques" autocomplete="off">
      <datalist id="subjectList">
        <% (subjects || []).forEach(function(s) { %>
          <option value="<%= s.name %>"></option>
        <% }) %>
      </datalist>
    </div>
    <div class="form-group" id="termGroup">
      <label for="term">Trimestre</label>
      <select id="term" name="term">
        <% terms.forEach(function(t) { %>
          <option value="<%= t.value %>" <%= term === t.value ? 'selected' : '' %>><%= t.label %></option>
        <% }) %>
      </select>
    </div>
    <% if (typeof hasSeries !== 'undefined' && hasSeries) { %>
    <div class="form-group">
      <label for="series">Série</label>
      <select id="series" name="series">
        <option value="" <%= !series ? 'selected' : '' %>>Toutes</option>
        <% (typeof seriesOptions !== 'undefined' ? seriesOptions : []).forEach(function(opt) { %>
          <option value="<%= opt.value %>" <%= series === opt.value ? 'selected' : '' %>><%= opt.label %></option>
        <% }) %>
      </select>
    </div>
    <% } %>
    <div class="form-group">
      <label for="room">Salle</label>
      <input type="text" id="room" name="room" value="<%= room %>" placeholder="Ex. Salle 12" autocomplete="off">
    </div>
    <button type="submit" class="btn btn-primary">Afficher</button>
  </form>
  <p class="form-hint">
    Imprimez la feuille pour le jour de composition ou d’examen : les élèves émargent, le surveillant coche Présent / Absent.
    Choisissez « Examen blanc » ou « Examen national » pour le distinguer clairement. Pour un appel quotidien, choisissez « Appel du jour ».
  </p>
</div>

<% if (!classes.length) { %>
  <p class="empty">Créez d’abord une classe.</p>
<% } else if (!rows.length) { %>
  <p class="empty">Aucun élève dans cette classe<% if (series) { %> pour cette série<% } %>.</p>
<% } else { %>
  <div class="card">
    <h2><%= titleSheet %></h2>
    <p class="page-sub"><%= subtitle %></p>
    <p class="form-hint">
      Effectif <%= counts.total %>
      · Garçons <%= counts.boys %>
      · Filles <%= counts.girls %>
      <% if (counts.unknown) { %>· Genre non renseigné <%= counts.unknown %><% } %>
    </p>
    <div class="table-scroll">
      <table class="table emargement-table">
        <thead>
          <tr>
            <th>N°</th>
            <th>Nom</th>
            <th>Prénom</th>
            <th>Mat. école</th>
            <th>Mat. national</th>
            <th>G/F</th>
            <th>Présence</th>
            <th>Signature</th>
            <th>Observation</th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function(r) { %>
            <tr>
              <td><%= r.n %></td>
              <td><%= r.lastName %></td>
              <td><%= r.firstName %></td>
              <td><%= r.matricule || '—' %></td>
              <td><%= r.nationalMatricule || '—' %></td>
              <td><%= r.genderCell %></td>
              <td class="emargement-check">☐ P &nbsp; ☐ A</td>
              <td class="emargement-sig"></td>
              <td class="emargement-sig"></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
<% } %>

<script>
(function () {
  var kind = document.getElementById('kind');
  var subjectGroup = document.getElementById('subjectGroup');
  var termGroup = document.getElementById('termGroup');
  function sync() {
    var appel = kind && kind.value === 'APPEL';
    if (subjectGroup) subjectGroup.hidden = appel;
    if (termGroup) termGroup.hidden = appel;
  }
  if (kind) kind.addEventListener('change', sync);
  sync();
})();
</script>
<% } %>
