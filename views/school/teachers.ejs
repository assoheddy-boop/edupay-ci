<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('teachers', { _inLayout: true }); %>
<%- include('../layouts/schoolLayout', { body: content, title: 'Enseignants' }) %>
<% } else { %>
<div class="page-header">
    <h1>Enseignants</h1>
    <p class="page-sub">Code école : <code><%= school.slug %></code> — ou invitez directement un enseignant</p>
  </div>

  <% if (success === 'photo') { %><div class="alert alert-success">Photo mise à jour.</div><% } %>
  <% if (error === 'photo') { %><div class="alert alert-error">Impossible d'enregistrer la photo.</div><% } %>
  <% if (success === '1') { %><div class="alert alert-success">Classe assignée.</div><% } %>
  <% if (error === 'email' || error === 'phone') { %><div class="alert alert-error">Un compte existe déjà avec cet email ou ce téléphone.</div><% } %>

  <div class="card" style="margin-bottom:1.5rem">
    <h2>Inviter / créer un enseignant</h2>
    <form method="POST" action="/school/teachers/invite" class="form" enctype="multipart/form-data" data-offline-queue="teacher" data-offline-file="photo">
      <div class="form-row">
        <div class="form-group"><label>Prénom</label><input type="text" name="firstName" required></div>
        <div class="form-group"><label>Nom</label><input type="text" name="lastName" required></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Email</label><input type="email" name="email" required></div>
        <div class="form-group"><label>Téléphone</label><input type="tel" name="phone"></div>
      </div>
      <div class="form-row">
        <div class="form-group"><label>Matière</label><input type="text" name="subject" placeholder="Mathématiques"></div>
        <div class="form-group"><label>Mot de passe temporaire (optionnel)</label><input type="text" name="password" placeholder="Généré automatiquement si vide"></div>
      </div>
        <div class="form-group"><label>Photo</label><input type="file" name="photo" accept="image/jpeg,image/png,image/webp"></div>
      <button type="submit" class="btn btn-primary">Créer le compte enseignant</button>
    </form>
  </div>

  <div class="card">
    <% if (teachers.length === 0) { %>
      <p class="empty">Aucun enseignant. Invitez-en un ou partagez le code école <code><%= school.slug %></code>.</p>
    <% } else { %>
      <% teachers.forEach(t => { %>
        <div class="teacher-row">
          <div class="person-line">
            <%- include('../partials/_avatar', { src: t.user.photoUrl, firstName: t.user.firstName, lastName: t.user.lastName, size: 'md' }) %>
            <div>
            <strong><%= t.user.firstName %> <%= t.user.lastName %></strong>
            <p class="page-sub"><%= t.user.email %> — <%= t.subject || 'Matière non définie' %></p>
            <p>Classes : <%= t.classes.length ? t.classes.map(c => c.class.name).join(', ') : 'Aucune' %></p>
            <form method="POST" action="/school/teachers/<%= t.id %>/photo" enctype="multipart/form-data" class="form form-inline" style="margin-top:0.5rem" data-offline-skip="1">
              <input type="file" name="photo" accept="image/jpeg,image/png,image/webp" required>
              <button type="submit" class="btn btn-outline btn-sm">Photo</button>
            </form>
            </div>
          </div>
          <form method="POST" action="/school/teachers/<%= t.id %>/classes" class="form form-inline" data-offline-skip="1">
            <select name="classId" required>
              <option value="">Assigner à…</option>
              <% classes.forEach(c => { %>
                <option value="<%= c.id %>"><%= c.name %></option>
              <% }) %>
            </select>
            <button type="submit" class="btn btn-primary btn-sm">Assigner</button>
          </form>
          <a href="/school/hr/staff/<%= t.id %>" class="btn btn-outline btn-sm">Dossier RH</a>
        </div>
        <hr class="form-divider">
      <% }) %>
    <% } %>
  </div>
<% } %>
