<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('lost-items', { _inLayout: true }); %>
<%- include('../layouts/schoolLayout', { body: content, title: 'Objets perdus' }) %>
<% } else { %>
<div class="page-header"><h1>🧸 Objets perdus</h1></div>
  <% if (success) { %><div class="alert alert-success"><%= success === 'claimed' ? 'Objet récupéré.' : 'Objet enregistré — parent notifié si élève identifié.' %></div><% } %>

  <div class="grid-2">
    <div class="card">
      <form method="POST" action="/school/lost-items" enctype="multipart/form-data" class="form">
        <div class="form-group">
          <label>Description</label>
          <input type="text" name="description" required placeholder="Ex: Sac bleu, cahier maths…">
        </div>
        <div class="form-group">
          <label>Élève concerné (optionnel)</label>
          <select name="studentId">
            <option value="">— Inconnu —</option>
            <% students.forEach(s => { %>
              <option value="<%= s.id %>"><%= s.firstName %> <%= s.lastName %></option>
            <% }) %>
          </select>
        </div>
        <div class="form-group">
          <label>Photo</label>
          <input type="file" name="photo" accept="image/*">
        </div>
        <button type="submit" class="btn btn-primary">Enregistrer</button>
      </form>
    </div>
    <div class="card">
      <h2>Objets trouvés</h2>
      <% if (items.length === 0) { %><p class="empty">Aucun objet.</p><% } else { %>
        <% items.forEach(item => { %>
          <div class="lost-item <%= item.claimed ? 'lost-claimed' : '' %>">
            <strong><%= item.description %></strong>
            <% if (item.student) { %><p>Possiblement : <%= item.student.firstName %> <%= item.student.lastName %></p><% } %>
            <% if (item.photoUrl) { %><a href="<%= item.photoUrl %>" target="_blank" class="btn btn-sm btn-outline">Voir photo</a><% } %>
            <% if (!item.claimed) { %>
              <form method="POST" action="/school/lost-items/<%= item.id %>/claim" style="display:inline">
                <button type="submit" class="btn btn-sm btn-success">Marquer récupéré</button>
              </form>
            <% } else { %><span class="badge-status badge-validated">Récupéré</span><% } %>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>
<% } %>
