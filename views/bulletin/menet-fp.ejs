<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bulletin MENET-FP — <%= student.firstName %> <%= student.lastName %></title>
  <link rel="stylesheet" href="/css/portal.css">
  <style>
    body { background: #f5f5f5; font-family: Arial, Helvetica, sans-serif; color: #000; }
    .bulletin-sheet { max-width: 820px; margin: 1rem auto; background: #fff; padding: 1.25rem; box-shadow: 0 2px 12px rgba(0,0,0,.08); }
    .bulletin-toolbar { max-width: 820px; margin: 1rem auto 0; display: flex; gap: .5rem; flex-wrap: wrap; }
    .bulletin-header { display: flex; gap: .75rem; align-items: flex-start; margin-bottom: .5rem; }
    .bulletin-logo { width: 56px; height: 56px; object-fit: contain; }
    .bulletin-title { border: 3px double #000; text-align: center; font-weight: 700; padding: .45rem; margin: .5rem 0; font-size: .95rem; }
    .bulletin-grid { display: grid; grid-template-columns: 1.2fr 1fr; border: 1px solid #000; margin-bottom: .35rem; }
    .bulletin-grid > div { padding: .45rem .55rem; font-size: .78rem; }
    .bulletin-grid > div + div { border-left: 1px solid #000; }
    .bulletin-student { border: 1px solid #000; padding: .45rem .55rem; font-size: .78rem; margin-bottom: .5rem; display: grid; grid-template-columns: 1fr 1fr; gap: .25rem .75rem; }
    .bulletin-table { width: 100%; border-collapse: collapse; font-size: .74rem; }
    .bulletin-table th, .bulletin-table td { border: 1px solid #000; padding: .25rem .3rem; text-align: center; }
    .bulletin-table th.discipline, .bulletin-table td.discipline { text-align: left; }
    .bulletin-summary { border: 1px solid #000; margin-top: .5rem; font-size: .76rem; }
    .bulletin-summary-row { display: grid; grid-template-columns: 1fr 1fr; border-bottom: 1px solid #000; }
    .bulletin-summary-row > div { padding: .35rem .5rem; }
    .bulletin-summary-row > div + div { border-left: 1px solid #000; }
    .bulletin-bilans { display: grid; grid-template-columns: repeat(3, 1fr); gap: .35rem; padding: .35rem .5rem .5rem; font-size: .74rem; font-weight: 700; }
    .bulletin-footer { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin-top: .75rem; border: 1px solid #000; }
    .bulletin-footer > div { padding: .45rem; text-align: center; font-size: .72rem; min-height: 5rem; border-right: 1px solid #000; }
    .bulletin-footer > div:last-child { border-right: 0; }
    .bulletin-footer img { max-height: 2.5rem; max-width: 90%; object-fit: contain; }
    .bulletin-legal { margin-top: .65rem; font-size: .68rem; text-align: center; color: #333; }
    @media print {
      body { background: #fff; }
      .bulletin-toolbar { display: none; }
      .bulletin-sheet { box-shadow: none; margin: 0; max-width: none; }
    }
  </style>
</head>
<body>
  <div class="bulletin-toolbar">
    <a href="/school/bulletins" class="btn btn-outline">← Retour bulletins</a>
    <a href="/school/bulletins/download/<%= student.id %>?period=<%= encodeURIComponent(term) %>" class="btn btn-primary">Télécharger PDF</a>
    <button type="button" class="btn btn-outline" onclick="window.print()">Imprimer</button>
  </div>

  <article class="bulletin-sheet">
    <header class="bulletin-header">
      <% if (logoSrc) { %><img src="<%= logoSrc %>" alt="Logo" class="bulletin-logo"><% } %>
      <div>
        <strong><%= (school.name || '').toUpperCase() %></strong><br>
        <%= [school.address, school.city].filter(Boolean).join(' — ') %><br>
        <% if (school.dren) { %><%= school.dren %><br><% } %>
        <% if (school.menetCode) { %>Code : <%= school.menetCode %> · <% } %>Statut : <%= statut %>
      </div>
    </header>

    <div class="bulletin-title"><%= termTitle %></div>
    <div style="text-align:right;font-size:.78rem;font-weight:700;margin-bottom:.35rem">Année scolaire : <%= schoolYear %></div>

    <div class="bulletin-grid">
      <div>
        <strong><%= (school.name || '').toUpperCase() %></strong><br>
        <%= [school.address, school.city].filter(Boolean).join(' — ') %>
      </div>
      <div>
        <strong>Classe : <%= student.class.name %></strong><br>
        Effectif : <%= classSize || '—' %><br>
        Redouble : <%= formatRepeatLabel(repeatYear) %>
      </div>
    </div>

    <div class="bulletin-student">
      <div><strong>Nom et prénoms :</strong> <%= (student.lastName || '').toUpperCase() %> <%= (student.firstName || '').toUpperCase() %></div>
      <div><strong>Matricule DREN :</strong> <%= student.nationalMatricule || '—' %></div>
      <div><strong>Sexe :</strong> <%= formatGenderShort(student.gender) %></div>
      <div><strong>Mle Ets :</strong> <%= student.matricule || '—' %></div>
      <div><strong>Né le :</strong> <%= formatBirthDate(student.birthDate) %> · <strong>à :</strong> <%= student.birthPlace || '—' %></div>
      <div><strong>Nationalité :</strong> <%= student.nationality || '—' %></div>
    </div>

    <table class="bulletin-table">
      <thead>
        <tr>
          <th class="discipline" rowspan="2">DISCIPLINE</th>
          <th rowspan="2">MOY/20</th>
          <th rowspan="2">Coef</th>
          <th rowspan="2">Moy Coef</th>
          <th rowspan="2">Rang</th>
          <th colspan="2">PROFESSEURS</th>
          <th rowspan="2">Appréciations et signature</th>
        </tr>
        <tr>
          <th>NOM</th>
          <th>PRENOMS</th>
        </tr>
      </thead>
      <tbody>
        <% rows.forEach(function(row) { %>
          <tr>
            <td class="discipline"><%= row.subject %></td>
            <td><%= formatGrade(row.average) %></td>
            <td><%= row.coefficient != null ? row.coefficient : '' %></td>
            <td><%= row.average != null && row.coefficient != null ? formatGrade(row.average * row.coefficient) : '' %></td>
            <td><%= row.rank ? formatRankCi(row.rank) : '' %></td>
            <td><%= (row.teacherName || '').split(' ').slice(0, -1).join(' ') %></td>
            <td><%= (row.teacherName || '').split(' ').slice(-1)[0] || '' %></td>
            <td><%= row.comment || '' %></td>
          </tr>
        <% }) %>
        <tr>
          <td class="discipline"><strong>TOTAUX TRIMESTRE</strong></td>
          <td><strong><%= formatGrade(average) %></strong></td>
          <td></td>
          <td></td>
          <td><strong><%= rank ? formatRankCi(rank) : '' %></strong></td>
          <td colspan="3"></td>
        </tr>
      </tbody>
    </table>

    <section class="bulletin-summary">
      <div class="bulletin-summary-row">
        <div>
          <strong><%= termAverageLabel %> : <%= formatGrade(average) %>/20 /<%= classSize || '—' %></strong><br>
          Rang : <%= rank ? formatRankCi(rank) : '—' %><br>
          M. basse : <%= formatGrade(classStats && classStats.lowest) %>
        </div>
        <div>
          M. classe : <%= formatGrade(classStats && classStats.classAverage) %><br>
          M. élève : <%= formatGrade(average) %><br>
          Heure(s) d'absence : <%= absencesSummary %>
        </div>
      </div>
      <div class="bulletin-bilans">
        <span>Bilan Lettres : <%= formatGrade(domainBilans && domainBilans.LETTRES) %></span>
        <span>Bilan Sciences : <%= formatGrade(domainBilans && domainBilans.SCIENCES) %></span>
        <span>Bilan Autres : <%= formatGrade(domainBilans && domainBilans.AUTRES) %></span>
      </div>
    </section>

    <footer class="bulletin-footer">
      <div>
        <strong>PROFESSEUR PRINCIPAL</strong><br>
        <%= homeroomTeacherName || '—' %><br>
        Appréciation, Signature
      </div>
      <div>
        <strong>VISA DU DIRECTEUR DES ETUDES</strong><br>
        <% if (directorStampSrc) { %><img src="<%= directorStampSrc %>" alt="Cachet"><% } else if (directorSignatureSrc) { %><img src="<%= directorSignatureSrc %>" alt="Signature"><% } %>
        <br>SIGNATURE
      </div>
      <div>
        <strong>DISTINCTION OU SANCTION</strong><br>
        <%= distinction || '—' %>
      </div>
    </footer>

    <p style="text-align:right;font-size:.74rem;margin-top:.5rem"><%= school.city || 'Abidjan' %>, le <%= new Date().toLocaleDateString('fr-FR') %></p>
    <p class="bulletin-legal">NB : Si la conduite annuelle est inférieure à 10, l'élève est automatiquement exclu de l'école</p>
    <p class="bulletin-legal"><em>Aucun duplicata ne sera délivré</em></p>
  </article>
  <% if (printMode) { %><script>window.print()</script><% } %>
</body>
</html>
