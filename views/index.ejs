<%- include('partials/head') %>
<%- include('partials/header', { user: null }) %>
<main class="container">
<% if (typeof showDemoAccounts !== 'undefined' && showDemoAccounts) { %>
<div class="demo-banner">
  <strong>Démo :</strong> École <code>ecole@demo.ci</code> · Parent <code>parent@demo.ci</code> · Prof <code>prof@demo.ci</code> · Groupe <code>groupe@demo.ci</code> — mot de passe <code>demo1234</code>
</div>
<% } %>

<section class="hero">
  <div class="hero-content">
    <span class="badge">🇨🇮 Côte d'Ivoire</span>
    <h1>Gestion scolaire moderne &amp; paiements simplifiés</h1>
    <p class="hero-sub">Appel Présent / Retard / Absent, notes visibles par les parents, paiements Wave ou Orange Money.</p>
    <div class="hero-actions">
      <a href="/auth/register?role=SCHOOL_ADMIN" class="btn btn-primary btn-lg">Créer mon école</a>
      <a href="#tarifs" class="btn btn-outline btn-lg">Voir les offres</a>
      <a href="/auth/register?role=PARENT" class="btn btn-success btn-lg">Espace parent</a>
    </div>
  </div>
  <div class="hero-features">
    <div class="feature-card">
      <span class="feature-icon">💳</span>
      <h3>Paiements Wave/OM</h3>
      <p>Preuve uploadée, validation par l'école. Simple et efficace.</p>
    </div>
    <div class="feature-card">
      <span class="feature-icon">📊</span>
      <h3>Notes & bulletins</h3>
      <p>Suivi scolaire complet avec génération PDF.</p>
    </div>
    <div class="feature-card">
      <span class="feature-icon">✅</span>
      <h3>Appel en 3 boutons</h3>
      <p>Présent, retard ou absent. Les parents voient le statut le jour même.</p>
    </div>
    <div class="feature-card">
      <span class="feature-icon">👨‍👩‍👧</span>
      <h3>Sans écran pour l'enfant</h3>
      <p>Les parents reçoivent tout : notes, absences, alertes Wave/OM.</p>
    </div>
  </div>
</section>

<section class="pricing" id="tarifs">
  <div class="section-intro">
    <h2>Plans d'adhésion</h2>
    <p>Choisissez les modules dont votre établissement a besoin. Activez ou désactivez chaque module premium depuis votre espace — contrôlé par le Super Admin EduConnect.</p>
  </div>

  <div class="pricing-grid">
    <% plans.filter(p => !p.isGroup).forEach(function(plan) { %>
      <article class="pricing-card <%= plan.highlight ? 'pricing-card-featured' : '' %>">
        <% if (plan.badge) { %><span class="pricing-badge"><%= plan.badge %></span><% } %>
        <h3><%= plan.name %></h3>
        <p class="pricing-tagline"><%= plan.tagline %></p>
        <div class="pricing-price">
          <span class="pricing-amount"><%= plan.priceLabel %></span>
          <% if (plan.price !== null && plan.price > 0) { %>
            <span class="pricing-period"><%= plan.period %></span>
          <% } else if (plan.price === 0) { %>
            <span class="pricing-period"><%= plan.period %></span>
          <% } %>
        </div>
        <p class="pricing-limits"><%= plan.limits %></p>
        <ul class="pricing-modules">
          <% plan.moduleFlags.filter(m => m.included).slice(0, 8).forEach(function(m) { %>
            <li><span class="check">✓</span> <%= m.label %></li>
          <% }) %>
          <% const extra = plan.moduleFlags.filter(m => m.included).length - 8; %>
          <% if (extra > 0) { %>
            <li class="pricing-more">+ <%= extra %> autre<%= extra > 1 ? 's' : '' %> module<%= extra > 1 ? 's' : '' %></li>
          <% } %>
        </ul>
        <a href="<%= plan.ctaHref %>" class="btn <%= plan.highlight ? 'btn-primary' : 'btn-outline' %> btn-block"><%= plan.cta %></a>
      </article>
    <% }) %>
  </div>
</section>

<section class="module-compare">
  <div class="section-intro">
    <h2>Modules par offre</h2>
    <p>Comparez ce qui est inclus dans chaque plan. Les modules marqués <strong>—</strong> peuvent être ajoutés en passant à l'offre supérieure.</p>
  </div>
  <div class="compare-wrap">
    <table class="compare-table">
      <thead>
        <tr>
          <th>Module</th>
          <% plans.filter(p => !p.isGroup).forEach(function(plan) { %>
            <th><%= plan.name %></th>
          <% }) %>
        </tr>
      </thead>
      <tbody>
        <% moduleList.forEach(function(mod) { %>
          <% if (mod.key === 'multi_campus') return; %>
          <tr>
            <td>
              <strong><%= mod.label %></strong>
              <% if (mod.core) { %><span class="compare-core">Base</span><% } %>
            </td>
            <% plans.filter(p => !p.isGroup).forEach(function(plan) { %>
              <% const included = plan.moduleFlags.find(m => m.key === mod.key)?.included; %>
              <td class="compare-cell <%= included ? 'yes' : 'no' %>"><%= included ? '✓' : '—' %></td>
            <% }) %>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</section>

<section class="group-offer" id="groupe-scolaire">
  <% const groupe = plans.find(p => p.isGroup); %>
  <div class="group-layout">
    <div class="group-content">
      <span class="badge badge-group">🏛️ Groupes & réseaux</span>
      <h2><%= groupe.name %></h2>
      <p class="group-lead">Vous gérez plusieurs établissements ? EduConnect regroupe vos campus sous une même direction avec une vue consolidée et des modules activables campus par campus.</p>
      <ul class="group-perks">
        <% groupe.perks.forEach(function(perk) { %>
          <li><span class="check">✓</span> <%= perk %></li>
        <% }) %>
      </ul>
      <div class="group-price">
        <strong><%= groupe.priceLabel %></strong>
        <span><%= groupe.period %></span>
      </div>
      <div class="group-actions">
        <a href="<%= groupe.ctaHref %>" class="btn btn-primary btn-lg"><%= groupe.cta %></a>
        <a href="/auth/login" class="btn btn-outline">Déjà client groupe</a>
      </div>
      <% if (typeof showDemoAccounts !== 'undefined' && showDemoAccounts) { %>
      <p class="group-demo">Compte démo : <code>groupe@demo.ci</code> / <code>demo1234</code></p>
      <% } %>
    </div>
    <div class="group-visual card">
      <h3>Vue consolidée</h3>
      <div class="group-mock-stats">
        <div class="group-mock-stat"><span>3</span><small>Campus</small></div>
        <div class="group-mock-stat"><span>840</span><small>Élèves</small></div>
        <div class="group-mock-stat"><span>12,4M</span><small>Recettes</small></div>
      </div>
      <table class="table table-compact">
        <thead><tr><th>Campus</th><th>Élèves</th><th>RH</th><th>Compta</th></tr></thead>
        <tbody>
          <tr><td>Cocody</td><td>320</td><td>✓</td><td>✓</td></tr>
          <tr><td>Yopougon</td><td>280</td><td>✓</td><td>—</td></tr>
          <tr><td>Bingerville</td><td>240</td><td>—</td><td>✓</td></tr>
        </tbody>
      </table>
      <p class="group-visual-note">Chaque campus garde son autonomie ; le groupe pilote la stratégie.</p>
    </div>
  </div>
</section>

<section class="modules">
  <h2>Pour chaque acteur</h2>
  <div class="modules-grid">
    <div class="module-card">
      <h3>🏫 École</h3>
      <ul>
        <li>Classes, élèves, enseignants</li>
        <li>Validation des paiements</li>
        <li>Modules premium à la carte</li>
      </ul>
    </div>
    <div class="module-card">
      <h3>👨‍👩‍👧 Parent</h3>
      <ul>
        <li>Paiement Wave/OM</li>
        <li>Consultation notes & bulletins</li>
        <li>Notifications & chat</li>
      </ul>
    </div>
    <div class="module-card">
      <h3>👩‍🏫 Enseignant</h3>
      <ul>
        <li>Saisie notes & absences</li>
        <li>Messages aux parents</li>
        <li>Espace RH (plan Pro)</li>
      </ul>
    </div>
  </div>
  <p class="landing-cta-sub">Pas encore inscrit ? <a href="/auth/register?role=TEACHER">Espace enseignant</a> · <a href="/auth/register?role=PARENT">Espace parent</a></p>
</section>
</main>
<%- include('partials/footer') %>
<%- include('partials/scripts') %>
