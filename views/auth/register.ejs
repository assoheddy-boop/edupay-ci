<%- include('../partials/head') %>
<%- include('../partials/header', { user: null }) %>
<main class="container">
<div class="auth-page">
  <div class="auth-card auth-card-wide">
    <h1>Inscription</h1>
    <p class="auth-sub">Créez votre compte EduPay CI</p>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <div class="role-tabs role-tabs-top">
      <a href="/auth/register?role=SCHOOL_ADMIN" class="<%= role === 'SCHOOL_ADMIN' ? 'active' : '' %>">École</a>
      <a href="/auth/register?role=PARENT" class="<%= role === 'PARENT' || role === 'parent' ? 'active' : '' %>">Parent</a>
      <a href="/auth/register?role=TEACHER" class="<%= role === 'TEACHER' ? 'active' : '' %>">Enseignant</a>
    </div>

    <form method="POST" action="/auth/register" class="form">
      <input type="hidden" name="role" value="<%= role === 'parent' ? 'PARENT' : role %>">

      <div class="form-row">
        <div class="form-group">
          <label for="firstName">Prénom</label>
          <input type="text" id="firstName" name="firstName" required>
        </div>
        <div class="form-group">
          <label for="lastName">Nom</label>
          <input type="text" id="lastName" name="lastName" required>
        </div>
      </div>

      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required>
      </div>

      <div class="form-group">
        <label for="phone">Téléphone</label>
        <input type="tel" id="phone" name="phone" placeholder="07 XX XX XX XX">
      </div>

      <div class="form-group">
        <label for="password">Mot de passe</label>
        <input type="password" id="password" name="password" required minlength="6">
      </div>

      <% if (role === 'SCHOOL_ADMIN') { %>
        <hr class="form-divider">
        <h3>Informations école</h3>
        <div class="form-group">
          <label for="schoolName">Nom de l'école</label>
          <input type="text" id="schoolName" name="schoolName" required>
        </div>
        <div class="form-group">
          <label for="schoolAddress">Adresse</label>
          <input type="text" id="schoolAddress" name="schoolAddress">
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="waveNumber">Numéro Wave</label>
            <input type="text" id="waveNumber" name="waveNumber" placeholder="07 XX XX XX XX">
          </div>
          <div class="form-group">
            <label for="omNumber">Numéro Orange Money</label>
            <input type="text" id="omNumber" name="omNumber" placeholder="07 XX XX XX XX">
          </div>
        </div>
      <% } %>

      <% if (role === 'TEACHER') { %>
        <div class="form-group">
          <label for="schoolCode">Code école (fourni par l'administration)</label>
          <input type="text" id="schoolCode" name="schoolCode" required placeholder="Ex: ecole-les-etoiles">
        </div>
      <% } %>

      <button type="submit" class="btn btn-primary btn-block btn-lg">Créer mon compte</button>
    </form>

    <p class="auth-link">Déjà inscrit ? <a href="/auth/login?role=<%= role %>">Se connecter</a></p>
  </div>
</div>
</main>
<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
