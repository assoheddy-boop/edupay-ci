<%- include('../partials/head') %>
<%- include('../partials/header', { user: null }) %>
<main class="container">
<div class="auth-page">
  <div class="auth-card">
    <h1>Connexion</h1>
    <p class="auth-sub">Accédez à votre espace EduConnect</p>

    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

    <% if (typeof showDemoAccounts !== 'undefined' && showDemoAccounts) { %>
    <div class="demo-banner" style="margin-bottom:1rem;font-size:0.85rem">
      <strong>Comptes démo :</strong><br>
      Admin site <code>admin@educonnect.ci</code> · Groupe <code>groupe@demo.ci</code><br>
      Parent <code>parent@demo.ci</code> · École <code>ecole@demo.ci</code> · Prof <code>prof@demo.ci</code><br>
      Mot de passe : <code>demo1234</code>
    </div>
    <% } %>

    <form method="POST" action="/auth/login" class="form">
      <input type="hidden" name="role" value="<%= role %>">

      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required placeholder="votre@email.com">
      </div>

      <div class="form-group">
        <label for="password">Mot de passe</label>
        <input type="password" id="password" name="password" required placeholder="••••••••">
      </div>

      <button type="submit" class="btn btn-primary btn-block btn-lg">Se connecter</button>
    </form>

    <p class="auth-link">Pas encore de compte ? <a href="/auth/register?role=<%= role %>">S'inscrire</a></p>

    <p class="auth-sub" style="margin-top:1rem;font-size:0.85rem">
      Secrétariat, comptabilité, éducateur et vie scolaire : onglet <strong>École</strong>.
    </p>
    <div class="role-tabs">
      <a href="/auth/login?role=parent" class="<%= role === 'parent' ? 'active' : '' %>">Parent</a>
      <a href="/auth/login?role=student" class="<%= role === 'student' ? 'active' : '' %>">Élève</a>
      <a href="/auth/login?role=SCHOOL_ADMIN" class="<%= role === 'SCHOOL_ADMIN' ? 'active' : '' %>">École</a>
      <a href="/auth/login?role=TEACHER" class="<%= role === 'TEACHER' ? 'active' : '' %>">Enseignant</a>
    </div>
  </div>
</div>
</main>
<%- include('../partials/footer') %>
<%- include('../partials/scripts') %>
