<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('homeworks', { _inLayout: true }); %>
<%- include('../layouts/parentLayout', { body: content, title: 'Devoirs & contrôles' }) %>
<% } else { %>
<div class="page-header">
    <h1>Devoirs & contrôles</h1>
    <p class="page-sub">Calendrier de la semaine et du mois — relais parent, sans écran pour l'enfant</p>
  </div>

  <div class="card hw-calendar-card">
    <h2>Calendrier</h2>
    <div id="homeworkCalendar" class="hw-calendar"></div>
  </div>

  <% if (children.length === 0) { %>
    <p class="empty">Liez d'abord un enfant depuis l'accueil.</p>
  <% } %>

  <% children.forEach(link => { const s = link.student; %>
    <div class="card">
      <h2><%= s.firstName %> <%= s.lastName %> — <%= s.class.name %></h2>
      <% if (s.homeworks.length === 0) { %>
        <p class="empty">Aucun devoir ni contrôle publié.</p>
      <% } else { %>
        <div class="homework-list">
          <% s.homeworks.sort((a,b) => new Date(b.homework.dueDate) - new Date(a.homework.dueDate)).forEach(sub => { const h = sub.homework; %>
            <div class="homework-item <%= h.kind === 'TEST' ? 'homework-test' : '' %> <%= new Date(h.dueDate) < new Date() ? 'homework-late' : '' %>">
              <div class="homework-header">
                <strong><span class="hw-badge <%= h.kind === 'TEST' ? 'hw-badge-test' : 'hw-badge-homework' %>"><%= h.kind === 'TEST' ? 'Contrôle' : 'Devoir' %></span> <%= h.title %></strong>
                <span class="badge"><%= h.kind === 'TEST' ? 'Le' : 'À rendre le' %> <%= new Date(h.dueDate).toLocaleDateString('fr-FR') %></span>
              </div>
              <% if (h.subject) { %><p class="hw-subject"><%= h.subject %></p><% } %>
              <% if (h.description) { %><p><%= h.description %></p><% } %>
              <small>Par <%= h.teacher.user.firstName %> <%= h.teacher.user.lastName %></small>
              <% if (h.attachmentUrl) { %>
                <a href="<%= h.attachmentUrl %>" target="_blank" class="btn btn-sm btn-outline">📎 Fiche</a>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  <% }) %>

  <%- include('../partials/_homeworkCalendar', { eventsJson: typeof calendarEventsJson !== 'undefined' ? calendarEventsJson : '[]', eventsUrl: '/parent/homeworks/events' }) %>
<% } %>
