<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('payments', { _inLayout: true }); %>
<%- include('../layouts/parentLayout', { body: content, title: 'Paiements' }) %>
<% } else { %>
<div class="page-header">
    <h1>Paiements</h1>
    <p class="page-sub">Payez via Wave ou Orange Money, puis téléversez la capture</p>
  </div>

  <% children.forEach(link => { const s = link.student; const school = s.class.school; %>
    <div class="payment-card">
      <h2><%= s.firstName %> <%= s.lastName %></h2>
      <p class="school-name"><%= school.name %></p>

      <div class="payment-info">
        <% if (school.waveNumber) { %>
          <div class="payment-method">
            <span class="method-icon">🌊</span>
            <div>
              <strong>Wave</strong>
              <p class="phone-number"><%= school.waveNumber %></p>
            </div>
          </div>
        <% } %>
        <% if (school.omNumber) { %>
          <div class="payment-method">
            <span class="method-icon">🟠</span>
            <div>
              <strong>Orange Money</strong>
              <p class="phone-number"><%= school.omNumber %></p>
            </div>
          </div>
        <% } %>
      </div>

      <form method="POST" action="/parent/payments" enctype="multipart/form-data" class="form">
        <input type="hidden" name="studentId" value="<%= s.id %>">
        <div class="form-row">
          <div class="form-group">
            <label for="amount-<%= s.id %>">Montant (FCFA)</label>
            <input type="number" id="amount-<%= s.id %>" name="amount" required min="100" placeholder="Ex: 25000">
          </div>
          <div class="form-group">
            <label for="reference-<%= s.id %>">Référence (optionnel)</label>
            <input type="text" id="reference-<%= s.id %>" name="reference">
          </div>
        </div>
        <div class="form-group">
          <label for="proof-<%= s.id %>">Capture d'écran du paiement</label>
          <input type="file" id="proof-<%= s.id %>" name="proof" accept="image/*" required>
        </div>
        <button type="submit" class="btn btn-success btn-lg btn-block">Envoyer la preuve de paiement</button>
      </form>

      <% if (s.payments.length > 0) { %>
        <h3>Historique</h3>
        <table class="table">
          <thead><tr><th>Montant</th><th>Statut</th><th>Date</th></tr></thead>
          <tbody>
            <% s.payments.forEach(p => { %>
              <tr>
                <td><%= p.amount.toLocaleString('fr-FR') %> FCFA</td>
                <td><span class="badge-status badge-<%= p.status.toLowerCase() %>"><%= p.status %></span></td>
                <td><%= new Date(p.createdAt).toLocaleDateString('fr-FR') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>
    </div>
  <% }) %>
<% } %>
