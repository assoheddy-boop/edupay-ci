<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('transport', { _inLayout: true }); %>
<%- include('../layouts/parentLayout', { body: content, title: 'Transport' }) %>
<% } else { %>
<div class="page-header">
  <h1>Transport</h1>
  <p class="page-sub">Suivi bus et trajets de vos enfants</p>
</div>
<% if (!children.length) { %><p class="empty">Aucun enfant lié.</p><% } %>
<% children.forEach(function(link) { const s = link.student; %>
  <div class="card">
    <h2><%= s.firstName %> <%= s.lastName %></h2>
    <% if (!s.transportLogs.length) { %><p class="empty">Aucun événement.</p><% } %>
    <ul class="timeline">
      <% s.transportLogs.forEach(function(l) { %>
        <li><%= transportLabels[l.event] || l.event %> — <small><%= new Date(l.createdAt).toLocaleString('fr-FR') %></small></li>
      <% }) %>
    </ul>
  </div>
<% }) %>
<% } %>
