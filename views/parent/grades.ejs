<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('grades', { _inLayout: true }); %>
<%- include('../layouts/parentLayout', { body: content, title: 'Notes' }) %>
<% } else { %>
<div class="page-header">
    <h1>Notes & bulletins</h1>
  </div>

  <% if (children.length === 0) { %>
    <p class="empty">Liez d'abord un enfant depuis l'accueil.</p>
  <% } %>

  <% children.forEach(link => { const s = link.student; %>
    <div class="card">
      <h2><%= s.firstName %> <%= s.lastName %> — <%= s.class.name %></h2>

      <% if (s.grades.length === 0) { %>
        <p class="empty">Aucune note publiée.</p>
      <% } else { %>
        <table class="table">
          <thead>
            <tr><th>Matière</th><th>Note</th><th>Période</th><th>Commentaire</th></tr>
          </thead>
          <tbody>
            <% s.grades.forEach(g => { %>
              <tr>
                <td><%= g.subject %></td>
                <td><strong><%= g.value %>/<%= g.maxValue %></strong></td>
                <td><%= g.period %></td>
                <td><%= g.comment || '—' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } %>

      <% if (s.bulletins.length > 0) { %>
        <h3>Bulletins</h3>
        <ul class="list">
          <% s.bulletins.forEach(b => { %>
            <li class="list-item">
              <span><%= b.period %></span>
              <% if (b.pdfUrl) { %><a href="<%= b.pdfUrl %>" class="btn btn-sm btn-outline">Télécharger PDF</a><% } %>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  <% }) %>
<% } %>
