<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('canteen', { _inLayout: true }); %>
<%- include('../layouts/parentLayout', { body: content, title: 'Cantine' }) %>
<% } else { %>
<div class="page-header">
  <h1>Cantine</h1>
  <p class="page-sub">Menus et présences repas</p>
</div>
<% if (!children.length) { %><p class="empty">Aucun enfant lié.</p><% } %>
<% children.forEach(function(link) { const s = link.student; %>
  <div class="card">
    <h2><%= s.firstName %> <%= s.lastName %></h2>
    <% if (!s.canteenRecords.length) { %><p class="empty">Aucun repas enregistré.</p><% } %>
    <% s.canteenRecords.forEach(function(r) { %>
      <p>
        <%= new Date(r.menu.date).toLocaleDateString('fr-FR') %> :
        <%= r.menu.menu %>
        — <strong><%= r.ate ? 'A mangé' : 'N\'a pas mangé' %></strong>
      </p>
    <% }) %>
  </div>
<% }) %>
<% } %>
