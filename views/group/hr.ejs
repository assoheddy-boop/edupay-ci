<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('hr', { _inLayout: true }); %>
<%- include('../layouts/groupLayout', { body: content, title: 'RH groupe' }) %>
<% } else { %>
<%- include('_nav', { current: 'hr' }) %>
<div class="page-header">
  <div>
    <h1>RH consolidées</h1>
    <p class="page-sub">Personnel, congés et paie sur tous les campus</p>
  </div>
</div>

<div class="stats-grid">
  <div class="stat-card"><span class="stat-value"><%= totals.teachers %></span><span class="stat-label">Enseignants</span></div>
  <div class="stat-card"><span class="stat-value"><%= totals.staffActive %></span><span class="stat-label">Profils actifs</span></div>
  <div class="stat-card stat-card-warning"><span class="stat-value"><%= totals.pendingLeaves %></span><span class="stat-label">Congés en attente</span></div>
</div>

<div class="card">
  <h2>Effectifs par campus</h2>
  <table class="table">
    <thead><tr><th>Campus</th><th>Enseignants</th><th>Profils actifs</th><th>Congés attente</th></tr></thead>
    <tbody>
      <% campusStats.forEach(function(c) { %>
        <tr>
            <td>
              <a href="/group/campuses/<%= c.school.id %>" class="person-line">
                <%- include('../partials/_logo', { logoUrl: c.school.logoUrl, logoBase64: c.school.logoBase64, name: c.school.name, size: 'sm' }) %>
                <%= c.school.campusLabel || c.school.name %>
              </a>
            </td>
          <td><%= c.teachers %></td>
          <td><%= c.staffActive %></td>
          <td><%= c.pendingLeaves %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<div class="grid-2">
  <div class="card">
    <h2>Congés à traiter</h2>
    <% if (leaves.length === 0) { %>
      <p class="empty">Aucune demande en attente.</p>
    <% } else { %>
      <table class="table">
        <thead><tr><th>Campus</th><th>Enseignant</th><th>Période</th><th>Type</th></tr></thead>
        <tbody>
          <% leaves.forEach(function(l) { %>
            <tr>
              <td><%= l.school?.campusLabel || l.school?.name || '—' %></td>
              <td class="person-cell">
                <%- include('../partials/_avatar', { src: l.teacher.user.photoUrl, firstName: l.teacher.user.firstName, lastName: l.teacher.user.lastName, size: 'sm' }) %>
                <%= l.teacher.user.lastName %> <%= l.teacher.user.firstName %>
              </td>
              <td><%= new Date(l.startDate).toLocaleDateString('fr-FR') %> → <%= new Date(l.endDate).toLocaleDateString('fr-FR') %></td>
              <td><%= l.type %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
  <div class="card">
    <h2>Dernières paies</h2>
    <% if (payrollRuns.length === 0) { %>
      <p class="empty">Aucune paie générée.</p>
    <% } else { %>
      <table class="table">
        <thead><tr><th>Campus</th><th>Période</th><th>Statut</th><th>Bulletins</th><th>Net</th></tr></thead>
        <tbody>
          <% payrollRuns.forEach(function(r) { %>
            <tr>
              <td><%= r.school.campusLabel || r.school.name %></td>
              <td><%= String(r.month).padStart(2,'0') %>/<%= r.year %></td>
              <td><%= r.status %></td>
              <td><%= r._count.payslips %></td>
              <td><%= (r.totalNet || 0).toLocaleString('fr-FR') %> FCFA</td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>
<% } %>
