<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('audit', { _inLayout: true }); %>
<%- include('../layouts/adminLayout', { body: content, title: 'Journal d\'audit' }) %>
<% } else { %>
<div class="page-header">
  <div>
    <h1>Journal des actions sensibles</h1>
    <p class="page-sub">Connexions, modules, bourses, comptabilité, transferts et paie</p>
  </div>
  <a href="/admin/reporting" class="btn btn-outline">Reporting</a>
</div>

<div class="card">
  <h2>Filtrer</h2>
  <form method="GET" action="/admin/audit" class="form">
    <div class="form-row">
      <div class="form-group">
        <label>Utilisateur</label>
        <select name="userId">
          <option value="">Tous</option>
          <% users.forEach(function(u) { %>
            <option value="<%= u.id %>" <%= filters.userId === u.id ? 'selected' : '' %>>
              <%= u.lastName %> <%= u.firstName %> — <%= u.email %>
            </option>
          <% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>Action</label>
        <select name="action">
          <option value="">Toutes</option>
          <% actions.forEach(function(a) { %>
            <option value="<%= a %>" <%= filters.action === a ? 'selected' : '' %>>
              <%= labels[a] || a %>
            </option>
          <% }) %>
        </select>
      </div>
    </div>
    <div class="form-row">
      <div class="form-group">
        <label>Du</label>
        <input type="date" name="from" value="<%= filters.from %>">
      </div>
      <div class="form-group">
        <label>Au</label>
        <input type="date" name="to" value="<%= filters.to %>">
      </div>
    </div>
    <button type="submit" class="btn btn-primary">Appliquer</button>
  </form>
</div>

<div class="card">
  <div class="card-header"><h2>Entrées (<%= entries.length %>)</h2></div>
  <% if (!entries.length) { %>
    <p class="empty">Aucune action sensible pour ces filtres.</p>
  <% } else { %>
    <table class="table">
      <thead>
        <tr><th>Date</th><th>Utilisateur</th><th>Action</th></tr>
      </thead>
      <tbody>
        <% entries.forEach(function(e) { %>
          <tr>
            <td><%= new Date(e.timestamp).toLocaleString('fr-FR') %></td>
            <td>
              <% if (e.user) { %>
                <strong><%= e.user.lastName %> <%= e.user.firstName %></strong>
                <br><span class="page-sub"><%= e.user.email %></span>
              <% } else { %>
                —
              <% } %>
            </td>
            <td>
              <span class="badge"><%= labels[e.action] || e.action %></span>
              <% if (labels[e.action]) { %><br><span class="page-sub"><%= e.action %></span><% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>
<% } %>
