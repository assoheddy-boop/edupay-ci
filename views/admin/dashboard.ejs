<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('dashboard', { _inLayout: true }); %>
<%- include('../layouts/adminLayout', { body: content, title: 'Super Admin — EduPay CI' }) %>
<% } else { %>
<div class="page-header">
    <div>
      <h1>Super Admin</h1>
      <p class="page-sub">Plateforme premium — gestion centralisée des écoles et modules</p>
    </div>
    <div class="page-header-actions">
      <a href="/admin/reporting" class="btn btn-primary">Graphiques d'analyse</a>
      <a href="/transfer/dashboard" class="btn btn-outline">Transferts</a>
      <a href="/admin/modules" class="btn btn-outline">Gérer les modules</a>
      <a href="/admin/plans" class="btn btn-outline">Plans</a>
      <a href="/admin/organizations" class="btn btn-outline">Groupes scolaires</a>
      <a href="/admin/finance" class="btn btn-outline">Finance</a>
      <a href="/admin/accounting" class="btn btn-outline">Comptabilité</a>
    </div>
  </div>

  <% if (success === 'premium') { %>
    <div class="alert alert-success">Plateforme passée en mode premium.</div>
  <% } %>

  <div class="stats-grid">
    <div class="stat-card">
      <span class="stat-value"><%= stats.schools %></span>
      <span class="stat-label">Écoles</span>
    </div>
    <div class="stat-card">
      <span class="stat-value"><%= stats.organizations %></span>
      <span class="stat-label">Groupes</span>
    </div>
    <div class="stat-card">
      <span class="stat-value"><%= stats.users %></span>
      <span class="stat-label">Utilisateurs</span>
    </div>
    <div class="stat-card">
      <span class="stat-value"><%= stats.students %></span>
      <span class="stat-label">Élèves</span>
    </div>
    <div class="stat-card<%= stats.pendingTransfers > 0 ? ' stat-card-warning' : '' %>">
      <span class="stat-value"><%= stats.pendingTransfers %></span>
      <span class="stat-label">Transferts en attente</span>
    </div>
  </div>

  <div class="card" style="border:2px solid var(--primary,#2563eb);background:linear-gradient(135deg,rgba(37,99,235,0.08),rgba(37,99,235,0.02))">
    <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap">
      <div>
        <h2>Graphiques d'analyse</h2>
        <p class="page-sub">Comparatif filles/garçons par école — visible dès la connexion Super Admin.</p>
      </div>
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap">
        <a href="/admin/reporting" class="btn btn-primary">Ouvrir l'analyse complète</a>
        <a href="/admin/group/redoublement" class="btn btn-outline">Redoublement groupe</a>
      </div>
    </div>
    <% if (!genderBySchool || !genderBySchool.length) { %>
      <p class="empty">Aucun élève inscrit — les graphiques apparaîtront dès qu'il y aura des données.</p>
    <% } else { %>
      <% const dashGenderLabels = genderBySchool.map(function(row) { return row.schoolName; }); %>
      <% const dashGenderBoys = genderBySchool.map(function(row) { return row.boys; }); %>
      <% const dashGenderGirls = genderBySchool.map(function(row) { return row.girls; }); %>
      <% const dashAbsenceBoys = genderBySchool.map(function(row) { return row.absences ? row.absences.boys : 0; }); %>
      <% const dashAbsenceGirls = genderBySchool.map(function(row) { return row.absences ? row.absences.girls : 0; }); %>
      <div class="grid-2" style="margin-bottom:1rem">
        <div style="max-width:960px;margin:0 auto">
          <h3 style="margin:0 0 0.75rem;font-size:1rem">Effectifs par école</h3>
          <canvas id="dashSchoolGenderChart" height="220"></canvas>
        </div>
        <div style="max-width:960px;margin:0 auto">
          <h3 style="margin:0 0 0.75rem;font-size:1rem">Absences garçons vs filles</h3>
          <canvas id="dashAbsenceGenderChart" height="220"></canvas>
        </div>
      </div>
      <div class="card-footer">
        <a href="/admin/reporting" class="btn btn-primary">Voir tous les graphiques (réussite, exports PDF/Excel)</a>
      </div>
      <script src="/js/chart.umd.min.js"></script>
      <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
      <script>
        (function () {
          if (typeof Chart === 'undefined') return;
          const boysColor = '#3498db';
          const girlsColor = '#e74c3c';
          const labels = <%= JSON.stringify(dashGenderLabels) %>;
          const chartDefaults = {
            responsive: true,
            plugins: { legend: { position: 'top' } },
            scales: {
              x: { stacked: false },
              y: { beginAtZero: true, ticks: { precision: 0 } },
            },
          };

          const schoolGenderCtx = document.getElementById('dashSchoolGenderChart');
          if (schoolGenderCtx) {
            new Chart(schoolGenderCtx, {
              type: 'bar',
              data: {
                labels,
                datasets: [
                  { label: 'Garçons', data: <%= JSON.stringify(dashGenderBoys) %>, backgroundColor: boysColor },
                  { label: 'Filles', data: <%= JSON.stringify(dashGenderGirls) %>, backgroundColor: girlsColor },
                ],
              },
              options: chartDefaults,
            });
          }

          const absenceGenderCtx = document.getElementById('dashAbsenceGenderChart');
          if (absenceGenderCtx) {
            new Chart(absenceGenderCtx, {
              type: 'bar',
              data: {
                labels,
                datasets: [
                  { label: 'Garçons', data: <%= JSON.stringify(dashAbsenceBoys) %>, backgroundColor: boysColor },
                  { label: 'Filles', data: <%= JSON.stringify(dashAbsenceGirls) %>, backgroundColor: girlsColor },
                ],
              },
              options: chartDefaults,
            });
          }
        })();
      </script>
    <% } %>
  </div>

  <div class="card">
    <div class="card-header">
      <h2>Espace Super Admin</h2>
      <p class="page-sub">Accès rapide à toutes les fonctionnalités de la plateforme.</p>
    </div>
    <div class="hero-features admin-hub-grid">
      <a href="/admin/plans" class="feature-card admin-hub-card">
        <span class="feature-icon">📋</span>
        <h3>Plans</h3>
        <p>Abonnements et activation des modules par plan.</p>
      </a>
      <a href="/admin/modules" class="feature-card admin-hub-card">
        <span class="feature-icon">🧩</span>
        <h3>Modules</h3>
        <p>Activer ou désactiver les modules par école.</p>
      </a>
      <a href="/admin/organizations" class="feature-card admin-hub-card">
        <span class="feature-icon">🏫</span>
        <h3>Groupes</h3>
        <p>Groupes scolaires, campus et administrateurs.</p>
      </a>
      <a href="/admin/finance" class="feature-card admin-hub-card">
        <span class="feature-icon">💰</span>
        <h3>Finance</h3>
        <p>Bourses, revenus et pilotage financier global.</p>
      </a>
      <a href="/admin/accounting" class="feature-card admin-hub-card">
        <span class="feature-icon">📒</span>
        <h3>Comptabilité</h3>
        <p>Écritures comptables et suivi des opérations.</p>
      </a>
      <a href="/admin/reporting" class="feature-card admin-hub-card" style="border:2px solid var(--primary,#2563eb)">
        <span class="feature-icon">📊</span>
        <h3>Graphiques d'analyse</h3>
        <p>Filles/garçons, absences, réussite — graphiques interactifs.</p>
      </a>
      <a href="/admin/audit" class="feature-card admin-hub-card">
        <span class="feature-icon">🔍</span>
        <h3>Audit</h3>
        <p>Journal des actions et traçabilité.</p>
      </a>
      <a href="/transfer/dashboard" class="feature-card admin-hub-card">
        <span class="feature-icon">🔄</span>
        <h3>Transferts</h3>
        <p>Demandes de changement d'école des élèves.</p>
      </a>
      <a href="/admin/group/redoublement" class="feature-card admin-hub-card">
        <span class="feature-icon">📈</span>
        <h3>Redoublement groupe</h3>
        <p>Comparatif des causes de redoublement par école.</p>
      </a>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h2>Modules — vue globale</h2>
      <p class="page-sub">Seul le Super Admin peut activer ou désactiver les modules par école.</p>
    </div>
    <div class="module-stats-grid">
      <% moduleStats.forEach(function(m) { %>
        <div class="module-stat-item">
          <span class="module-stat-label"><%= m.label %></span>
          <span class="module-stat-value"><%= m.enabled %>/<%= m.total %></span>
        </div>
      <% }) %>
    </div>
    <div class="card-footer">
      <a href="/admin/modules" class="btn btn-primary">Configurer les modules par école</a>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h2>Écoles inscrites</h2>
    </div>
    <table class="table">
      <thead>
        <tr>
          <th>École</th>
          <th>Ville</th>
          <th>Groupe</th>
          <th>Élèves</th>
          <th>Modules actifs</th>
          <th>Abonnement</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% schools.forEach(function(s) { %>
          <tr>
            <td>
              <strong><%= s.name %></strong><br>
              <small><%= s.admin?.email || '—' %></small>
            </td>
            <td><%= s.city %></td>
            <td><%= s.organization?.name || '—' %></td>
            <td><%= s._count.students %></td>
            <td>
              <span class="badge"><%= s.enabledCount %>/<%= MODULE_KEYS.length %></span>
            </td>
            <td><span class="badge badge-premium">Premium</span></td>
            <td>
              <a href="/admin/modules?school=<%= s.id %>" class="btn btn-sm btn-primary">Modules</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>
