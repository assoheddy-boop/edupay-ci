<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('dashboard', { _inLayout: true }); %>
<%- include('../layouts/adminLayout', { body: content, title: 'Super Admin — EduConnect' }) %>
<% } else { %>
<div class="page-header">
    <div>
      <h1>Super Admin</h1>
      <p class="page-sub">Plateforme premium — gestion centralisée des écoles et modules</p>
    </div>
    <div class="page-header-actions">
      <a href="/admin/reporting" class="btn btn-primary">Graphiques d'analyse</a>
      <a href="/transfer/dashboard" class="btn btn-outline">Transferts</a>
      <a href="/admin/modules" class="btn btn-outline">Gérer les modules</a>
      <a href="/admin/plans" class="btn btn-outline">Plans</a>
      <a href="/admin/organizations" class="btn btn-outline">Groupes scolaires</a>
      <a href="/admin/finance" class="btn btn-outline">Finance</a>
      <a href="/admin/accounting" class="btn btn-outline">Comptabilité</a>
    </div>
  </div>

  <% if (success === 'premium') { %>
    <div class="alert alert-success">Plateforme passée en mode premium.</div>
  <% } %>
  <% if (success === 'cycle') { %>
    <div class="alert alert-success">Cycle d’enseignement mis à jour. Le menu de l’école s’adapte immédiatement.</div>
  <% } %>
  <% if (typeof error !== 'undefined' && error === 'assist') { %>
    <div class="alert alert-error">Impossible de prendre la main — école ou groupe introuvable.</div>
  <% } %>
  <% const smsGw = (typeof smsProvider !== 'undefined' && smsProvider) ? smsProvider : 'orange'; %>
  <% const smsGwLabel = smsGw === 'twilio' ? 'Twilio' : (smsGw === 'orange' ? 'Orange' : smsGw); %>
  <% if (typeof smsTest !== 'undefined' && smsTest === 'sent') { %>
    <div class="alert alert-success">SMS de test envoyé via <%= smsGwLabel %><%= typeof smsSender !== 'undefined' && smsSender ? ' (expéditeur ' + smsSender + ')' : '' %>.</div>
  <% } else if (typeof smsTest !== 'undefined' && smsTest === 'skipped') { %>
    <div class="alert alert-error">
      SMS de test ignoré
      <% if (smsReason === 'not_configured' && smsGw === 'twilio') { %> — identifiants Twilio absents sur Vercel (SMS_PROVIDER=twilio + TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN et TWILIO_PHONE_NUMBER ou TWILIO_MESSAGING_SERVICE_SID).<% } %>
      <% if (smsReason === 'not_configured' && smsGw !== 'twilio') { %> — identifiants Orange absents sur Vercel (SMS_PROVIDER=orange + client_id/secret ou URL+token).<% } %>
      <% if (smsReason === 'invalid_phone' || smsReason === 'no_phone') { %> — numéro ivoirien invalide (ex. 07 00 00 00 00 ou +225…).<% } %>
      <% if (smsReason && smsReason !== 'not_configured' && smsReason !== 'invalid_phone' && smsReason !== 'no_phone') { %> — <%= smsReason %>.<% } %>
    </div>
  <% } else if (typeof smsTest !== 'undefined' && smsTest === 'error') { %>
    <div class="alert alert-error">
      Échec <%= smsGwLabel %> : <%= smsReason || 'erreur d\'envoi' %>.
      <% if (smsGw === 'twilio') { %> Compte d'essai : seuls les numéros vérifiés reçoivent un SMS.<% } else { %> Vérifiez le bundle SMS et l'identifiant expéditeur whitelisté.<% } %>
    </div>
  <% } %>

  <div class="card" style="margin-bottom:1.25rem">
    <div class="card-header">
      <h2>Test SMS <%= smsGwLabel %></h2>
      <p class="page-sub">
        Contrôle de connexion Super Admin — envoie <strong>EduConnect : test SMS <%= smsGwLabel %>.</strong>
        Ce test peut partir même si le module « SMS officiel » de l'école est désactivé.
        Les absences, devoirs et paiements, eux, restent soumis à ce module.
      </p>
    </div>
    <p class="form-hint">
      Identifiants <%= smsGwLabel %> :
      <% if (typeof smsConfigured !== 'undefined' && smsConfigured) { %>
        <strong>détectés</strong> (aucune clé n'est affichée ici).
      <% } else if (smsGw === 'twilio') { %>
        <strong>non configurés</strong> — renseignez SMS_PROVIDER=twilio et les variables TWILIO_* sur Vercel.
      <% } else { %>
        <strong>non configurés</strong> — renseignez SMS_PROVIDER=orange et les variables ORANGE_SMS_* sur Vercel.
      <% } %>
      <% if (smsGw === 'twilio') { %><br>Les parents peuvent voir un numéro international Twilio tant qu'un expéditeur alphanumérique n'est pas déclaré chez Twilio. Compte d'essai : SMS uniquement vers des numéros vérifiés.<% } %>
    </p>
    <form method="POST" action="/admin/sms-test" class="form">
      <div class="form-row">
        <div class="form-group">
          <label for="smsTestPhone">Téléphone (Côte d'Ivoire)</label>
          <input type="tel" id="smsTestPhone" name="phone" required placeholder="07 00 00 00 00 ou +225…" autocomplete="tel">
        </div>
        <div class="form-group">
          <label for="smsTestSchool">École (optionnel — identifiant expéditeur)</label>
          <select id="smsTestSchool" name="schoolId">
            <option value="">EduConnect (défaut plateforme)</option>
            <% (typeof schools !== 'undefined' ? schools : []).forEach(function(s) { %>
              <option value="<%= s.id %>"><%= s.name %><%= s.smsSenderId ? ' — ' + s.smsSenderId : '' %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <button type="submit" class="btn btn-primary">Envoyer un SMS de test</button>
    </form>
  </div>

  <div class="stats-grid">
    <div class="stat-card">
      <span class="stat-value"><%= stats.schools %></span>
      <span class="stat-label">Écoles</span>
    </div>
    <div class="stat-card">
      <span class="stat-value"><%= stats.organizations %></span>
      <span class="stat-label">Groupes</span>
    </div>
    <div class="stat-card">
      <span class="stat-value"><%= stats.users %></span>
      <span class="stat-label">Utilisateurs</span>
    </div>
    <div class="stat-card">
      <span class="stat-value"><%= stats.students %></span>
      <span class="stat-label">Élèves</span>
    </div>
    <div class="stat-card<%= stats.pendingTransfers > 0 ? ' stat-card-warning' : '' %>">
      <span class="stat-value"><%= stats.pendingTransfers %></span>
      <span class="stat-label">Transferts en attente</span>
    </div>
  </div>

  <div class="card" style="border:2px solid var(--primary,#2563eb);background:linear-gradient(135deg,rgba(37,99,235,0.08),rgba(37,99,235,0.02))">
    <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap">
      <div>
        <h2>Graphiques d'analyse<%- include('../partials/_hint', { text: 'Filles/garçons, absences et réussite — comparatif par école.', label: 'Graphiques d\'analyse' }) %></h2>
        <p class="page-sub">Comparatif filles/garçons par école — visible dès la connexion Super Admin.</p>
      </div>
      <div style="display:flex;gap:0.5rem;flex-wrap:wrap">
        <a href="/admin/reporting" class="btn btn-primary">Ouvrir l'analyse complète</a>
        <a href="/admin/group/redoublement" class="btn btn-outline">Redoublement groupe</a>
      </div>
    </div>
    <% if (!genderBySchool || !genderBySchool.length) { %>
      <p class="empty">Aucun élève inscrit — les graphiques apparaîtront dès qu'il y aura des données.</p>
    <% } else { %>
      <% const dashGenderLabels = genderBySchool.map(function(row) { return row.schoolName; }); %>
      <% const dashGenderBoys = genderBySchool.map(function(row) { return row.boys; }); %>
      <% const dashGenderGirls = genderBySchool.map(function(row) { return row.girls; }); %>
      <% const dashAbsenceBoys = genderBySchool.map(function(row) { return row.absences ? row.absences.boys : 0; }); %>
      <% const dashAbsenceGirls = genderBySchool.map(function(row) { return row.absences ? row.absences.girls : 0; }); %>
      <div class="grid-2" style="margin-bottom:1rem">
        <div style="max-width:960px;margin:0 auto">
          <h3 style="margin:0 0 0.75rem;font-size:1rem">Effectifs par école<%- include('../partials/_hint', { text: 'Répartition des élèves par genre (M/F) pour chaque école.', label: 'Effectifs par école' }) %></h3>
          <canvas id="dashSchoolGenderChart" height="220"></canvas>
        </div>
        <div style="max-width:960px;margin:0 auto">
          <h3 style="margin:0 0 0.75rem;font-size:1rem">Absences garçons vs filles<%- include('../partials/_hint', { text: 'Nombre d\'absences et retards cumulés, comparés par genre.', label: 'Absences garçons vs filles' }) %></h3>
          <canvas id="dashAbsenceGenderChart" height="220"></canvas>
        </div>
      </div>
      <div class="card-footer">
        <a href="/admin/reporting" class="btn btn-primary">Voir tous les graphiques (réussite, exports PDF/Excel)</a>
      </div>
      <script src="/js/chart.umd.min.js"></script>
      <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
      <script>
        (function () {
          if (typeof Chart === 'undefined') return;
          const boysColor = '#3498db';
          const girlsColor = '#e74c3c';
          const labels = <%= JSON.stringify(dashGenderLabels) %>;
          const chartDefaults = {
            responsive: true,
            plugins: { legend: { position: 'top' } },
            scales: {
              x: { stacked: false },
              y: { beginAtZero: true, ticks: { precision: 0 } },
            },
          };

          const schoolGenderCtx = document.getElementById('dashSchoolGenderChart');
          if (schoolGenderCtx) {
            new Chart(schoolGenderCtx, {
              type: 'bar',
              data: {
                labels,
                datasets: [
                  { label: 'Garçons', data: <%= JSON.stringify(dashGenderBoys) %>, backgroundColor: boysColor },
                  { label: 'Filles', data: <%= JSON.stringify(dashGenderGirls) %>, backgroundColor: girlsColor },
                ],
              },
              options: chartDefaults,
            });
          }

          const absenceGenderCtx = document.getElementById('dashAbsenceGenderChart');
          if (absenceGenderCtx) {
            new Chart(absenceGenderCtx, {
              type: 'bar',
              data: {
                labels,
                datasets: [
                  { label: 'Garçons', data: <%= JSON.stringify(dashAbsenceBoys) %>, backgroundColor: boysColor },
                  { label: 'Filles', data: <%= JSON.stringify(dashAbsenceGirls) %>, backgroundColor: girlsColor },
                ],
              },
              options: chartDefaults,
            });
          }
        })();
      </script>
    <% } %>
  </div>

  <div class="card">
    <div class="card-header">
      <h2>Espace Super Admin</h2>
      <p class="page-sub">Accès rapide à toutes les fonctionnalités de la plateforme.</p>
    </div>
    <div class="hero-features admin-hub-grid">
      <a href="/admin/plans" class="feature-card admin-hub-card">
        <span class="feature-icon">📋</span>
        <h3>Plans<%- include('../partials/_hint', { text: 'Abonnements et activation des modules par formule.', label: 'Plans' }) %></h3>
        <p>Abonnements et activation des modules par plan.</p>
      </a>
      <a href="/admin/modules" class="feature-card admin-hub-card">
        <span class="feature-icon">🧩</span>
        <h3>Modules<%- include('../partials/_hint', { text: 'Activer ou désactiver les fonctionnalités par école.', label: 'Modules' }) %></h3>
        <p>Activer ou désactiver les modules par école.</p>
      </a>
      <a href="/admin/organizations" class="feature-card admin-hub-card">
        <span class="feature-icon">🏫</span>
        <h3>Groupes<%- include('../partials/_hint', { text: 'Groupes scolaires, campus multiples et administrateurs.', label: 'Groupes' }) %></h3>
        <p>Groupes scolaires, campus et administrateurs.</p>
      </a>
      <a href="/admin/finance" class="feature-card admin-hub-card">
        <span class="feature-icon">💰</span>
        <h3>Finance<%- include('../partials/_hint', { text: 'Bourses, revenus et pilotage financier global de la plateforme.', label: 'Finance' }) %></h3>
        <p>Bourses, revenus et pilotage financier global.</p>
      </a>
      <a href="/admin/accounting" class="feature-card admin-hub-card">
        <span class="feature-icon">📒</span>
        <h3>Comptabilité<%- include('../partials/_hint', { text: 'Écritures comptables et suivi des opérations financières.', label: 'Comptabilité' }) %></h3>
        <p>Écritures comptables et suivi des opérations.</p>
      </a>
      <a href="/admin/reporting" class="feature-card admin-hub-card" style="border:2px solid var(--primary,#2563eb)">
        <span class="feature-icon">📊</span>
        <h3>Graphiques d'analyse<%- include('../partials/_hint', { text: 'Filles/garçons, absences, réussite — graphiques interactifs.', label: 'Graphiques d\'analyse' }) %></h3>
        <p>Filles/garçons, absences, réussite — graphiques interactifs.</p>
      </a>
      <a href="/admin/audit" class="feature-card admin-hub-card">
        <span class="feature-icon">🔍</span>
        <h3>Audit<%- include('../partials/_hint', { text: 'Journal des actions et traçabilité des opérations.', label: 'Audit' }) %></h3>
        <p>Journal des actions et traçabilité.</p>
      </a>
      <a href="/transfer/dashboard" class="feature-card admin-hub-card">
        <span class="feature-icon">🔄</span>
        <h3>Transferts<%- include('../partials/_hint', { text: 'Demandes de changement d\'école des élèves.', label: 'Transferts' }) %></h3>
        <p>Demandes de changement d'école des élèves.</p>
      </a>
      <a href="/admin/group/redoublement" class="feature-card admin-hub-card">
        <span class="feature-icon">📈</span>
        <h3>Redoublement groupe<%- include('../partials/_hint', { text: 'Compare les causes de redoublement (absences, notes) par école du groupe.', label: 'Redoublement groupe' }) %></h3>
        <p>Comparatif des causes de redoublement par école.</p>
      </a>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h2>Modules — vue globale<%- include('../partials/_hint', { text: 'Nombre d\'écoles ayant activé chaque module.', label: 'Modules — vue globale' }) %></h2>
      <p class="page-sub">Seul le Super Admin peut activer ou désactiver les modules par école.</p>
    </div>
    <div class="module-stats-grid">
      <% moduleStats.forEach(function(m) { %>
        <div class="module-stat-item">
          <span class="module-stat-label"><%= m.label %><%- include('../partials/_hint', { text: MODULES[m.key].description, label: m.label }) %></span>
          <span class="module-stat-value"><%= m.enabled %>/<%= m.total %></span>
        </div>
      <% }) %>
    </div>
    <div class="card-footer">
      <a href="/admin/modules" class="btn btn-primary">Configurer les modules par école</a>
    </div>
  </div>

  <div class="card">
    <div class="card-header" style="display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;flex-wrap:wrap">
      <div>
        <h2>Écoles et groupes</h2>
        <p class="page-sub">Prenez la main pour aider un directeur — tous les modules sont accessibles, hors limites du plan.</p>
      </div>
      <label class="assist-search">
        <span class="sr-only">Rechercher</span>
        <input type="search" id="adminAssistSearch" placeholder="Rechercher une école ou un groupe…" autocomplete="off">
      </label>
    </div>

    <h3 class="assist-section-title">Écoles inscrites</h3>
    <div class="table-scroll">
    <table class="table" id="adminSchoolsTable">
      <thead>
        <tr>
          <th>École</th>
          <th>Ville</th>
          <th>Cycle</th>
          <th>Groupe</th>
          <th>Élèves</th>
          <th>Modules actifs</th>
          <th>Plan</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% schools.forEach(function(s) { %>
          <tr class="assist-filter-row" data-search="<%= (s.name + ' ' + (s.city || '') + ' ' + (s.admin && s.admin.email ? s.admin.email : '') + ' ' + (s.organization && s.organization.name ? s.organization.name : '')).toLowerCase() %>">
            <td>
              <strong><%= s.name %></strong><br>
              <small><%= s.admin?.email || '—' %></small>
            </td>
            <td><%= s.city %></td>
            <td>
              <form method="POST" action="/admin/schools/<%= s.id %>/cycle" class="form-inline cycle-inline">
                <input type="hidden" name="redirect" value="/admin/dashboard">
                <select name="educationCycle" aria-label="Cycle <%= s.name %>" onchange="this.form.submit()">
                  <% (typeof educationCycleOptions !== 'undefined' ? educationCycleOptions : []).forEach(function(opt) { %>
                    <option value="<%= opt.value %>" <%= s.educationCycle === opt.value ? 'selected' : '' %>><%= opt.label %></option>
                  <% }) %>
                </select>
              </form>
            </td>
            <td><%= s.organization?.name || '—' %></td>
            <td><%= s._count.students %></td>
            <td>
              <span class="badge"><%= s.enabledCount %>/<%= MODULE_KEYS.length %></span>
            </td>
            <td>
              <span class="badge badge-premium"><%= s.plan?.name || s.subscription || '—' %></span>
            </td>
            <td class="assist-actions">
              <%- include('../partials/_adminAssistForm', { type: 'school', id: s.id, label: 'Gérer' }) %>
              <a href="/admin/modules?school=<%= s.id %>" class="btn btn-sm btn-outline">Modules</a>
              <form method="POST" action="/admin/schools/<%= s.id %>/featured" class="form-inline" style="display:inline">
                <select name="marketplaceTier" aria-label="Marketplace <%= s.name %>" onchange="this.form.submit()">
                  <% (typeof marketplaceTierOptions !== 'undefined' ? marketplaceTierOptions : []).forEach(function(opt) { %>
                    <option value="<%= opt.value %>" <%= (s.marketplaceTier || 'NONE') === opt.value ? 'selected' : '' %>><%= opt.label %></option>
                  <% }) %>
                </select>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>

    <h3 class="assist-section-title">Groupes scolaires</h3>
    <% if (!organizations || !organizations.length) { %>
      <p class="empty">Aucun groupe scolaire.</p>
    <% } else { %>
    <div class="table-scroll">
    <table class="table" id="adminGroupsTable">
      <thead>
        <tr>
          <th>Groupe</th>
          <th>Écoles</th>
          <th>Admins</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% organizations.forEach(function(org) { %>
          <tr class="assist-filter-row" data-search="<%= org.name.toLowerCase() %>">
            <td><strong><%= org.name %></strong></td>
            <td><%= org._count?.schools ?? 0 %></td>
            <td><%= org._count?.admins ?? 0 %></td>
            <td class="assist-actions">
              <%- include('../partials/_adminAssistForm', { type: 'group', id: org.id, label: 'Prendre la main' }) %>
              <a href="/admin/organizations" class="btn btn-sm btn-outline">Fiche</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
    <% } %>
    <p class="empty" id="adminAssistEmpty" hidden>Aucun résultat.</p>
  </div>
  <script>
    (function () {
      const input = document.getElementById('adminAssistSearch');
      const empty = document.getElementById('adminAssistEmpty');
      if (!input) return;
      input.addEventListener('input', function () {
        const q = input.value.trim().toLowerCase();
        const rows = document.querySelectorAll('.assist-filter-row');
        let visible = 0;
        rows.forEach(function (row) {
          const match = !q || (row.getAttribute('data-search') || '').indexOf(q) !== -1;
          row.hidden = !match;
          if (match) visible += 1;
        });
        if (empty) empty.hidden = visible > 0;
      });
    })();
  </script>
<% } %>
