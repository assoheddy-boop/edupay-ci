<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('school-modules', { _inLayout: true }); %>
<%- include('../layouts/adminLayout', { body: content, title: 'Modules — ' + school.name }) %>
<% } else { %>
<div class="page-header">
    <div>
      <a href="/admin/modules?school=<%= school.id %>" class="text-muted">← Gestion modules</a>
      <h1><%= school.name %></h1>
      <p class="page-sub">Configuration des modules — Super Admin uniquement</p>
    </div>
  </div>

  <% if (success === 'cycle') { %><div class="alert alert-success">Cycle d’enseignement mis à jour.</div><% } else if (success) { %><div class="alert alert-success">Modules mis à jour.</div><% } %>

  <form method="POST" action="/admin/schools/<%= school.id %>/cycle" class="card" style="margin-bottom:1.5rem">
    <div class="card-header">
      <h2>Cycle d’enseignement</h2>
      <p class="page-sub">Primaire, collège, lycée ou mixte — le menu de l’école s’adapte (séries lycée, examen national, libellés).</p>
    </div>
    <input type="hidden" name="redirect" value="/admin/schools/<%= school.id %>/modules">
    <div class="form-group">
      <label for="educationCycle">Cycle</label>
      <select id="educationCycle" name="educationCycle">
        <% (typeof educationCycleOptions !== 'undefined' ? educationCycleOptions : []).forEach(function(opt) { %>
          <option value="<%= opt.value %>" <%= school.educationCycle === opt.value ? 'selected' : '' %>><%= opt.label %></option>
        <% }) %>
      </select>
      <p class="form-hint">Mixte = primaire + collège, ou primaire + collège + lycée, avec menus séparés.</p>
    </div>
    <div class="card-footer">
      <button type="submit" class="btn btn-primary">Enregistrer le cycle</button>
    </div>
  </form>

  <form method="POST" action="/admin/schools/<%= school.id %>/featured" class="card" style="margin-bottom:1.5rem">
    <div class="card-header">
      <h2>Marketplace</h2>
      <p class="page-sub">Mise en avant sur /ecoles — Super Admin uniquement (évite les abus).</p>
    </div>
    <input type="hidden" name="redirect" value="/admin/schools/<%= school.id %>/modules">
    <input type="hidden" name="publicFeatured" value="<%= school.publicFeatured ? '0' : '1' %>">
    <div class="card-footer">
      <button type="submit" class="btn btn-primary"><%= school.publicFeatured ? 'Retirer la mise en avant' : 'Mettre en avant' %></button>
    </div>
  </form>

  <form method="POST" action="/admin/schools/<%= school.id %>/modules" class="card">
    <div class="card-header">
      <h2>Modules disponibles</h2>
      <p class="page-sub">Les écoles ne peuvent pas modifier ces paramètres. Les modules essentiels restent toujours actifs.</p>
    </div>

    <table class="table">
      <thead>
        <tr>
          <th>Module</th>
          <th>Description</th>
          <th>Activé</th>
        </tr>
      </thead>
      <tbody>
        <% MODULE_KEYS.forEach(function(key) {
          const mod = modules[key];
        %>
          <tr>
            <td>
              <strong><%= mod.label %></strong>
              <% if (mod.core) { %> <span class="badge">Essentiel</span><% } %>
            </td>
            <td><%= mod.description %></td>
            <td>
              <% if (mod.core) { %>
                <span class="badge badge-success">Toujours actif</span>
              <% } else { %>
                <label class="checkbox-label">
                  <input type="checkbox" name="mod_<%= key %>" <%= mod.enabled ? 'checked' : '' %>>
                  Activé
                </label>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <div class="card-footer">
      <button type="submit" class="btn btn-primary">Enregistrer</button>
    </div>
  </form>
<% } %>
