<% if (typeof _inLayout === 'undefined' || !_inLayout) { %>
<% const content = include('marketplace', { _inLayout: true }); %>
<%- include('../layouts/adminLayout', { body: content, title: 'Marketplace — Super Admin' }) %>
<% } else { %>
<div class="page-header">
  <div>
    <h1>Marketplace</h1>
    <p class="page-sub">Écoles visibles sur /ecoles — abonnements, paliers, publication.</p>
  </div>
  <div class="page-header-actions">
    <a href="/admin/marketplace/avis" class="btn btn-outline">Avis parents</a>
    <a href="/ecoles" class="btn btn-outline" target="_blank" rel="noopener">Ouvrir /ecoles</a>
  </div>
</div>
<%- include('../partials/_adminHubNav', { currentPath: 'marketplace' }) %>

<% if (success === 'published') { %><div class="alert alert-success">École publiée sur /ecoles.</div><% } %>
<% if (success === 'unpublished') { %><div class="alert alert-success">École retirée de /ecoles.</div><% } %>
<% if (success === 'tier') { %><div class="alert alert-success">Offre marketplace mise à jour.</div><% } %>
<% if (success === 'renewed') { %><div class="alert alert-success">Abonnement renouvelé (+1 an).</div><% } %>
<% if (success === 'bulk_renewed') { %><div class="alert alert-success">Renouvellement groupé effectué (+1 an par école sélectionnée).</div><% } %>
<% if (success === 'featured') { %><div class="alert alert-success">Mise en avant mise à jour.</div><% } %>
<% if (success === 'reminder') { %><div class="alert alert-success">E-mail de relance J-30 envoyé.</div><% } %>
<% if (typeof error !== 'undefined' && error === 'school') { %><div class="alert alert-error">École introuvable.</div><% } %>
<% if (typeof error !== 'undefined' && error === 'reminder') { %><div class="alert alert-error">Impossible d’envoyer la relance (e-mail admin manquant ou SMTP).</div><% } %>

<div class="stats-grid" style="margin-bottom:1rem">
  <div class="stat-card stat-card-warning">
    <span class="stat-label">Échéance ≤ <%= renewalWarningDays %> j</span>
    <span class="stat-value"><%= typeof expiring !== 'undefined' ? expiring.length : 0 %></span>
  </div>
  <div class="stat-card stat-card-danger">
    <span class="stat-label">Expirées</span>
    <span class="stat-value"><%= typeof expired !== 'undefined' ? expired.length : 0 %></span>
  </div>
  <div class="stat-card">
    <span class="stat-label">Sur /ecoles</span>
    <span class="stat-value"><%= schools.filter(function(s) { return s.onEcoles; }).length %></span>
  </div>
  <div class="stat-card">
    <span class="stat-label">À la une</span>
    <span class="stat-value"><%= schools.filter(function(s) { return s.publicFeatured; }).length %></span>
  </div>
</div>

<% if (typeof expiring !== 'undefined' && expiring.length) { %>
<div class="card card-warning" style="margin-bottom:1rem;border-left:4px solid #e6a700">
  <div class="card-header">
    <h2>Renouvellement à prévoir (J-<%= renewalWarningDays %>)</h2>
    <p class="page-sub">Relance automatique par e-mail chaque matin à 8h (Abidjan).</p>
  </div>
  <div class="table-scroll">
    <table class="table table-compact">
      <thead>
        <tr><th>École</th><th>Palier</th><th>Fin</th><th>Jours</th><th></th></tr>
      </thead>
      <tbody>
        <% expiring.forEach(function(s) { %>
          <tr>
            <td><strong><%= s.name %></strong></td>
            <td><%= s.marketplaceTier %></td>
            <td><%= s.subscription.expiresAt ? new Date(s.subscription.expiresAt).toLocaleDateString('fr-FR') : '—' %></td>
            <td><span class="badge badge-warning"><%= s.subscription.label %></span></td>
            <td class="assist-actions">
              <form method="POST" action="/admin/marketplace/<%= s.id %>/renew" style="display:inline">
                <button type="submit" class="btn btn-sm btn-primary">+1 an</button>
              </form>
              <form method="POST" action="/admin/marketplace/<%= s.id %>/reminder" style="display:inline">
                <button type="submit" class="btn btn-sm btn-outline">Relancer</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<% if (typeof expired !== 'undefined' && expired.length) { %>
<div class="card alert-error" style="margin-bottom:1rem">
  <div class="card-header">
    <h2>Abonnements expirés</h2>
    <p class="page-sub">Ces écoles ne sont plus listées sur /ecoles tant que l’abonnement n’est pas renouvelé.</p>
  </div>
  <div class="table-scroll">
    <table class="table table-compact">
      <thead>
        <tr><th>École</th><th>Palier</th><th>Expiré le</th><th></th></tr>
      </thead>
      <tbody>
        <% expired.forEach(function(s) { %>
          <tr>
            <td><strong><%= s.name %></strong></td>
            <td><%= s.marketplaceTier %></td>
            <td><%= s.subscription.expiresAt ? new Date(s.subscription.expiresAt).toLocaleDateString('fr-FR') : '—' %></td>
            <td>
              <form method="POST" action="/admin/marketplace/<%= s.id %>/renew">
                <button type="submit" class="btn btn-sm btn-primary">Renouveler +1 an</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<form method="POST" action="/admin/marketplace/bulk-renew" id="marketplace-bulk-form">
  <div id="bulk-hidden-inputs"></div>
<div class="card">
  <div class="card-header" style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:0.75rem">
    <div>
      <h2>Listing /ecoles</h2>
      <p class="page-sub">Module marketplace actif, palier payant, slug, publication et abonnement en cours.</p>
    </div>
    <button type="submit" class="btn btn-primary" id="bulk-renew-btn" disabled>Renouveler la sélection (+1 an)</button>
  </div>
  <div class="table-scroll">
    <table class="table">
      <thead>
        <tr>
          <th><input type="checkbox" id="select-all-marketplace" aria-label="Tout sélectionner"></th>
          <th>École</th>
          <th>Slug</th>
          <th>Sur /ecoles</th>
          <th>À la une</th>
          <th>Palier</th>
          <th>Début</th>
          <th>Fin</th>
          <th>Statut</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% schools.forEach(function(s) { %>
          <tr class="<%= s.subscription.state === 'expiring' ? 'row-warning' : (s.subscription.state === 'expired' ? 'row-danger' : '') %>">
            <td>
              <% if (s.marketplaceTier && s.marketplaceTier !== 'NONE') { %>
                <input type="checkbox" value="<%= s.id %>" class="marketplace-row-check" aria-label="Sélectionner <%= s.name %>">
              <% } %>
            </td>
            <td>
              <a href="/admin/schools/<%= s.id %>"><strong><%= s.name %></strong></a>
              <br><small><%= s.city || '' %></small>
            </td>
            <td>
              <% if (s.slug) { %>
                <a href="/e/<%= s.slug %>" target="_blank" rel="noopener">/e/<%= s.slug %></a>
              <% } else { %>—<% } %>
            </td>
            <td>
              <% if (s.onEcoles) { %>
                <span class="badge badge-success">Oui</span>
              <% } else { %>
                <span class="badge">Non</span>
              <% } %>
            </td>
            <td>
              <form method="POST" action="/admin/marketplace/<%= s.id %>/featured" class="form-inline">
                <label class="checkbox-label" style="margin:0">
                  <input type="checkbox" name="publicFeatured" value="1" <%= s.publicFeatured ? 'checked' : '' %> onchange="this.form.submit()">
                  À la une
                </label>
              </form>
            </td>
            <td>
              <form method="POST" action="/admin/marketplace/<%= s.id %>/tier" class="form-inline">
                <select name="marketplaceTier" aria-label="Palier <%= s.name %>" onchange="this.form.submit()">
                  <option value="NONE" <%= (s.marketplaceTier || 'NONE') === 'NONE' ? 'selected' : '' %>>Aucun</option>
                  <% (typeof marketplaceTierOptions !== 'undefined' ? marketplaceTierOptions : []).forEach(function(opt) { %>
                    <option value="<%= opt.value %>" <%= (s.marketplaceTier || 'NONE') === opt.value ? 'selected' : '' %>><%= opt.label %></option>
                  <% }) %>
                </select>
              </form>
            </td>
            <td><%= s.marketplaceStartedAt ? new Date(s.marketplaceStartedAt).toLocaleDateString('fr-FR') : '—' %></td>
            <td><%= s.marketplaceExpiresAt ? new Date(s.marketplaceExpiresAt).toLocaleDateString('fr-FR') : '—' %></td>
            <td>
              <% if (s.subscription.state === 'expiring') { %>
                <span class="badge badge-warning"><%= s.subscription.label %></span>
              <% } else if (s.subscription.state === 'expired') { %>
                <span class="badge badge-danger"><%= s.subscription.label %></span>
              <% } else if (s.subscription.state === 'active') { %>
                <span class="badge badge-success"><%= s.subscription.label %></span>
              <% } else { %>
                <span class="badge"><%= s.subscription.label %></span>
              <% } %>
            </td>
            <td class="assist-actions">
              <% if (s.marketplaceTier && s.marketplaceTier !== 'NONE') { %>
                <form method="POST" action="/admin/marketplace/<%= s.id %>/renew">
                  <button type="submit" class="btn btn-sm btn-outline">+1 an</button>
                </form>
              <% } %>
              <% if (s.onEcoles) { %>
                <form method="POST" action="/admin/marketplace/<%= s.id %>/unpublish">
                  <button type="submit" class="btn btn-sm btn-outline">Dépublier</button>
                </form>
              <% } else { %>
                <form method="POST" action="/admin/marketplace/<%= s.id %>/publish">
                  <button type="submit" class="btn btn-sm btn-primary">Publier</button>
                </form>
              <% } %>
              <%- include('../partials/_adminAssistForm', { type: 'school', id: s.id, label: 'Gérer' }) %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
</form>

<script>
(function () {
  var bulkForm = document.getElementById('marketplace-bulk-form');
  var hiddenHost = document.getElementById('bulk-hidden-inputs');
  var selectAll = document.getElementById('select-all-marketplace');
  var checks = document.querySelectorAll('.marketplace-row-check');
  var bulkBtn = document.getElementById('bulk-renew-btn');
  function syncBulkBtn() {
    var any = Array.prototype.some.call(checks, function (c) { return c.checked; });
    if (bulkBtn) bulkBtn.disabled = !any;
  }
  if (selectAll) {
    selectAll.addEventListener('change', function () {
      checks.forEach(function (c) { c.checked = selectAll.checked; });
      syncBulkBtn();
    });
  }
  checks.forEach(function (c) {
    c.addEventListener('change', syncBulkBtn);
  });
  if (bulkForm && hiddenHost) {
    bulkForm.addEventListener('submit', function (e) {
      hiddenHost.innerHTML = '';
      Array.prototype.forEach.call(checks, function (c) {
        if (!c.checked) return;
        var input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'schoolIds';
        input.value = c.value;
        hiddenHost.appendChild(input);
      });
      if (!hiddenHost.children.length) {
        e.preventDefault();
      }
    });
  }
})();
</script>
<% } %>
