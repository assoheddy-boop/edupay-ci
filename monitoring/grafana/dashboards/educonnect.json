      "title": "Mémoire processus",
      "type": "timeseries",
      "targets": [
        {
          "expr": "educonnect_process_resident_memory_bytes",
          "legendFormat": "RSS",
          "refId": "A"
        },
        {
          "expr": "educonnect_nodejs_heap_size_used_bytes",
          "legendFormat": "heap used",
          "refId": "B"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "title": "CPU processus",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(educonnect_process_cpu_user_seconds_total[5m])",
          "legendFormat": "user",
          "refId": "A"
        },
        {
          "expr": "rate(educonnect_process_cpu_system_seconds_total[5m])",
          "legendFormat": "system",
          "refId": "B"
        }
      ]
    },
