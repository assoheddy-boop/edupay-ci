# Nom de base locale / Neon : edupay_ci (ne pas renommer — identifiant de connexion uniquement)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/edupay_ci?schema=public"
JWT_SECRET="changez-moi-en-production-avec-une-cle-secrete-longue"
PORT=3000
NODE_ENV=development
# Production (EduConnect) :
APP_URL=https://educonnect-ci.com
SOCKET_CORS_ORIGIN=https://educonnect-ci.com
# Local : APP_URL=http://localhost:3000 et SOCKET_CORS_ORIGIN=http://localhost:3000

# SMS — passerelle (Vercel : mêmes noms de variables).
# SMS_PROVIDER=twilio  → Twilio, plus rapide à démarrer (pas de whitelist Orange CI).
# SMS_PROVIDER=orange  → Orange CI conservé (identifiant alphanum. local, ~5 j. d’approbation).
# SMS_PROVIDER=console → logs uniquement, aucun envoi réel (défaut si la variable est absente).
# Test Super Admin : /admin/dashboard (ignore le module « SMS officiel »).
# Absences / devoirs / paiements restent soumis à sms_official par école.
# Ne jamais committer de vrais tokens.
SMS_PROVIDER=orange

# Twilio (recommandé pour partir aujourd’hui). Body toujours préfixé « École {nom} : … ».
# From = TWILIO_PHONE_NUMBER (E.164, ex. +14155552671) — les parents peuvent voir ce n°
# international tant qu’un expéditeur alphanumérique n’est pas déclaré chez Twilio
# (toujours plus simple que le formulaire marketing Orange CI local).
# TWILIO_MESSAGING_SERVICE_SID (MGxxxx) si vous utilisez un Messaging Service (préféré si renseigné).
# TWILIO_ALLOW_ALPHANUMERIC=true seulement si Twilio a validé ORANGE_SMS_SENDER / smsSenderId
# comme From alphanum. Sinon laisser false : envoi immédiat avec le n° Twilio.
# Compte d’essai Twilio : SMS uniquement vers des numéros vérifiés dans la console Twilio.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_ALLOW_ALPHANUMERIC=false

# SMS Orange CI. API « SMS Cote d'Ivoire (2.0) » — Client Credentials.
# 1) SMS_PROVIDER=orange sur Vercel, sinon cette passerelle n’est pas utilisée.
# 2) OAuth (token 1 h renouvelé tout seul) : ORANGE_SMS_CLIENT_ID + ORANGE_SMS_CLIENT_SECRET.
#    My Apps → educonnect-ci → onglet Credentials → Show → mot de passe portail → copier
#    Client ID et Client Secret (pas l’Application ID de l’onglet Summary).
#    L’Application ID (visible sur Summary) n’est PAS le Client ID OAuth : ne pas le coller ici.
#    ORANGE_SMS_TOKEN_URL optionnel (défaut https://api.orange.com/oauth/v3/token).
#    ORANGE_SMS_URL optionnel (défaut CI v2.0 :
#    https://api.orange.com/smsmessaging/v1/outbound/tel%3A%2B2250000/requests).
#    L’URL d’envoi n’est pas dans Credentials : laisser vide pour le défaut, ou la copier
#    depuis SMS Cote d'Ivoire (2.0) → Getting started / API reference.
# 3) Mode héritage si vous collez déjà un Bearer : ORANGE_SMS_URL + ORANGE_SMS_TOKEN.
# 4) ORANGE_SMS_SENDER = identifiant global (EduConnect, 11 car. alphanum.) tant que
#    l'école n'a pas déclaré son propre smsSenderId. À faire whitelist auprès d'Orange CI
#    (formulaire local, ~5 jours ouvrés) avant d'envoyer — pas le n° Wave / Orange Money.
# 5) Acheter un bundle SMS : My Apps → educonnect-ci → Configure à côté de
#    « SMS Cote d'Ivoire ».
ORANGE_SMS_SENDER=EduConnect
ORANGE_SMS_URL=
ORANGE_SMS_TOKEN=
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_TOKEN_URL=

# WhatsApp Business API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Web Push (optionnel — foundation)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@educonnect.ci
# Email (optionnel). Sans SMTP_HOST + SMTP_FROM, les jobs EMAIL passent en skipped.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=EduConnect <noreply@educonnect-ci.com>
# Pas d'envoi email sans SMTP. Rappels parents = file NotificationJob (IN_APP + SMS + EMAIL + PUSH).
# Web Push ne part que si VAPID_* est renseigné ET qu'un abonnement navigateur est stocké (pas encore).

# Cron jobs (rappels paiement 8h, résumé lundi 9h)
DISABLE_CRON=false

# Redis (cache stats / bulletins)
REDIS_URL=redis://127.0.0.1:6379
DISABLE_REDIS=false
LOG_LEVEL=info

# Vérification scripts/verify-all.js
VERIFY_URL=http://localhost:3000

# Comptes @demo.ci via prisma/seed.js — défaut false, jamais en production
# SEED_DEMO=true

# Afficher les comptes démo sur / et /auth/login — ignoré en NODE_ENV=production
# SHOW_DEMO_ACCOUNTS=true

# Inscription publique des écoles — mettre false en production
# ALLOW_PUBLIC_SCHOOL_REGISTER=true

# Obligatoire en production : protège GET /metrics
# METRICS_BEARER=

# Stockage fichiers (preuves Wave/OM, photos, chat)
# local = disque (dev). blob = Vercel Blob. s3 = AWS / R2.
# Sur Vercel, blob (BLOB_READ_WRITE_TOKEN) est requis pour conserver les PDF (bulletins, reçus).
# STORAGE_DRIVER=local
# BLOB_READ_WRITE_TOKEN=
# AWS_S3_BUCKET=
# AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT=
# AWS_S3_PUBLIC_URL=

# Cron Vercel (Abidjan = UTC). Hobby : 1 cron/jour max — /daily inclut marketplace J-30 + file notifications.
# En local : poller toutes les minutes (sauf VERCEL). Endpoints :
# GET /api/internal/cron/marketplace-renewals
CRON_SECRET=

# Marketplace — renouvellement Wave (optionnel)
# EDUCONNECT_WAVE_NUMBER=07XXXXXXXX — lien manuel pay.wave.com/m/…
# WAVE_API_KEY=wave_ci_prod_… — checkout API (success_url → /school/marketplace-renewal)

# Bannière consentement à la 1re connexion parent (non bloquant, défaut: activé)
# PARENT_CONSENT_PROMPT=true

# Snapshots Neon (sinon PITR Neon en prod / pg_dump en local)
# NEON_API_KEY=
# NEON_PROJECT_ID=
# NEON_BRANCH_ID=
# NEON_SNAPSHOT_RETAIN_DAYS=7
