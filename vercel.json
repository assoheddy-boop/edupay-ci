{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    { "path": "/api/internal/cron/daily", "schedule": "0 8 * * *" }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
